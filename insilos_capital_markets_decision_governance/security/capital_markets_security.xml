<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="res_groups_privilege_decision_governance" model="res.groups.privilege">
        <field name="name">Decision Governance</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- Three roles, deliberately not implied into one another. Approver does
         NOT imply Requester: a user holding both is a segregation-of-duties
         breach we want visible in the group list, not hidden behind an
         inheritance chain. -->
    <record id="group_decision_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="comment">Requester: raises decision cases and gathers evidence. Cannot approve.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_decision_governance"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_decision_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="comment">Reviewer: independently challenges cases. Cannot approve.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_decision_governance"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_decision_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="comment">Approver: records the final disposition. Must not be the requester of the case.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_decision_governance"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <!-- Portfolio Manager runs the book: positions, marks and alert rules. It
         is a separate role from the three case roles because holding a
         position is not the same authority as approving the decision that
         created it. -->
    <record id="group_portfolio_manager" model="res.groups">
        <field name="name">Portfolio Manager</field>
        <field name="comment">Portfolio Manager: maintains portfolios, positions and alert rules.</field>
        <field name="sequence">35</field>
        <field name="privilege_id" ref="res_groups_privilege_decision_governance"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Governance Admin configures the workflow: stages, tags, runbook and the
         maker-checker rule itself. It implies Project Manager because that is
         where the configuration lives, and deliberately implies none of the
         three case roles: administering the process is not a licence to run
         cases through it. -->
    <record id="group_governance_admin" model="res.groups">
        <field name="name">Governance Admin</field>
        <field name="comment">Governance Admin: maintains stages, tags, runbook and controls. Holds no case role.</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_decision_governance"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_governance_admin')), (4, ref('group_portfolio_manager'))]"/>
    </record>

    <!-- Company boundary. Positions and alerts inherit the portfolio's company
         through a stored related field, so the same rule shape applies to all
         three and a user in one company never sees another's book. -->
    <record id="rule_capital_portfolio_company" model="ir.rule">
        <field name="name">Portfolio: own company only</field>
        <field name="model_id" ref="model_capital_portfolio"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_capital_position_company" model="ir.rule">
        <field name="name">Position: own company only</field>
        <field name="model_id" ref="model_capital_position"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_capital_alert_rule_company" model="ir.rule">
        <field name="name">Alert rule: own company only</field>
        <field name="model_id" ref="model_capital_alert_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_capital_reconciliation_import_company" model="ir.rule">
        <field name="name">Reconciliation import: own company only</field>
        <field name="model_id" ref="model_capital_reconciliation_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_capital_order_company" model="ir.rule">
        <field name="name">Order: own company only</field>
        <field name="model_id" ref="model_capital_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_capital_data_quarantine_company" model="ir.rule">
        <field name="name">Quarantined row: own company only</field>
        <field name="model_id" ref="model_capital_data_quarantine"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
