<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_capital_instrument_list" model="ir.ui.view"><field name="name">capital.instrument.list</field><field name="model">capital.instrument</field><field name="arch" type="xml">
            <list><field name="symbol"/><field name="exchange"/><field name="isin"/><field name="currency_id"/><field name="active"/></list></field></record>
    <record id="view_capital_instrument_form" model="ir.ui.view"><field name="name">capital.instrument.form</field><field name="model">capital.instrument</field><field name="arch" type="xml">
            <form><sheet><group><field name="symbol"/><field name="exchange"/><field name="isin"/><field name="currency_id"/><field name="asset_class"/><field name="active"/></group></sheet></form></field></record>
    <record id="action_capital_instrument" model="ir.actions.act_window"><field name="name">Instruments</field><field name="res_model">capital.instrument</field><field name="view_mode">list,form</field></record>
    <record id="view_capital_fx_rate_list" model="ir.ui.view"><field name="name">capital.fx.rate.list</field><field name="model">capital.fx.rate</field><field name="arch" type="xml">
            <list><field name="base_currency_id"/><field name="quote_currency_id"/><field name="rate"/><field name="as_of"/><field name="source"/><field name="evidence_attachment_id"/></list></field></record>
    <record id="action_capital_fx_rate" model="ir.actions.act_window"><field name="name">FX Rates</field><field name="res_model">capital.fx.rate</field><field name="view_mode">list,form</field></record>
    <record id="view_capital_benchmark_list" model="ir.ui.view"><field name="name">capital.benchmark.list</field><field name="model">capital.benchmark</field><field name="arch" type="xml">
            <list><field name="name"/><field name="code"/><field name="currency_id"/><field name="base_value"/><field name="base_as_of"/><field name="last_value"/><field name="mark_as_of"/></list></field></record>
    <record id="action_capital_benchmark" model="ir.actions.act_window"><field name="name">Benchmarks</field><field name="res_model">capital.benchmark</field><field name="view_mode">list,form</field></record>
    <record id="view_capital_corporate_action_form" model="ir.ui.view"><field name="name">capital.corporate.action.form</field><field name="model">capital.corporate.action</field><field name="arch" type="xml">
            <form><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" invisible="state != 'review'" groups="insilos_capital_markets_decision_governance.group_decision_approver"/><button name="action_apply" type="object" string="Apply" invisible="state != 'approved'" groups="insilos_capital_markets_decision_governance.group_portfolio_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="instrument_id"/><field name="action_type"/><field name="effective_date"/><field name="ratio"/><field name="cash_amount"/><field name="currency_id"/><field name="evidence_attachment_id"/><field name="reviewer_id" readonly="1"/><field name="approver_id" readonly="1"/><field name="reversal_reason" invisible="state != 'reversed'"/><field name="superseded_by_id" invisible="state != 'reversed'"/></group></sheet><chatter/></form></field></record>
    <record id="action_capital_corporate_action" model="ir.actions.act_window"><field name="name">Corporate Actions</field><field name="res_model">capital.corporate.action</field><field name="view_mode">list,form</field></record>
    <record id="view_capital_reconciliation_import_form" model="ir.ui.view"><field name="name">capital.reconciliation.import.form</field><field name="model">capital.reconciliation.import</field><field name="arch" type="xml">
            <form><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" invisible="state != 'review'" groups="insilos_capital_markets_decision_governance.group_decision_approver"/><button name="action_apply" type="object" string="Apply" invisible="state != 'approved'" groups="insilos_capital_markets_decision_governance.group_portfolio_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="portfolio_id"/><field name="broker"/><field name="as_of"/><field name="currency_id"/><field name="csv_attachment_id"/><field name="csv_sha256" readonly="1"/><field name="maker_id"/><field name="reviewer_id"/><field name="approver_id"/><field name="reversal_reason" invisible="state != 'reversed'"/><field name="superseded_by_id" invisible="state != 'reversed'"/></group><field name="line_ids"><list editable="bottom"><field name="instrument_id"/><field name="broker_currency_id"/><field name="valuation_blocked" readonly="1"/><field name="broker_quantity"/><field name="internal_quantity" readonly="1"/><field name="quantity_difference" readonly="1"/><field name="broker_cost"/><field name="internal_cost" readonly="1"/><field name="cost_difference" readonly="1"/><field name="broker_cash"/><field name="broker_price"/><field name="note"/></list></field></sheet><chatter/></form></field></record>
    <record id="action_capital_reconciliation_import" model="ir.actions.act_window"><field name="name">Reconciliation Imports</field><field name="res_model">capital.reconciliation.import</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_capital_instrument" name="Instruments" parent="menu_capital_root" action="action_capital_instrument" groups="insilos_capital_markets_decision_governance.group_portfolio_manager" sequence="40"/>
    <menuitem id="menu_capital_benchmark" name="Benchmarks" parent="menu_capital_root" action="action_capital_benchmark" groups="insilos_capital_markets_decision_governance.group_portfolio_manager" sequence="50"/>
    <menuitem id="menu_capital_corporate_action" name="Corporate Actions" parent="menu_capital_root" action="action_capital_corporate_action" groups="insilos_capital_markets_decision_governance.group_portfolio_manager" sequence="60"/>
    <menuitem id="menu_capital_reconciliation_import" name="Reconciliation Imports" parent="menu_capital_root" action="action_capital_reconciliation_import" groups="insilos_capital_markets_decision_governance.group_portfolio_manager" sequence="70"/>
    <record id="view_capital_order_list" model="ir.ui.view"><field name="name">capital.order.list</field><field name="model">capital.order</field><field name="arch" type="xml">
            <list><field name="client_order_id"/><field name="portfolio_id"/><field name="instrument_id"/><field name="side"/><field name="approved_quantity"/><field name="quantity"/><field name="executed_quantity"/><field name="open_quantity"/><field name="average_execution_price"/><field name="realised_pnl"/><field name="state" widget="badge"/><field name="currency_id" column_invisible="1"/></list></field></record>
    <record id="view_capital_order_form" model="ir.ui.view"><field name="name">capital.order.form</field><field name="model">capital.order</field><field name="arch" type="xml">
            <form><header><field name="state" widget="statusbar"/></header><sheet><group><group><field name="client_order_id"/><field name="portfolio_id"/><field name="instrument_id"/><field name="side"/><field name="decision_case_id"/></group><group><field name="approved_quantity"/><field name="quantity"/><field name="executed_quantity"/><field name="open_quantity"/><field name="average_execution_price"/><field name="realised_pnl"/><field name="currency_id" invisible="1"/></group></group><notebook><page string="Fills"><field name="fill_ids"><list><field name="executed_at"/><field name="quantity"/><field name="price"/><field name="currency_id" column_invisible="1"/></list></field></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_capital_order_search" model="ir.ui.view"><field name="name">capital.order.search</field><field name="model">capital.order</field><field name="arch" type="xml">
            <search><field name="client_order_id"/><field name="portfolio_id"/><field name="instrument_id"/><field name="state"/></search></field></record>
    <record id="view_capital_order_kanban" model="ir.ui.view"><field name="name">capital.order.kanban</field><field name="model">capital.order</field><field name="arch" type="xml">
            <kanban default_group_by="state" class="w_kanban_small_column"><field name="client_order_id"/><field name="portfolio_id"/><field name="instrument_id"/><field name="side"/><field name="state"/><templates><t t-name="card"><div class="w_kanban_record"><strong><field name="client_order_id"/></strong><div><field name="portfolio_id"/></div><div><field name="side"/> · <field name="instrument_id"/></div><span class="badge text-bg-secondary"><field name="state"/></span></div></t></templates></kanban></field></record>
    <record id="action_capital_order" model="ir.actions.act_window"><field name="name">Orders</field><field name="res_model">capital.order</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_capital_order" name="Orders" parent="menu_capital_root" action="action_capital_order" groups="insilos_capital_markets_decision_governance.group_portfolio_manager" sequence="70"/>
    <record id="view_capital_data_quarantine_list" model="ir.ui.view"><field name="name">capital.data.quarantine.list</field><field name="model">capital.data.quarantine</field><field name="arch" type="xml">
            <list><field name="create_date"/><field name="symbol"/><field name="reason"/><field name="detail"/><field name="portfolio_id"/><field name="import_id"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_capital_data_quarantine_form" model="ir.ui.view"><field name="name">capital.data.quarantine.form</field><field name="model">capital.data.quarantine</field><field name="arch" type="xml">
            <form><header><button name="action_resolve" type="object" string="Resolve" invisible="state != 'open'"/><button name="action_discard" type="object" string="Discard" invisible="state != 'open'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="symbol"/><field name="reason"/><field name="detail"/><field name="portfolio_id"/><field name="import_id"/><field name="payload" readonly="1"/><field name="resolution_note"/></group></sheet><chatter/></form></field></record>
    <record id="view_capital_data_quarantine_kanban" model="ir.ui.view"><field name="name">capital.data.quarantine.kanban</field><field name="model">capital.data.quarantine</field><field name="arch" type="xml">
            <kanban default_group_by="state" class="w_kanban_small_column"><field name="name"/><field name="portfolio_id"/><field name="reason"/><field name="state"/><templates><t t-name="card"><div class="w_kanban_record"><strong><field name="name"/></strong><div><field name="portfolio_id"/></div><div><field name="reason"/></div><span class="badge text-bg-secondary"><field name="state"/></span></div></t></templates></kanban></field></record>
    <record id="view_capital_data_quarantine_search" model="ir.ui.view"><field name="name">capital.data.quarantine.search</field><field name="model">capital.data.quarantine</field><field name="arch" type="xml">
            <search><field name="symbol"/><field name="portfolio_id"/><field name="reason"/><filter string="Open" name="filter_open" domain="[('state', '=', 'open')]"/><group><filter string="Reason" name="group_reason" context="{'group_by':'reason'}"/><filter string="Portfolio" name="group_portfolio" context="{'group_by':'portfolio_id'}"/></group></search></field></record>
    <record id="action_capital_data_quarantine" model="ir.actions.act_window"><field name="name">Data Quarantine</field><field name="res_model">capital.data.quarantine</field><field name="view_mode">list,form</field><field name="context">{'search_default_filter_open': 1}</field></record>
    <menuitem id="menu_capital_data_quarantine" name="Data Quarantine" parent="menu_capital_root" action="action_capital_data_quarantine" groups="insilos_capital_markets_decision_governance.group_portfolio_manager" sequence="75"/>
    <menuitem id="menu_capital_fx_rate" name="FX Rates" parent="menu_capital_root" action="action_capital_fx_rate" groups="insilos_capital_markets_decision_governance.group_governance_admin" sequence="80"/>
</odoo>
