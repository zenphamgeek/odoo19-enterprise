<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <template id="page_decision_governance" name="Capital Markets Decision Governance">
        <t t-call="website.layout">
            <t t-set="additional_title">Capital Markets Decision Governance — Insilos</t>
            <t t-set="meta_description">Auditable investment decision governance: intake, evidence, independent review and approval, with a source-grounded AI research agent.</t>
            <main id="wrap" class="oe_structure insilos-site">
                <div class="oe_structure oe_empty"/>

                <section class="s_cover parallax s_parallax_is_fixed w_cc w_cc5 pt232 pb232" data-scroll-background-ratio="1" data-snippet="s_cover" data-name="Cover">
                    <span class="s_parallax_bg we_img_bg" style="background-image: url('https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=modern%20financial%20district%20skyline%20at%20dusk%2C%20glass%20towers%2C%20cool%20blue%20tones%2C%20cinematic%20wide%20shot%2C%20professional%20corporate%20photography%2C%20high%20detail&amp;image_size=landscape_16_9'); background-position: 50% 75%;"/>
                    <div class="w_we_bg_filter bg-black-50"/>
                    <div class="container s_allow_columns">
                        <h1 class="display-3" style="text-align: center;">Decisions you can defend</h1>
                        <p class="lead" style="text-align: center;">Every investment decision arrives with its evidence, its challenge and its approver attached.<br/>Not reconstructed months later — recorded as it happened.</p>
                        <p style="text-align: center;">
                            <a href="/contactus" class="btn btn-secondary mb-2">Request a walkthrough</a>
                        </p>
                    </div>
                </section>

                <section class="s_features pt64 pb64" data-snippet="s_features" data-name="Features">
                    <div class="container">
                        <h2 class="h3-fs">What the accelerator gives you</h2>
                        <p class="lead">Configuration on the platform you already run. No new data model, no parallel system of record.</p>
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="s_hr pt-4 pb32">
                                    <hr class="w-100 mx-auto"/>
                                </div>
                                <i class="s_features_icon ph-duotone ph-scales mb-3 rounded bg-w-color-3" role="img"/>
                                <div class="overflow-hidden">
                                    <h3 class="h5-fs">Separation of duties</h3>
                                    <p>Requester, reviewer and approver are three people. The system makes a self-approved case visible instead of possible.</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="s_hr pt-4 pb32">
                                    <hr class="w-100 mx-auto"/>
                                </div>
                                <i class="s_features_icon ph-duotone ph-file-magnifying-glass mb-3 rounded bg-w-color-3" role="img"/>
                                <div class="overflow-hidden">
                                    <h3 class="h5-fs">Evidence with provenance</h3>
                                    <p>Each source carries its tier and its as-of date. A claim with no source is labelled unverified rather than quietly promoted to fact.</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="s_hr pt-4 pb32">
                                    <hr class="w-100 mx-auto"/>
                                </div>
                                <i class="s_features_icon ph-duotone ph-clock-counter-clockwise mb-3 rounded bg-w-color-3" role="img"/>
                                <div class="overflow-hidden">
                                    <h3 class="h5-fs">History that survives audit</h3>
                                    <p>Challenge, dissent and disposition live in the case record. The rework round trip stays visible instead of being overwritten.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="s_process_steps pt72 pb72 s_process_steps_connector_line" data-vcss="002" data-vxml="002" data-snippet="s_process_steps" data-name="Steps">
                    <svg class="s_process_step_svg_defs position-absolute">
                        <defs>
                            <marker class="s_process_steps_arrow_head" markerWidth="15" markerHeight="10" refX="6" refY="6" orient="auto">
                                <path d="M 2,2 L10,6 L2,10 L6,6 L2,2" vector-effect="non-scaling-size"/>
                            </marker>
                        </defs>
                    </svg>
                    <div class="container">
                        <h2 class="mb-4 text-center h3-fs">One case, four gates</h2>
                        <div class="row g-0">
                            <div class="col-lg-3 s_process_step position-relative pt24 pb24">
                                <svg class="s_process_step_connector position-absolute z-index-1" viewBox="0 0 100 20" preserveAspectRatio="none">
                                    <path d="M 0 10 L 100 10" vector-effect="non-scaling-stroke"/>
                                </svg>
                                <div class="s_process_step_number d-flex align-items-center justify-content-center mx-auto rounded-circle bg-primary-light" data-name="Step Number">
                                    <h3 class="mb-0 text-primary text-center">1</h3>
                                </div>
                                <div class="s_process_step_content mt-3 px-3 text-center">
                                    <h3 class="h4-fs">Intake</h3>
                                    <p>Sponsor, thesis, size, materiality and risk — stated before the work starts.</p>
                                </div>
                            </div>
                            <div class="col-lg-3 s_process_step position-relative pt24 pb24">
                                <svg class="s_process_step_connector position-absolute z-index-1" viewBox="0 0 100 20" preserveAspectRatio="none">
                                    <path d="M 0 10 L 100 10" vector-effect="non-scaling-stroke"/>
                                </svg>
                                <div class="s_process_step_number d-flex align-items-center justify-content-center mx-auto rounded-circle bg-primary-light" data-name="Step Number">
                                    <h3 class="mb-0 text-primary text-center">2</h3>
                                </div>
                                <div class="s_process_step_content mt-3 px-3 text-center">
                                    <h3 class="h4-fs">Evidence</h3>
                                    <p>Sources attach to the case and carry their tier. The weakest tier is the one that counts.</p>
                                </div>
                            </div>
                            <div class="col-lg-3 s_process_step position-relative pt24 pb24">
                                <svg class="s_process_step_connector position-absolute z-index-1" viewBox="0 0 100 20" preserveAspectRatio="none">
                                    <path d="M 0 10 L 100 10" vector-effect="non-scaling-stroke"/>
                                </svg>
                                <div class="s_process_step_number d-flex align-items-center justify-content-center mx-auto rounded-circle bg-primary-light" data-name="Step Number">
                                    <h3 class="mb-0 text-primary text-center">3</h3>
                                </div>
                                <div class="s_process_step_content mt-3 px-3 text-center">
                                    <h3 class="h4-fs">Independent review</h3>
                                    <p>A second pair of eyes records the counter-thesis, and any dissent, on the record.</p>
                                </div>
                            </div>
                            <div class="col-lg-3 s_process_step position-relative pt24 pb24">
                                <svg class="s_process_step_connector position-absolute z-index-1" viewBox="0 0 100 20" preserveAspectRatio="none">
                                    <path d="M 0 10 L 100 10" vector-effect="non-scaling-stroke"/>
                                </svg>
                                <div class="s_process_step_number d-flex align-items-center justify-content-center mx-auto rounded-circle bg-primary-light" data-name="Step Number">
                                    <h3 class="mb-0 text-primary text-center">4</h3>
                                </div>
                                <div class="s_process_step_content mt-3 px-3 text-center">
                                    <h3 class="h4-fs">Approval</h3>
                                    <p>The approver states the disposition and the reasoning. Nothing approves itself.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="s_features pt64 pb64" data-snippet="s_features" data-name="Features">
                    <div class="container">
                        <h2 class="h3-fs">The AI analyst, and its limits</h2>
                        <p class="lead">A research assistant that argues with you — and cannot sign anything.</p>
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="s_hr pt-4 pb32">
                                    <hr class="w-100 mx-auto"/>
                                </div>
                                <i class="s_features_icon ph-duotone ph-eye mb-3 rounded bg-w-color-3" role="img"/>
                                <div class="overflow-hidden">
                                    <h3 class="h5-fs">Read-only by default</h3>
                                    <p>The agent drafts, summarises and finds gaps. It does not approve, move stages or reassign reviewers.</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="s_hr pt-4 pb32">
                                    <hr class="w-100 mx-auto"/>
                                </div>
                                <i class="s_features_icon ph-duotone ph-quotes mb-3 rounded bg-w-color-3" role="img"/>
                                <div class="overflow-hidden">
                                    <h3 class="h5-fs">Grounded or marked unverified</h3>
                                    <p>Facts carry a source and a date. Calculations carry their inputs. Anything else is labelled, not smoothed over.</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="s_hr pt-4 pb32">
                                    <hr class="w-100 mx-auto"/>
                                </div>
                                <i class="s_features_icon ph-duotone ph-shield-check mb-3 rounded bg-w-color-3" role="img"/>
                                <div class="overflow-hidden">
                                    <h3 class="h5-fs">Inside your permissions</h3>
                                    <p>The agent sees exactly what the user sees. Text inside a document is data to analyse, never an instruction to follow.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="s_call_to_action w_cc w_cc5 pt64 pb64" data-snippet="s_call_to_action" data-name="Call to Action">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-9">
                                <h2 class="h3-fs">See it on a real decision case</h2>
                                <p class="lead">Bring one recent decision. We will walk it through intake, evidence, review and approval.</p>
                            </div>
                            <div class="col-lg-3">
                                <p style="text-align: right;">
                                    <a href="/contactus" class="btn btn-primary btn-lg">Contact us</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="oe_structure oe_empty"/>
            </main>
        </t>
    </template>

    <record id="website_page_decision_governance" model="website.page">
        <field name="name">Capital Markets Decision Governance</field>
        <field name="url">/capital-markets-decision-governance</field>
        <field name="website_published" eval="True"/>
        <field name="is_published" eval="True"/>
        <field name="view_id" ref="page_decision_governance"/>
    </record>

</odoo>
