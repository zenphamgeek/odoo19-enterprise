<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_capital_portfolio_search" model="ir.ui.view"><field name="name">capital.portfolio.search</field><field name="model">capital.portfolio</field><field name="arch" type="xml">
            <search><field name="name"/><field name="manager_id"/><field name="company_id"/><group><filter string="Manager" name="group_manager" context="{'group_by':'manager_id'}"/><filter string="Company" name="group_company" context="{'group_by':'company_id'}"/></group></search></field></record>
    <record id="view_capital_position_search" model="ir.ui.view"><field name="name">capital.position.search</field><field name="model">capital.position</field><field name="arch" type="xml">
            <search><field name="symbol"/><field name="instrument_id"/><field name="portfolio_id"/><field name="mark_status"/><group><filter string="Portfolio" name="group_portfolio" context="{'group_by':'portfolio_id'}"/><filter string="Mark Status" name="group_status" context="{'group_by':'mark_status'}"/></group></search></field></record>
    <record id="view_capital_alert_rule_form" model="ir.ui.view"><field name="name">capital.alert.rule.form</field><field name="model">capital.alert.rule</field><field name="arch" type="xml">
            <form string="Alert Rule"><sheet><group><field name="name"/><field name="active"/><field name="portfolio_id"/><field name="symbol"/><field name="kind"/><field name="threshold"/><field name="user_id"/></group><group string="Current State"><field name="triggered" readonly="1"/><field name="last_triggered_on" readonly="1"/><field name="last_triggered_value" readonly="1"/></group></sheet><chatter/></form></field></record>
    <record id="view_capital_alert_rule_search" model="ir.ui.view"><field name="name">capital.alert.rule.search</field><field name="model">capital.alert.rule</field><field name="arch" type="xml">
            <search><field name="name"/><field name="portfolio_id"/><field name="symbol"/><field name="kind"/><group><filter string="Portfolio" name="group_portfolio" context="{'group_by':'portfolio_id'}"/><filter string="Rule Type" name="group_kind" context="{'group_by':'kind'}"/></group></search></field></record>
    <record id="view_capital_instrument_search" model="ir.ui.view"><field name="name">capital.instrument.search</field><field name="model">capital.instrument</field><field name="arch" type="xml">
            <search><field name="symbol"/><field name="isin"/><field name="exchange"/><field name="asset_class"/><group><filter string="Asset Class" name="group_class" context="{'group_by':'asset_class'}"/><filter string="Currency" name="group_currency" context="{'group_by':'currency_id'}"/></group></search></field></record>
    <record id="view_capital_fx_rate_form" model="ir.ui.view"><field name="name">capital.fx.rate.form</field><field name="model">capital.fx.rate</field><field name="arch" type="xml">
            <form string="FX Rate"><sheet><group><field name="base_currency_id"/><field name="quote_currency_id"/><field name="rate"/><field name="as_of"/><field name="source"/><field name="evidence_attachment_id"/><field name="active"/></group></sheet></form></field></record>
    <record id="view_capital_fx_rate_search" model="ir.ui.view"><field name="name">capital.fx.rate.search</field><field name="model">capital.fx.rate</field><field name="arch" type="xml">
            <search><field name="base_currency_id"/><field name="quote_currency_id"/><field name="source"/><group><filter string="Base Currency" name="group_base" context="{'group_by':'base_currency_id'}"/><filter string="Quote Currency" name="group_quote" context="{'group_by':'quote_currency_id'}"/></group></search></field></record>
    <record id="view_capital_benchmark_form" model="ir.ui.view"><field name="name">capital.benchmark.form</field><field name="model">capital.benchmark</field><field name="arch" type="xml">
            <form string="Benchmark"><sheet><group><field name="name"/><field name="code"/><field name="currency_id"/><field name="base_value"/><field name="base_as_of"/><field name="last_value"/><field name="mark_as_of"/><field name="evidence_attachment_id"/><field name="active"/></group></sheet><chatter/></form></field></record>
    <record id="view_capital_benchmark_search" model="ir.ui.view"><field name="name">capital.benchmark.search</field><field name="model">capital.benchmark</field><field name="arch" type="xml">
            <search><field name="name"/><field name="code"/><field name="currency_id"/><group><filter string="Currency" name="group_currency" context="{'group_by':'currency_id'}"/></group></search></field></record>
    <record id="view_capital_corporate_action_list" model="ir.ui.view"><field name="name">capital.corporate.action.list</field><field name="model">capital.corporate.action</field><field name="arch" type="xml">
            <list string="Corporate Actions"><field name="name"/><field name="instrument_id"/><field name="action_type"/><field name="effective_date"/><field name="state" widget="badge"/><field name="reviewer_id"/><field name="approver_id"/></list></field></record>
    <record id="view_capital_corporate_action_search" model="ir.ui.view"><field name="name">capital.corporate.action.search</field><field name="model">capital.corporate.action</field><field name="arch" type="xml">
            <search><field name="name"/><field name="instrument_id"/><field name="action_type"/><field name="state"/><group><filter string="Action Type" name="group_type" context="{'group_by':'action_type'}"/><filter string="State" name="group_state" context="{'group_by':'state'}"/></group></search></field></record>
    <record id="view_capital_reconciliation_import_list" model="ir.ui.view"><field name="name">capital.reconciliation.import.list</field><field name="model">capital.reconciliation.import</field><field name="arch" type="xml">
            <list string="Reconciliation Imports"><field name="portfolio_id"/><field name="broker"/><field name="as_of"/><field name="state" widget="badge"/><field name="maker_id"/><field name="reviewer_id"/><field name="approver_id"/></list></field></record>
    <record id="view_capital_reconciliation_import_search" model="ir.ui.view"><field name="name">capital.reconciliation.import.search</field><field name="model">capital.reconciliation.import</field><field name="arch" type="xml">
            <search><field name="portfolio_id"/><field name="broker"/><field name="as_of"/><field name="state"/><group><filter string="Portfolio" name="group_portfolio" context="{'group_by':'portfolio_id'}"/><filter string="State" name="group_state" context="{'group_by':'state'}"/></group></search></field></record>
</odoo>
