<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_market_terminal" model="res.groups.privilege">
        <field name="name">Market Terminal</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_market_terminal_user" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_market_terminal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_market_terminal_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_market_terminal"/>
        <field name="implied_ids" eval="[(4, ref('group_market_terminal_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_market_terminal_manager'))]"/>
    </record>
</odoo>
