<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_industry_template_kanban" model="ir.ui.view">
        <field name="name">insilos.industry.template.kanban</field>
        <field name="model">insilos.industry.template</field>
        <field name="arch" type="xml">
            <kanban class="w_industry_kanban" default_group_by="category_id" records_draggable="0" group_create="0">
                <field name="name"/>
                <field name="slug"/>
                <field name="icon"/>
                <field name="description"/>
                <field name="module_names"/>
                <templates>
                    <t t-name="card">
                        <div class="w_industry_card p-3">
                            <div class="w_industry_card_header d-flex align-items-center gap-2 mb-2">
                                <i t-att-class="record.icon.value" class="fs-4 text-primary" role="img"/>
                                <span class="fw-bold fs-6"><field name="name"/></span>
                            </div>
                            <div class="w_industry_card_body">
                                <p class="text-muted small mb-2"><field name="description"/></p>
                                <span class="badge text-bg-light border text-truncate d-inline-block mw-100"><field name="module_names"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_industry_template_list" model="ir.ui.view">
        <field name="name">insilos.industry.template.list</field>
        <field name="model">insilos.industry.template</field>
        <field name="arch" type="xml">
            <list string="Industry Templates">
                <field name="sequence" widget="handle"/>
                <field name="icon" widget="char"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="slug" optional="show"/>
                <field name="module_names" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_industry_template_form" model="ir.ui.view">
        <field name="name">insilos.industry.template.form</field>
        <field name="model">insilos.industry.template</field>
        <field name="arch" type="xml">
            <form string="Industry Template">
                <sheet>
                    <div class="we_title">
                        <h1><field name="name" placeholder="Industry Template Name"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="category_id"/>
                            <field name="slug" placeholder="auto-generated from name"/>
                            <field name="icon"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Module Bundle">
                            <field name="module_names"/>
                            <field name="synonyms"/>
                        </group>
                    </group>
                    <group string="Content &amp; Branding">
                        <field name="description"/>
                        <field name="intro_text"/>
                        <field name="hero_image_url"/>
                        <field name="bg_image_url"/>
                        <field name="contact_email"/>
                        <field name="contact_phone"/>
                        <field name="contact_address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_industry_templates" model="ir.actions.act_window">
        <field name="name">Industry Templates</field>
        <field name="path">industry-templates</field>
        <field name="res_model">insilos.industry.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p>Industry Templates are catalog definitions. Create tenant instances from Tenant Fleet.</p>
        </field>
    </record>
</odoo>
