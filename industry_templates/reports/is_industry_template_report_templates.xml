<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_industry_template_spec_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Inter', 'Segoe UI', sans-serif; font-size: 12px; line-height: 1.5;">
                        <!-- Header Banner -->
                        <div class="row mb-4" style="background: linear-gradient(135deg, #0B2E64 0%, #1a4f8c 100%); color: white; padding: 20px 25px; border-radius: 6px;">
                            <div class="col-8">
                                <h2 style="margin: 0; font-weight: 700;">INDUSTRY TEMPLATE SPECIFICATION</h2>
                                <p style="margin: 5px 0 0 0; opacity: 0.85;">
                                    <t t-esc="o.name"/> (<code><t t-esc="o.slug"/></code>)
                                </p>
                            </div>
                            <div class="col-4 text-end">
                                <span style="font-size: 14px; font-weight: 600;">Category: <t t-esc="o.category_id.name"/></span><br/>
                                <span style="opacity: 0.8;">Sequence: <t t-esc="o.sequence"/></span>
                            </div>
                        </div>

                        <!-- Template Details -->
                        <h4 style="color: #0B2E64; border-bottom: 2px solid #0B2E64; padding-bottom: 4px;">
                            1. Template Metadata &amp; Configuration
                        </h4>
                        <table class="table table-sm table-bordered" style="font-size: 11px;">
                            <tbody>
                                <tr>
                                    <td style="width: 30%;"><strong>Template Name</strong></td>
                                    <td><strong><t t-esc="o.name"/></strong></td>
                                </tr>
                                <tr>
                                    <td><strong>Subdomain Slug</strong></td>
                                    <td><code><t t-esc="o.slug"/></code></td>
                                </tr>
                                <tr>
                                    <td><strong>Category</strong></td>
                                    <td><t t-esc="o.category_id.name"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Synonyms / Tags</strong></td>
                                    <td><t t-esc="o.synonyms or 'N/A'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Icon Class</strong></td>
                                    <td><code><t t-esc="o.icon or 'ph-duotone ph-storefront'"/></code></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Module Bundle -->
                        <h4 style="color: #0B2E64; border-bottom: 2px solid #0B2E64; padding-bottom: 4px; margin-top: 20px;">
                            2. Bundled Enterprise Modules
                        </h4>
                        <table class="table table-sm table-bordered" style="font-size: 11px;">
                            <thead style="background: #f0f4f8;">
                                <tr>
                                    <th style="width: 10%;">#</th>
                                    <th>Technical Module Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="1"/>
                                <t t-foreach="(o.module_names or '').split(',')" t-as="mod">
                                    <t t-if="mod.strip()">
                                        <tr>
                                            <td><t t-esc="idx"/></td>
                                            <td><code><t t-esc="mod.strip()"/></code></td>
                                        </tr>
                                        <t t-set="idx" t-value="idx + 1"/>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- Footer -->
                        <div class="text-muted text-center mt-4" style="font-size: 9px; border-top: 1px solid #dee2e6; padding-top: 8px;">
                            Generated by Insilos Industry Template Catalog — <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
