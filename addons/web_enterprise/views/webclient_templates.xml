<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="webclient_login" inherit_id="web.login">
        <xpath expr="//t[@t-call='web.login_layout']" position="before">
            <t t-set="body_classname" t-value="'o_home_menu_background'" />
            <t t-set="login_card_classes" t-value="'rounded-0 shadow-sm bg-white'" />
        </xpath>
    </template>

    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="replace">
            <meta name="theme-color"
                t-att-content="'#242733' if color_scheme == 'dark' else '#714B67'" />
        </xpath>
    </template>
</odoo>