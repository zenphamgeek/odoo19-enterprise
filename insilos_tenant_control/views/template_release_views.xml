<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_template_release_list" model="ir.ui.view">
        <field name="name">insilos.template.release.list</field>
        <field name="model">insilos.template.release</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_id"/>
                <field name="artifact_sha256"/>
                <field name="app_version"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_template_release_form" model="ir.ui.view">
        <field name="name">insilos.template.release.form</field>
        <field name="model">insilos.template.release</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="template_id"/>
                        <field name="artifact_uri"/>
                        <field name="artifact_sha256"/>
                        <field name="catalog_sha256"/>
                        <field name="app_version"/>
                        <field name="image_ref"/>
                        <field name="postgres_version"/>
                        <field name="schema_sha256"/>
                        <field name="filestore_manifest_uri"/>
                        <field name="test_evidence_uri"/>
                        <field name="module_manifest"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_template_release" model="ir.actions.act_window">
        <field name="name">Template Releases</field>
        <field name="res_model">insilos.template.release</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
