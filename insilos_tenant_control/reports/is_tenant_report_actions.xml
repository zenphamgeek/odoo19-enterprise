<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_tenant_health_audit" model="ir.actions.report">
        <field name="name">Tenant Fleet Overview &amp; Health Report</field>
        <field name="model">insilos.tenant</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">insilos_tenant_control.report_tenant_health_audit_doc</field>
        <field name="report_file">insilos_tenant_control.report_tenant_health_audit_doc</field>
        <field name="print_report_name">'Tenant_' + (object.slug or object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_insilos_tenant"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
