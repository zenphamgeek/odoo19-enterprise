<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tenant_control" model="res.groups.privilege">
        <field name="name">Tenant Control</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_tenant_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="module_category_tenant_control"/>
        <field name="implied_ids" eval="[(4, ref('databases.group_databases_user'))]"/>
    </record>
    <record id="group_tenant_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="implied_ids" eval="[(4, ref('group_tenant_viewer'))]"/>
        <field name="privilege_id" ref="module_category_tenant_control"/>
    </record>
    <record id="group_tenant_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="implied_ids" eval="[(4, ref('group_tenant_requester'))]"/>
        <field name="privilege_id" ref="module_category_tenant_control"/>
    </record>
    <record id="group_tenant_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="implied_ids" eval="[(4, ref('group_tenant_viewer'))]"/>
        <field name="privilege_id" ref="module_category_tenant_control"/>
    </record>
</odoo>
