<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_openrouter_log_tree" model="ir.ui.view">
        <field name="name">openrouter.log.tree</field>
        <field name="model">openrouter.log</field>
        <field name="arch" type="xml">
            <list string="Insilos IAP Usage &amp; Cost Audit" create="0" edit="0"
                  decoration-danger="status == 'failed'"
                  decoration-warning="status == 'fallback'"
                  decoration-success="status == 'success'">
                <field name="create_date" string="Timestamp"/>
                <field name="operation_id"/>
                <field name="tenant_id"/>
                <field name="company_id"/>
                <field name="policy_version"/>
                <field name="credit_budget"/>
                <field name="domain_id"/>
                <field name="model_id"/>
                <field name="used_model_name"/>
                <field name="total_tokens"/>
                <field name="total_cost"/>
                <field name="status" widget="badge"/>
                <field name="execution_time"/>
            </list>
        </field>
    </record>

    <record id="action_openrouter_log" model="ir.actions.act_window">
        <field name="name">Usage &amp; Cost Log</field>
        <field name="res_model">openrouter.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
