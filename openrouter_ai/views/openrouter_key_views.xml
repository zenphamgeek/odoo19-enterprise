<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_openrouter_key_tree" model="ir.ui.view">
        <field name="name">openrouter.key.tree</field>
        <field name="model">openrouter.key</field>
        <field name="arch" type="xml">
            <list string="IAP Keys">
                <field name="name"/>
                <field name="is_default"/>
                <field name="is_free_tier"/>
                <field name="state" widget="badge"/>
                <field name="usage"/>
                <field name="usage_daily"/>
                <field name="usage_monthly"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_openrouter_key_form" model="ir.ui.view">
        <field name="name">openrouter.key.form</field>
        <field name="model">openrouter.key</field>
        <field name="arch" type="xml">
            <form string="Insilos IAP Key">
                <header>
                    <button name="action_check_balance" string="Sync Credits &amp; Verify" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="untested,valid,invalid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="api_key" password="True"/>
                            <field name="is_default"/>
                        </group>
                        <group string="Live Credit Status">
                            <field name="is_free_tier"/>
                            <field name="usage"/>
                            <field name="usage_daily"/>
                            <field name="usage_monthly"/>
                            <field name="limit_remaining"/>
                            <field name="last_sync_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_openrouter_key" model="ir.actions.act_window">
        <field name="name">IAP Keys &amp; Credits</field>
        <field name="res_model">openrouter.key</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
