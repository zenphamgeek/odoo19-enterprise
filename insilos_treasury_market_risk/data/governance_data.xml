<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="project_treasury_governance" model="project.project">
        <field name="name">Treasury Decision Governance</field>
        <field name="is_template" eval="True"/>
        <field name="allow_task_dependencies" eval="True"/>
        <field name="description" type="html"><div><p>Copy this template per treasury mandate. One task is one decision; supporting figures must drill down to accounting entries or governed positions.</p></div></field>
    </record>
    <record id="stage_risk_trigger" model="project.task.type"><field name="name">Risk Trigger</field><field name="sequence">10</field><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
    <record id="stage_treasury_analysis" model="project.task.type"><field name="name">Treasury Analysis</field><field name="sequence">20</field><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
    <record id="stage_decision_proposal" model="project.task.type"><field name="name">Decision Proposal</field><field name="sequence">30</field><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
    <record id="stage_risk_review" model="project.task.type"><field name="name">Risk Review</field><field name="sequence">40</field><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
    <record id="stage_finance_review" model="project.task.type"><field name="name">Finance Review</field><field name="sequence">50</field><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
    <record id="stage_investment_committee" model="project.task.type"><field name="name">Investment Committee</field><field name="sequence">60</field><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
    <record id="stage_execution" model="project.task.type"><field name="name">Execution</field><field name="sequence">70</field><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
    <record id="stage_settlement" model="project.task.type"><field name="name">Settlement</field><field name="sequence">80</field><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
    <record id="stage_outcome_review" model="project.task.type"><field name="name">Outcome Review</field><field name="sequence">90</field><field name="fold" eval="True"/><field name="project_ids" eval="[(4, ref('project_treasury_governance'))]"/></record>
</odoo>
