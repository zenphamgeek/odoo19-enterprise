<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_treasury" model="res.groups.privilege">
        <field name="name">Treasury &amp; Market Risk</field>
        <field name="sequence">26</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <!-- Reading exposure means reading the whole company's receivables and
         payables, so it is a grant in its own right rather than something
         every accounting user inherits. -->
    <record id="group_treasury_analyst" model="res.groups">
        <field name="name">Treasury Analyst</field>
        <field name="comment">Reads exposure, liquidity and portfolio measurement. Cannot approve anything.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_treasury"/>
    </record>

    <record id="group_treasury_manager" model="res.groups">
        <field name="name">Treasury Manager</field>
        <field name="comment">Runs scenarios and raises treasury decision cases for review.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_analyst'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_cfo" model="res.groups">
        <field name="name">Treasury CFO</field>
        <field name="comment">Co-signs Treasury IC Pack decisions before execution.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_cfo'))]"/>
    </record>
</odoo>
