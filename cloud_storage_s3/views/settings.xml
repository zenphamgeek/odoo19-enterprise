<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cloud_storage_s3_config_settings_view_form" model="ir.ui.view">
        <field name="name">cloud_storage_s3_config_settings_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='cloud_storage_provider']" position="inside">
                <div class="content-group mt16" invisible="cloud_storage_provider != 's3'">
                    <label for="cloud_storage_s3_endpoint_url" class="w_light_label mr8"/>
                    <field name="cloud_storage_s3_endpoint_url"/>
                    <br/>
                    <label for="cloud_storage_s3_bucket_name" class="w_light_label mr8"/>
                    <field name="cloud_storage_s3_bucket_name"/>
                    <br/>
                    <label for="cloud_storage_s3_access_key" class="w_light_label mr8"/>
                    <field name="cloud_storage_s3_access_key"/>
                    <br/>
                    <label for="cloud_storage_s3_secret_key" class="w_light_label mr8"/>
                    <field name="cloud_storage_s3_secret_key"/>
                    <br/>
                    <label for="cloud_storage_s3_region" class="w_light_label mr8"/>
                    <field name="cloud_storage_s3_region"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
