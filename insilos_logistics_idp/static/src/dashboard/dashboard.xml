<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="insilos_logistics_idp.Dashboard">
  <main class="w_idp_dashboard" aria-label="Logistics IDP intelligence overview" t-att-aria-busy="state.loading || state.busyAction">
    <header class="w_idp_header">
      <div><p class="w_idp_eyebrow">Logistics intelligence</p><h1>Dossier Control Tower</h1><p>Live operational priorities across governed logistics dossiers.</p></div>
      <button type="button" class="btn btn-outline-light" t-att-disabled="state.loading" t-on-click="resetFilters" aria-label="Reset dashboard filters">Reset</button>
    </header>
    <form class="w_idp_filters" aria-label="Dashboard filters" t-on-submit.prevent="applyFilters"><fieldset class="w_idp_filter_fields" t-att-disabled="state.loading"><legend class="visually-hidden">Dashboard filters</legend>
      <label>From<input class="form-control" type="date" name="date_from" t-att-value="state.filters.date_from" t-on-change="onFilter"/></label><label>To<input class="form-control" type="date" name="date_to" t-att-value="state.filters.date_to" t-on-change="onFilter"/></label><label>Supplier<input class="form-control" name="supplier" t-att-value="state.filters.supplier" t-on-change="onFilter" placeholder="Supplier reference"/></label><label>Jurisdiction<input class="form-control" name="jurisdiction" t-att-value="state.filters.jurisdiction" t-on-change="onFilter" placeholder="Country / jurisdiction"/></label><label>Regime<select class="form-select" name="customs_regime" t-att-value="state.filters.customs_regime" t-on-change="onFilter"><option value="">All</option><option value="E11">E11</option><option value="E13">E13</option><option value="E15">E15</option></select></label><label>Document type<input class="form-control" name="document_type" t-att-value="state.filters.document_type" t-on-change="onFilter" placeholder="invoice, packing list…"/></label><button type="submit" class="btn btn-primary">Apply</button>
    </fieldset></form>
    <div t-if="state.busyAction || state.loading || (state.data and isEmpty())" class="w_idp_state" role="status" aria-live="polite" aria-atomic="true"><t t-if="state.busyAction">Action pending…</t><t t-elif="state.loading">Loading dashboard…</t><t t-else="">No records match these filters.</t></div>
    <div t-if="state.error" class="alert alert-danger" role="alert"><strong>Dashboard unavailable.</strong> <t t-esc="state.error"/><button type="button" class="btn btn-link" t-att-disabled="state.loading" t-on-click="load">Retry</button></div>
    <div t-elif="state.data" class="w_idp_results" role="group" aria-label="Dashboard results" t-att-aria-disabled="state.busyAction" t-att-inert="state.busyAction ? 'inert' : undefined">
      <div t-if="state.operationError" class="alert alert-danger" role="alert" t-esc="state.operationError"/>
      <section class="w_idp_kpis" aria-label="Key performance indicators"><button type="button" t-foreach="priorityMetrics()" t-as="metric" t-key="metric.key" class="w_idp_card" t-on-click="() => metric.available !== false &amp;&amp; this.drilldown(metric.key)" t-att-disabled="metric.available === false || state.busyAction" t-att-aria-label="'Open ' + metric.label + ' records'" t-att-title="metric.available === false ? metric.contract?.formula : false"><span t-esc="metric.label"/><strong t-esc="formatMetric(metric.key, metric.value, metric.available !== false)"/><small t-if="metric.available === false">Unavailable: <t t-esc="metric.contract?.formula || 'No reliable local relation.'"/></small><small t-elif="metric.delta !== null">Prior-period delta: <t t-esc="formatMetric(metric.key, metric.delta)"/></small><small t-else="">Prior-period delta: Not Available</small></button></section>
      <section class="w_idp_tower_grid" aria-label="Control Tower operations">
        <section class="w_idp_panel w_idp_throughput" aria-labelledby="idp-throughput-title"><p class="w_idp_eyebrow">Processing flow</p><h2 id="idp-throughput-title">Document throughput</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.document_throughput || []"/><t t-set="field" t-value="'create_date:day'"/><t t-set="kind" t-value="'document_throughput'"/></t></section>
        <section class="w_idp_panel" aria-labelledby="idp-state-title"><p class="w_idp_eyebrow">Dossier health</p><h2 id="idp-state-title">Dossier state distribution</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.case_states || []"/><t t-set="field" t-value="'state'"/><t t-set="kind" t-value="'case_state'"/></t></section>
        <section class="w_idp_panel" aria-labelledby="idp-exceptions-title"><p class="w_idp_eyebrow">Exception management</p><h2 id="idp-exceptions-title">Exceptions by severity</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.exception_severity || []"/><t t-set="field" t-value="'severity'"/><t t-set="kind" t-value="'exception_severity'"/></t></section>
      </section>
      <section class="w_idp_panel w_idp_queue" aria-labelledby="idp-queue-title"><div class="w_idp_panel_heading"><div><p class="w_idp_eyebrow">Operational worklist</p><h2 id="idp-queue-title">Active dossier queue <small>(top 8)</small></h2></div><button type="button" class="btn btn-link" t-on-click="() => this.drilldown('open_cases')">Open active cases</button></div><div class="table-responsive"><table class="table"><thead><tr><th>Dossier</th><th>State</th><th>Severity</th><th>Next action</th><th>Documents / checks / outputs</th><th>Owner</th><th>SLA</th></tr></thead><tbody><tr t-foreach="activeQueue()" t-as="item" t-key="item.id"><th scope="row"><button type="button" class="btn btn-link p-0" t-on-click="() => this.drilldown('case', item.id)" t-esc="item.name"/></th><td><span class="badge text-bg-secondary" t-esc="item.state"/></td><td t-esc="item.severity"/><td t-esc="item.next_action || '—'"/><td><t t-esc="item.document_count"/> / <t t-esc="item.check_count"/> / <t t-esc="item.output_count"/></td><td t-esc="label(item, 'owner_id')"/><td t-esc="item.sla_deadline || '—'"/></tr></tbody></table></div><p t-if="!(state.data.live_queue || []).length">Queue empty.</p></section>
      <details t-if="state.data.onboarding and !state.data.onboarding.closed" class="w_idp_panel w_idp_onboarding"><summary><span><span class="w_idp_eyebrow">Workflow</span><strong>Standard dossier workflow</strong></span></summary><div class="w_onboarding_steps"><button type="button" t-foreach="state.data.onboarding.steps || []" t-as="step" t-key="step.id" class="w_onboarding_step btn text-start" t-on-click="() => this.openOnboardingStep(step)"><strong t-esc="step.title"/><small t-esc="step.description"/><span class="badge text-bg-secondary" t-esc="stepStateLabel(step.state)"/></button></div><button type="button" class="btn btn-link" t-att-disabled="state.busyAction" t-on-click="closeOnboarding">Close workflow guide</button></details>
      <div class="w_idp_grid">
        <section class="w_idp_panel" aria-labelledby="idp-ocr-title"><p class="w_idp_eyebrow">Processing analytics</p><h2 id="idp-ocr-title">OCR</h2><div class="w_idp_columns" t-if="(state.data.ocr || []).length" aria-label="OCR runs by provider"><button type="button" t-foreach="state.data.ocr" t-as="provider" t-key="provider_index" class="w_idp_column" t-on-click="() => this.drilldown('ocr_provider', provider.provider)" t-att-aria-label="'Open ' + label(provider, 'provider') + ': ' + count(provider) + ' runs'"><strong t-esc="count(provider)"/><span class="w_idp_column_track" aria-hidden="true"><i t-att-style="'height:' + chartWidth(provider, state.data.ocr) + '%;background:' + chartColor(provider_index)"/></span><span t-esc="label(provider, 'provider')"/></button></div><div class="table-responsive w_idp_ocr_table"><table class="table w_idp_ocr"><thead><tr><th>Provider</th><th>Runs</th><th>Average confidence</th><th>Average duration</th><th>Pages</th></tr></thead><tbody><tr t-foreach="state.data.ocr || []" t-as="row" t-key="row.provider"><td><button type="button" class="btn btn-link p-0" t-on-click="() => this.drilldown('ocr_provider', row.provider)" t-esc="label(row, 'provider')"/></td><td t-esc="count(row)"/><td t-esc="row.confidence || 0"/><td t-esc="row.duration_seconds || 0"/><td t-esc="row.page_count || 0"/></tr></tbody></table></div><div class="w_idp_row" t-foreach="state.data.ocr_by_model || []" t-as="row" t-key="row.model_version"><button type="button" class="btn btn-link" t-on-click="() => this.drilldown('ocr_model', row.model_version)"><t t-esc="label(row, 'model_version')"/>: <t t-esc="count(row)"/></button></div><div class="w_idp_row" t-foreach="state.data.ocr_by_status || []" t-as="row" t-key="row.status"><button type="button" class="btn btn-link" t-on-click="() => this.drilldown('ocr_status', row.status)"><t t-esc="label(row, 'status')"/>: <t t-esc="count(row)"/></button></div><button type="button" class="btn btn-link" t-on-click="() => this.drilldown('ocr_history')">Open extraction history</button></section>
        <section class="w_idp_panel" aria-labelledby="idp-verdict-title"><p class="w_idp_eyebrow">Governance</p><h2 id="idp-verdict-title">Internal screening status</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.verdicts || []"/><t t-set="field" t-value="'verdict'"/><t t-set="kind" t-value="'verdict'"/></t></section>
        <section class="w_idp_panel"><h2>Exceptions by type</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.exceptions || []"/><t t-set="field" t-value="'exception_type'"/><t t-set="kind" t-value="'exception'"/></t></section><section class="w_idp_panel"><h2>Exceptions by state</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.exception_states || []"/><t t-set="field" t-value="'state'"/><t t-set="kind" t-value="'exception_state'"/></t></section><section class="w_idp_panel"><h2>Top suppliers by exceptions</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.top_suppliers || []"/><t t-set="field" t-value="'supplier_reference'"/><t t-set="kind" t-value="'supplier'"/></t></section><section class="w_idp_panel"><h2>Source mix</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.source_mix || []"/><t t-set="field" t-value="'source_channel'"/><t t-set="kind" t-value="'source'"/></t></section><section class="w_idp_panel"><h2>Customs regimes</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.customs_regimes || []"/><t t-set="field" t-value="'output_type'"/><t t-set="kind" t-value="'customs_regime'"/></t></section><section class="w_idp_panel"><h2>Document types</h2><t t-call="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="state.data.document_types || []"/><t t-set="field" t-value="'document_type'"/><t t-set="kind" t-value="'document_type'"/></t></section><section class="w_idp_panel"><h2>Outputs</h2><button type="button" class="btn btn-link" t-on-click="() => this.drilldown('output_history')">Open output history</button></section><section class="w_idp_panel w_idp_strategic"><h2>Strategic intelligence</h2><strong>Not Configured</strong></section>
      </div>
    </div>
  </main>
</t>
<t t-name="insilos_logistics_idp.ChartRows"><t t-set="rows" t-value="rows || []"/><t t-set="ordered" t-value="chartRows(rows, kind)"/><p t-if="!rows.length" class="w_idp_empty">No records match these filters.</p><div t-else="" t-att-class="'w_idp_visual w_idp_visual_' + chartType(kind)"><div t-if="chartType(kind) === 'donut'" class="w_idp_donut" t-att-style="donutStyle(ordered)" aria-hidden="true"><div><strong t-esc="total(rows)"/><small>Total</small></div></div><div t-if="chartType(kind) === 'line'" class="w_idp_trend"><div class="w_idp_axis"><span>Documents</span><strong t-esc="max(rows)"/></div><svg viewBox="0 0 600 200" class="w_idp_line" aria-hidden="true"><path d="M24 32H576 M24 80H576 M24 128H576 M24 176H576" class="w_idp_gridlines"/><polygon t-att-points="lineX(0, rows) + ',176 ' + linePoints(rows) + ' ' + lineX(rows.length - 1, rows) + ',176'" fill="#1764ad" opacity="0.08"/><polyline t-att-points="linePoints(rows)" fill="none" stroke="#1764ad" stroke-width="3"/><circle t-foreach="rows" t-as="point" t-key="point_index" t-att-cx="lineX(point_index, rows)" t-att-cy="lineY(point, rows)" r="4" fill="#1764ad"/></svg><div class="w_idp_axis"><span t-if="rows.length" t-esc="label(rows[0], field)"/><span t-if="rows.length" t-esc="label(rows[rows.length - 1], field)"/></div></div><div class="w_idp_legend"><button type="button" class="w_idp_bar" t-foreach="ordered" t-as="row" t-key="row_index" t-on-click="() => this.drilldownChart(kind, row, field)" t-att-aria-label="'Open ' + label(row, field) + ': ' + chartLabel(row, rows)"><span><i t-if="chartType(kind) === 'donut'" class="w_idp_swatch" t-att-style="'background:' + chartColor(row_index)"/><t t-esc="label(row, field)"/></span><svg t-if="chartType(kind) === 'ranking'" class="w_idp_chart" viewBox="0 0 100 10" role="img" t-att-aria-label="chartLabel(row, rows)"><rect class="w_idp_chart_track" x="0" y="1" width="100" height="8" rx="4"/><rect class="w_idp_chart_value" x="0" y="1" t-att-width="chartWidth(row, rows)" height="8" rx="4"/></svg><small t-elif="chartType(kind) === 'donut'" t-esc="total(rows) ? Math.round(count(row) * 100 / total(rows)) + '%' : '0%'"/><b t-esc="count(row)"/></button></div></div></t>
</templates>
