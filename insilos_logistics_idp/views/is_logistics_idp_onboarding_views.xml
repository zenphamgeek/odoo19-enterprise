<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Logistics IDP Guided Onboarding Hub View -->
    <record id="view_is_logistics_idp_onboarding_form" model="ir.ui.view">
        <field name="name">is.logistics.idp.onboarding.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Logistics IDP Knowledge &amp; Control Hub" class="o_form_view insilos_hub_form" create="false" edit="false">
                <sheet class="insilos_hub_sheet">
                    <!-- Standardized Hero Banner -->
                    <div class="insilos_hub_hero">
                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-lg-9">
                                <div class="insilos_hub_eyebrow">
                                    <i class="ph-bold ph-cpu me-1"/> AI INTELLIGENT DOCUMENT PROCESSING
                                </div>
                                <h2 class="insilos_hub_title">Trung tâm Xử lý Tài liệu &amp; Thẩm định Logistics (Logistics IDP Hub)</h2>
                                <p class="insilos_hub_desc">
                                    Tự động hóa bóc tách chứng từ xuất nhập khẩu (Invoice, B/L, Packing List, Tờ khai HQ), thẩm định chính sách tuân thủ và đồng bộ vào hệ sinh thái ERP Insilos theo chuẩn SAP Fiori Horizon &amp; IBM Carbon.
                                </p>
                            </div>
                            <div class="col-12 col-lg-3 text-lg-end">
                                <div class="insilos_hub_telemetry_badge d-inline-block text-start text-lg-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                                        <span class="insilos_pulse_dot"/>
                                        <span class="insilos_hub_status_text">AI VISION ACTIVE</span>
                                    </div>
                                    <span class="insilos_hub_metric_num">4 BƯỚC</span>
                                    <small class="insilos_hub_metric_label">Automated OCR Pipeline</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4-Step Interactive Onboarding Header -->
                    <div class="insilos_hub_section_header">
                        <div class="insilos_section_left">
                            <div class="insilos_section_icon"><i class="ph-bold ph-git-merge"/></div>
                            <h4 class="insilos_section_title">Quy trình 4 Bước Tự động hóa Chứng từ Logistics IDP:</h4>
                        </div>
                        <span class="insilos_section_badge">4-STAGE PIPELINE</span>
                    </div>

                    <!-- 4-Step Interactive Onboarding Cards -->
                    <div class="row g-3 mb-4 w-100">
                        <!-- Step 1: Inbound & Document Upload -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="insilos_hub_card">
                                <div class="insilos_card_header">
                                    <span class="insilos_step_pill">01</span>
                                    <span class="insilos_card_tag">Inbound Capture</span>
                                </div>
                                <h5 class="insilos_card_title"><i class="ph-duotone ph-tray me-2"/>Tiếp nhận Chứng từ</h5>
                                <p class="insilos_card_desc">
                                    Thu nhận Invoice, Vận đơn, Packing List, Tờ khai từ Email, Webhook hoặc tải lên trực tiếp kéo-thả nhiều file.
                                </p>
                                <div class="insilos_card_actions">
                                    <button name="%(action_logistics_documents)d" string="Document Inbox" type="action" class="btn btn-sm btn-hub-primary w-100" icon="tray"/>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: AI Extraction & Control Tower -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="insilos_hub_card">
                                <div class="insilos_card_header">
                                    <span class="insilos_step_pill">02</span>
                                    <span class="insilos_card_tag">AI Extraction</span>
                                </div>
                                <h5 class="insilos_card_title"><i class="ph-duotone ph-gauge me-2"/>Trích xuất &amp; Case</h5>
                                <p class="insilos_card_desc">
                                    Tự động nhận diện cấu trúc văn bản qua Insilos IAP AI Vision, liên kết bộ chứng từ theo Case và khớp số đơn mua PO.
                                </p>
                                <div class="insilos_card_actions">
                                    <button name="%(action_logistics_cases)d" string="Control Tower" type="action" class="btn btn-sm btn-hub-primary w-100" icon="gauge"/>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Policy & Review Center -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="insilos_hub_card">
                                <div class="insilos_card_header">
                                    <span class="insilos_step_pill">03</span>
                                    <span class="insilos_card_tag">Governance</span>
                                </div>
                                <h5 class="insilos_card_title"><i class="ph-duotone ph-shield-check me-2"/>Thẩm định &amp; Review</h5>
                                <p class="insilos_card_desc">
                                    Sàng lọc quy tắc nội bộ, kiểm tra lệch số liệu Invoice vs B/L, phát hiện cảnh báo Block để người dùng rà soát và xử lý Overrides.
                                </p>
                                <div class="insilos_card_actions">
                                    <button name="%(action_logistics_review_center)d" string="Review Center" type="action" class="btn btn-sm btn-hub-primary w-100" icon="shield-check"/>
                                </div>
                            </div>
                        </div>

                        <!-- Step 4: Downstream Outputs & ERP -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="insilos_hub_card">
                                <div class="insilos_card_header">
                                    <span class="insilos_step_pill">04</span>
                                    <span class="insilos_card_tag">ERP Integration</span>
                                </div>
                                <h5 class="insilos_card_title"><i class="ph-duotone ph-export me-2"/>Kết xuất Dữ liệu ERP</h5>
                                <p class="insilos_card_desc">
                                    Chuẩn bị Shipping Plan, Gate Pass nội bộ, Draft Vendor Bill và hồ sơ NSW để người dùng rà soát trước khi gửi qua kênh có thẩm quyền.
                                </p>
                                <div class="insilos_card_actions">
                                    <button name="%(action_logistics_output_history)d" string="Extraction Outputs" type="action" class="btn btn-sm btn-hub-primary w-100" icon="export"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Analytics & Overview Link Grid -->
                    <div class="row g-3 w-100">
                        <div class="col-12 col-md-8">
                            <div class="insilos_hub_footer_card">
                                <div class="insilos_footer_heading">
                                    <i class="ph-duotone ph-chart-pie"/>
                                    <h6>Báo cáo Hiệu suất &amp; Kiểm toán OCR Logistics:</h6>
                                </div>
                                <p class="insilos_footer_desc">Theo dõi độ tin cậy trích xuất OCR, thời gian xử lý trung bình theo Provider và tỷ lệ khớp hóa chứng từ tự động (STP Rate).</p>
                                <button name="%(action_logistics_ocr_performance)d" string="View OCR Performance Report" type="action" class="btn btn-hub-outline" icon="chart-line"/>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="insilos_hub_footer_card">
                                <div class="insilos_footer_heading">
                                    <i class="ph-duotone ph-presentation-chart"/>
                                    <h6>Dossier Control Tower:</h6>
                                </div>
                                <p class="insilos_footer_desc">Bảng điều phối thời gian thực các ca xử lý chứng từ đang hoạt động.</p>
                                <button name="%(action_logistics_overview)d" string="Launch Control Tower" type="action" class="btn btn-hub-outline" icon="arrow-right"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Logistics IDP Onboarding Hub -->
    <record id="action_is_logistics_idp_onboarding_hub" model="ir.actions.act_window">
        <field name="name">Dashboard &amp; Onboarding</field>
        <field name="path">logistics-onboarding</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_is_logistics_idp_onboarding_form"/>
    </record>

    <!-- Menu Item for Logistics IDP Dashboard & Onboarding -->
    <menuitem id="menu_logistics_onboarding_hub"
              name="Dashboard &amp; Onboarding"
              parent="menu_logistics_idp_root"
              action="action_is_logistics_idp_onboarding_hub"
              sequence="1"/>
</odoo>
