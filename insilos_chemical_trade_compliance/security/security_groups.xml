<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Privilege definition -->
        <record id="privilege_chemical_trade_compliance" model="res.groups.privilege">
            <field name="name">Chemical Trade Compliance</field>
            <field name="description">Access rights for Logistics Chemical Trade Compliance, NSW declarations and permit quotas.</field>
            <field name="sequence">76</field>
        </record>

        <!-- User Group -->
        <record id="group_chemical_compliance_user" model="res.groups">
            <field name="name">User (Logistics Officer)</field>
            <field name="privilege_id" ref="privilege_chemical_trade_compliance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group -->
        <record id="group_chemical_compliance_manager" model="res.groups">
            <field name="name">Manager (Compliance Director / Trade Lead)</field>
            <field name="privilege_id" ref="privilege_chemical_trade_compliance"/>
            <field name="implied_ids" eval="[(4, ref('group_chemical_compliance_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Auditor Group -->
        <record id="group_chemical_compliance_auditor" model="res.groups">
            <field name="name">Auditor (Internal / External Trade Audit)</field>
            <field name="privilege_id" ref="privilege_chemical_trade_compliance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_chemical_compliance_manager'))]"/>
        </record>
    </data>
</odoo>
