<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_chemical_compliance" model="ir.ui.view">
            <field name="name">rs.config.settings.view.form.inherit.chemical.compliance</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <block name="integration" position="inside">
                    <setting id="nsw_endpoint_setting" string="NSW Electronic Gateway" help="National Single Window (NSW) endpoint URL for submitting chemical import dossiers">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="nsw_api_endpoint" string="Gateway URL:" class="col-lg-3 w_light_label"/>
                                <field name="nsw_api_endpoint" placeholder="https://vnsw.gov.vn/api/v2/bct/chemicals"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="nsw_auto_evaluate_setting" string="Automated PO Evaluation" help="Automatically evaluate chemical compliance obligations when Purchase Orders are confirmed">
                        <field name="nsw_auto_evaluate_po"/>
                    </setting>
                    <setting id="chemical_quota_setting" string="Permit Quota Warning" help="Percentage threshold below which low-quota warnings are highlighted on dossiers">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="chemical_quota_warning_pct" string="Warning (%):" class="col-lg-3 w_light_label"/>
                                <field name="chemical_quota_warning_pct"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </field>
        </record>

        <record id="action_chemical_trade_compliance_config_settings" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="path">chemical-settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module': 'insilos_chemical_trade_compliance'}</field>
        </record>
    </data>
</odoo>
