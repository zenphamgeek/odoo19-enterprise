<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_form_chemical_trade_compliance" model="ir.ui.view">
            <field name="name">purchase.order.form.chemical.trade.compliance</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_create_chemical_dossier" type="object" class="w_stat_button" icon="fa-flask" invisible="not has_chemical_items and chemical_dossier_count == 0">
                        <field name="chemical_dossier_count" widget="statinfo" string="Chemical Dossiers"/>
                    </button>
                </div>
                <field name="partner_ref" position="after">
                    <field name="has_chemical_items" invisible="1"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
