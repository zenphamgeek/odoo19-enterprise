<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View: Obligation Simulator Wizard -->
    <record id="view_is_chemical_obligation_simulator_form" model="ir.ui.view">
        <field name="name">is.chemical.obligation.simulator.form</field>
        <field name="model">is.chemical.obligation.simulator</field>
        <field name="arch" type="xml">
            <form string="Chemical Internal Rule Screening Simulator">
                <sheet>
                    <div class="alert alert-info" role="status">
                        <strong>Công cụ sàng lọc theo quy tắc nội bộ:</strong> Đối chiếu mã hàng/chất với quy tắc cấu hình để hỗ trợ rà soát. Kết quả không xác nhận nghĩa vụ, cấm đoán hoặc giấy phép chính thức; cần người có thẩm quyền rà soát trước khi xử lý.
                    </div>

                    <group>
                        <group string="1. Input Parameters">
                            <field name="query_mode" widget="radio"/>
                            <field name="product_tmpl_id" invisible="query_mode != 'by_material'" required="query_mode == 'by_material'"/>
                            <field name="chemical_substance_id" invisible="query_mode != 'by_chemical'" required="query_mode == 'by_chemical'"/>
                            <field name="commercial_name"/>
                            <field name="cas_number"/>
                            <field name="hs_code"/>
                        </group>
                        <group string="2. Import Specifications &amp; Purpose">
                            <field name="concentration_percentage"/>
                            <field name="purpose_of_use_id"/>
                            <field name="quantity_estimate_kg"/>
                        </group>
                    </group>

                    <div class="text-center my-3">
                        <button name="action_simulate" string="SCREEN INTERNAL RULES" type="object" class="btn btn-primary btn-lg shadow-sm">
                            <i class="ph-duotone ph-sparkle me-1"/> Sàng lọc quy tắc nội bộ
                        </button>
                    </div>

                    <!-- Kết quả Giả lập -->
                    <div invisible="not is_simulated" class="mt-4 border rounded p-3 bg-view shadow-sm">
                        <h5 class="text-primary border-bottom pb-2">
                            <i class="ph-duotone ph-clipboard-text me-2"/> Kết quả sàng lọc quy tắc nội bộ
                        </h5>

                        <div invisible="not result_is_prohibited" class="alert alert-danger" role="alert">
                            <h5 class="alert-heading"><i class="ph-duotone ph-warning-octagon me-1"/> CỜ DỪNG XỬ LÝ NỘI BỘ</h5>
                            <p class="mb-0">Quy tắc cấu hình đã gắn cờ dừng xử lý. Không phải xác nhận cấm đoán chính thức; cần người có thẩm quyền rà soát trước khi tiếp tục.</p>
                        </div>

                        <group>
                            <group string="Obligation Classification">
                                <field name="result_obligation_category" readonly="1"/>
                                <field name="result_requires_license" readonly="1" widget="boolean_toggle"/>
                                <field name="result_license_type" readonly="1"/>
                            </group>
                            <group string="Procedures &amp; Authority">
                                <field name="result_licensing_authority" readonly="1"/>
                                <field name="result_nsw_procedure_code" readonly="1"/>
                            </group>
                        </group>

                        <group string="Ghi chú quy tắc nội bộ và bước rà soát">
                            <field name="result_notes" readonly="1" nolabel="1"/>
                        </group>

                        <div class="mt-3 text-end" invisible="result_is_prohibited">
                            <button name="action_create_dossier_from_simulation" string="Create Draft Dossier from Screening" type="object" class="btn btn-success">
                                <i class="ph-duotone ph-file-plus me-1"/> Khởi tạo hồ sơ dự thảo từ sàng lọc
                            </button>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button string="Close" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action Window: Obligation Simulator -->
    <record id="action_is_chemical_obligation_simulator" model="ir.actions.act_window">
        <field name="name">Simulate Chemical Regulatory Obligations (2026)</field>
        <field name="path">chemical-simulator</field>
        <field name="res_model">is.chemical.obligation.simulator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
