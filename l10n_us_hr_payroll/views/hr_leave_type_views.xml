<?xml version="1.0"?>
<odoo>
    <record id="leave_type_form_view" model="ir.ui.view">
        <field name="name">hr.work.entry.type.form.inherit.l10n_us</field>
        <field name="model">hr.work.entry.type</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='work_entry_payroll_tab']//group[@name='computation']" position="inside">
                <field name="l10n_us_show_on_payslip" invisible="country_code != 'US'"/>
            </xpath>
        </field>
    </record>
</odoo>
