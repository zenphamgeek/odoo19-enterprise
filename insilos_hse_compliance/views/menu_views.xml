        <!-- 3. Chemical Safety & SDS -->
        <menuitem id="menu_hse_chemical_root"
                  name="Chemicals &amp; SDS"
                  parent="menu_hse_compliance_root"
                  sequence="30"/>

        <menuitem id="menu_hse_chemical_substance_item"
                  name="Chemical Substances Master"
                  parent="menu_hse_chemical_root"
