                  sequence="30"/>

        <!-- 2. Facilities & Operations -->
        <menuitem id="menu_hse_facility_root"
                  name="Facilities &amp; Sites"
                  parent="menu_hse_compliance_root"
                  sequence="20"/>

        <menuitem id="menu_hse_facility_item"
                  name="Facilities &amp; Plants"
                  parent="menu_hse_facility_root"
