        <menuitem id="menu_hse_sync_log_item"
                  name="Synchronization Logs"
                  parent="menu_hse_events_root"
                  action="action_is_hse_sync_log"
                  sequence="20"/>

        <!-- 5. Configuration -->
        <menuitem id="menu_hse_config_root"
                  name="Configuration"
                  parent="menu_hse_compliance_root"
                  groups="group_hse_manager"
