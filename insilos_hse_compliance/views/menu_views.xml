        <!-- 1. Legal Registers & Laws -->
        <menuitem id="menu_hse_legal_root"
                  name="Legal &amp; Standards"
                  parent="menu_hse_compliance_root"
                  sequence="10"/>

        <menuitem id="menu_hse_legal_register_item"
                  name="Facility Legal Registers"
                  parent="menu_hse_legal_root"
                  action="action_is_hse_legal_register"
                  sequence="10"/>

        <menuitem id="menu_hse_legal_document_item"
                  name="Legal Documents &amp; QCVN"
                  parent="menu_hse_legal_root"
                  action="action_is_hse_legal_document"
                  sequence="20"/>

        <menuitem id="menu_hse_obligation_item"
                  name="Compliance Obligations"
                  parent="menu_hse_legal_root"
