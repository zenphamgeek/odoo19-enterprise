<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Root Menu -->
        <menuitem id="menu_hse_compliance_root"
                  name="HSE &amp; Compliance"
                  web_icon="insilos_hse_compliance,static/description/icon.svg"
                  sequence="75"/>

        <!-- 0. Onboarding & Hub -->
        <menuitem id="menu_hse_onboarding_hub_item"
                  name="Dashboard &amp; Onboarding"
                  parent="menu_hse_compliance_root"
                  action="action_is_hse_onboarding_hub"
