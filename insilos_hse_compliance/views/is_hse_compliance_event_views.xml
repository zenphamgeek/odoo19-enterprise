<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_is_hse_compliance_event_tree" model="ir.ui.view">
            <field name="name">is.hse.compliance.event.list</field>
            <field name="model">is.hse.compliance.event</field>
            <field name="arch" type="xml">
                <list string="HSE Compliance Events" decoration-info="state == 'new'" decoration-success="state == 'applied'" decoration-muted="state == 'ignored'">
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="event_type"/>
                    <field name="summary"/>
                    <field name="received_date"/>
                    <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'reviewed'" decoration-success="state == 'applied'" decoration-muted="state == 'ignored'"/>
                </list>
            </field>
        </record>

        <record id="view_is_hse_compliance_event_form" model="ir.ui.view">
            <field name="name">is.hse.compliance.event.form</field>
            <field name="model">is.hse.compliance.event</field>
            <field name="arch" type="xml">
                <form string="HSE Compliance Event">
                    <header>
                        <button name="action_apply_to_legal_register" string="Apply to Legal Register" type="object" class="w_highlight" invisible="state != 'reviewed'"/>
                        <button name="action_mark_reviewed" string="Mark Reviewed" type="object" invisible="state in ('reviewed', 'applied')"/>
                        <button name="action_ignore" string="Ignore" type="object" invisible="state in ('ignored', 'applied')"/>
                        <field name="state" widget="statusbar" statusbar_visible="new,reviewed,applied"/>
                    </header>
                    <sheet>
                        <div class="w_title">
                            <label for="name" string="Event Reference"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                            <h3>
                                <field name="summary"/>
                            </h3>
                        </div>
                        <group>
                            <group string="Event Metadata">
                                <field name="event_id"/>
                                <field name="event_type"/>
                                <field name="received_date"/>
                                <field name="reviewed_by_id"/>
                                <field name="reviewed_date"/>
                            </group>
                            <group string="Applicability Link">
                                <field name="affected_document_code"/>
                                <field name="affected_facility_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Event Payload JSON" name="payload">
                                <field name="event_payload" widget="text" placeholder="{...}"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_is_hse_compliance_event_kanban" model="ir.ui.view">
            <field name="name">is.hse.compliance.event.kanban</field>
            <field name="model">is.hse.compliance.event</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="w_kanban_small_column" sample="1">
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="event_type"/>
                    <field name="received_date"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex flex-column gap-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-primary"><field name="name"/></strong>
                                    <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'reviewed'" decoration-success="state == 'applied'" decoration-muted="state == 'ignored'"/>
                                </div>
                                <div class="text-muted small"><field name="event_type"/></div>
                                <div class="text-muted small">Received: <field name="received_date"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_is_hse_compliance_event_search" model="ir.ui.view">
            <field name="name">is.hse.compliance.event.search</field>
            <field name="model">is.hse.compliance.event</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="event_id"/>
                    <field name="event_type"/>
                    <filter name="filter_new" string="New Events" domain="[('state', '=', 'new')]"/>
                    <filter name="filter_reviewed" string="Reviewed" domain="[('state', '=', 'reviewed')]"/>
                    <filter name="filter_applied" string="Applied" domain="[('state', '=', 'applied')]"/>
                    <group>
                        <filter name="group_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_is_hse_compliance_event" model="ir.actions.act_window">
            <field name="name">Monitor Regulatory Incidents &amp; Compliance Events</field>
            <field name="path">hse-events</field>
            <field name="res_model">is.hse.compliance.event</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_is_hse_compliance_event_search"/>
        </record>
    </data>
</odoo>
