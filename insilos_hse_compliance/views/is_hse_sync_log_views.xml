<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_is_hse_sync_log_tree" model="ir.ui.view">
            <field name="name">is.hse.sync.log.list</field>
            <field name="model">is.hse.sync.log</field>
            <field name="arch" type="xml">
                <list string="HSE Knowledge Synchronization Logs" decoration-danger="status == 'error'" decoration-warning="status == 'warning'" decoration-success="status == 'success'">
                    <field name="create_date"/>
                    <field name="sync_channel"/>
                    <field name="event_type"/>
                    <field name="items_processed"/>
                    <field name="message"/>
                    <field name="status" widget="badge" decoration-success="status == 'success'" decoration-warning="status == 'warning'" decoration-danger="status == 'error'"/>
                </list>
            </field>
        </record>

        <record id="view_is_hse_sync_log_form" model="ir.ui.view">
            <field name="name">is.hse.sync.log.form</field>
            <field name="model">is.hse.sync.log</field>
            <field name="arch" type="xml">
                <form string="HSE Sync Log">
                    <sheet>
                        <group>
                            <group>
                                <field name="create_date"/>
                                <field name="sync_channel"/>
                                <field name="event_type"/>
                            </group>
                            <group>
                                <field name="status"/>
                                <field name="items_processed"/>
                            </group>
                        </group>
                        <group string="Log Message">
                            <field name="message"/>
                        </group>
                        <group string="Payload Snapshot">
                            <field name="payload_snapshot"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_is_hse_sync_log_search" model="ir.ui.view">
            <field name="name">is.hse.sync.log.search</field>
            <field name="model">is.hse.sync.log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="sync_channel"/>
                    <field name="event_type"/>
                    <field name="message"/>
                    <filter name="filter_error" string="Errors" domain="[('status', '=', 'error')]"/>
                    <filter name="filter_success" string="Successful" domain="[('status', '=', 'success')]"/>
                    <group>
                        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                        <filter name="group_channel" string="Sync Channel" context="{'group_by': 'sync_channel'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_is_hse_sync_log" model="ir.actions.act_window">
            <field name="name">Audit Legal Intelligence Sync Logs</field>
            <field name="path">hse-sync-logs</field>
            <field name="res_model">is.hse.sync.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_is_hse_sync_log_search"/>
        </record>
    </data>
</odoo>
