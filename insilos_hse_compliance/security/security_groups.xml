<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_hse_compliance" model="res.groups.privilege">
        <field name="name">HSE &amp; Compliance</field>
        <field name="sequence">36</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_hse_user" model="res.groups">
        <field name="name">User / Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_hse_compliance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hse_manager" model="res.groups">
        <field name="name">Manager / EHS Lead</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_hse_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_hse_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_hse_auditor" model="res.groups">
        <field name="name">Auditor / Read-Only</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_hse_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_hse_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hse_manager'))]"/>
    </record>
</odoo>
