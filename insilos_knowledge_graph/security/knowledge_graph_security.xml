<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_knowledge_graph" model="res.groups.privilege">
        <field name="name">Knowledge Graph</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_kg_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_knowledge_graph"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_kg_manager" model="res.groups">
        <field name="name">Projection Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_knowledge_graph"/>
        <field name="implied_ids" eval="[(4, ref('group_kg_reader'))]"/>
    </record>
    <record id="group_kg_processor" model="res.groups">
        <field name="name">Outbox Processor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_knowledge_graph"/>
        <field name="implied_ids" eval="[(4, ref('group_kg_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_kg_node_company" model="ir.rule">
        <field name="name">KG node company isolation</field>
        <field name="model_id" ref="model_kg_node"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kg_edge_company" model="ir.rule">
        <field name="name">KG edge company isolation</field>
        <field name="model_id" ref="model_kg_edge"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kg_outbox_company" model="ir.rule">
        <field name="name">KG outbox company isolation</field>
        <field name="model_id" ref="model_kg_outbox"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
