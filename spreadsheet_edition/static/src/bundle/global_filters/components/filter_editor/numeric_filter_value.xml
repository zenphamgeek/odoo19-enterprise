<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="spreadsheet_edition.NumericFilterValue">
        <NumberInput
            class="'o-global-filter-numeric-value'"
            value="this.props.value || ''"
            onChange="(val) => this.props.onValueChanged(val)"
        />
    </t>
</templates>
