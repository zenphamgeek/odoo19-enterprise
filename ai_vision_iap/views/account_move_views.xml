<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ai_vision" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ai_vision</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_trigger_ai_extraction"
                        type="object"
                        string="Extract Data via AI"
                        class="btn-primary"
                        invisible="ai_status == 'processing'"/>
                <field name="ai_status" widget="statusbar" statusbar_visible="draft,processing,done,failed"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="AI Vision IAP Details">
                    <field name="ai_status" readonly="1"/>
                    <field name="ai_error_log" readonly="1" invisible="not ai_error_log"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
