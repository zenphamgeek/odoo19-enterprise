<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Insilos Default Branding Data
        Applied on every fresh install / upgrade of insilos_website.
        Ensures company info and contact details are pre-filled
        with Insilos brand identity.
        NOTE: Website metadata (custom_code_head, robots_txt) is applied
        separately via post_init_hook to avoid external-ID issues.
    -->

    <!-- =========================================================
         1. Company — res.company (id=1)
         ========================================================= -->
    <record id="base.main_company" model="res.company">
        <field name="name">UNG DUNG SANG TAO LLC</field>
        <field name="phone">+84 944 311 811</field>
        <field name="email">contact@insilos.com</field>
        <field name="website">https://insilos.com</field>
        <field name="street">45 street 3, Trung Son Resident, Binh Hung ward</field>
        <field name="street2">Binh Chanh district</field>
        <field name="city">Ho Chi Minh city</field>
        <field name="country_id" ref="base.vn"/>
    </record>

    <!-- =========================================================
         2. Company Partner — res.partner (mirrors company)
         ========================================================= -->
    <record id="base.main_partner" model="res.partner">
        <field name="name">UNG DUNG SANG TAO LLC</field>
        <field name="vat">0313683499</field>
        <field name="phone">+84 944 311 811</field>
        <field name="email">contact@insilos.com</field>
        <field name="website">https://insilos.com</field>
        <field name="street">45 street 3, Trung Son Resident, Binh Hung ward</field>
        <field name="street2">Binh Chanh district</field>
        <field name="city">Ho Chi Minh city</field>
        <field name="country_id" ref="base.vn"/>
        <field name="comment">Nền tảng AI Vận Hành Thông Minh cho Công Nghiệp</field>
    </record>

</odoo>
