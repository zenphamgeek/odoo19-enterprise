        <!-- ============================================================ -->
        <!-- 6. INNORIA SOFTWARE SERVICES & AI CONCIERGE MARKETING FUNNEL -->
        <!-- ============================================================ -->
        <record id="crm_tag_innoria_sw_services" model="crm.tag">
            <field name="name">Innoria Software Services</field>
            <field name="color">10</field>
        </record>

        <record id="crm_tag_ai_concierge_quote" model="crm.tag">
            <field name="name">AI Concierge Interactive</field>
            <field name="color">2</field>
        </record>

        <record id="crm_tag_co_engineering_squad" model="crm.tag">
            <field name="name">Co-Engineering Squad (TT 13/2020)</field>
            <field name="color">5</field>
        </record>

        <record id="crm_tag_turnkey_activate" model="crm.tag">
            <field name="name">Turnkey Software (SAP Activate)</field>
            <field name="color">3</field>
        </record>

        <!-- Template Tầng 1 Dịch Vụ Phần Mềm: Hồ Sơ Kiến Trúc & Dự Toán TCO/ROI -->
        <record id="mailing_innoria_sw_tier1_dossier" model="mailing.mailing">
            <field name="subject">[Innoria Enterprise] Hồ Sơ Kiến Trúc Dịch Vụ Phần Mềm &amp; Bảng Dự Toán TCO/ROI</field>
            <field name="mailing_type">mail</field>
            <field name="reply_to_mode">update</field>
            <field name="mailing_model_id" ref="crm.model_crm_lead"/>
            <field name="use_in_marketing_automation">True</field>
            <field name="body_html"><![CDATA[
<div style="background-color: #070B14; color: #E2E8F0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; padding: 40px 20px; line-height: 1.6;">
    <div style="max-width: 660px; margin: 0 auto; background: #0B132B; border: 1px solid rgba(0,242,254,0.2); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.6);">
        <div style="padding: 32px 32px 24px; border-bottom: 1px solid rgba(255,255,255,0.1); background: linear-gradient(180deg, rgba(15,28,58,0.95) 0%, rgba(11,19,43,0.95) 100%);">
            <span style="display: inline-block; padding: 4px 12px; background: rgba(0,242,254,0.15); border: 1px solid rgba(0,242,254,0.35); border-radius: 9999px; color: #00F2FE; font-size: 11px; font-weight: 600; font-family: monospace; letter-spacing: 1px;">
                INNORIA SOFTWARE SERVICES // AL2C ARCHITECTURE DOSSIER
            </span>
            <h1 style="color: #FFFFFF; font-size: 23px; font-weight: 700; margin: 16px 0 8px; line-height: 1.35;">
                Hồ Sơ Kiến Trúc Dịch Vụ Phần Mềm Cấp Chủ Quyền &amp; Bảng Dự Toán TCO/ROI
            </h1>
            <p style="color: #94A3B8; font-size: 14px; margin: 0;">
                Chuẩn hóa theo IBM Carbon 11 · SAP Activate 5-Gate · Thông tư 13/2020/TT-BTTTT &amp; Nghị định 70/2025/NĐ-CP.
            </p>
        </div>

        <div style="padding: 32px;">
            <p style="font-size: 15px; color: #CBD5E1; margin-bottom: 18px;">
                Kính gửi <strong>Quý Ban Lãnh đạo &amp; Hội đồng Công nghệ</strong>,
            </p>
            <p style="font-size: 14px; color: #94A3B8; margin-bottom: 24px;">
                Hệ thống <strong>Innoria AI Concierge &amp; Deal Desk</strong> đã ghi nhận yêu cầu tư vấn dịch vụ phần mềm của Quý Doanh nghiệp. Dưới đây là 3 mô hình kỹ nghệ trọng tâm được thiết kế chuyên biệt để tối ưu 50% tổng chi phí sở hữu (TCO) và đảm bảo chủ quyền mã nguồn tuyệt đối:
            </p>

            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 22px; margin-bottom: 24px;">
                <div style="margin-bottom: 16px; border-left: 3px solid #00F2FE; padding-left: 14px;">
                    <strong style="color: #00F2FE; font-size: 14px;">1. Đội Ngũ Kỹ Sư Đồng Phát Triển Phần Mềm (Co-Engineering Squads — Chuẩn Thông tư 13/2020/TT-BTTTT):</strong>
                    <div style="color: #94A3B8; font-size: 13px; margin-top: 4px;">
                        Thực thi nghiêm ngặt quy trình 7 công đoạn sản xuất phần mềm (<em>Xác định yêu cầu -> Phân tích &amp; Thiết kế -> Lập trình -> Kiểm thử -> Đóng gói -> Cài đặt &amp; Bàn giao -> Phát hành</em>), đối soát Timesheet điện tử minh bạch và xuất Hóa đơn điện tử chuẩn ký hiệu <strong>1C26TAA</strong> theo Nghị định 70/2025/NĐ-CP.
                    </div>
                </div>
                <div style="margin-bottom: 16px; border-left: 3px solid #42E6C3; padding-left: 14px;">
