                            <div class="ins-neon-corner ins-corner-tr"/>
                            <div class="ins-neon-corner ins-corner-bl"/>
                            <div class="ins-neon-corner ins-corner-br"/>
                            <div class="ins-3d-crosshair">
                                <div class="ins-crosshair-ring"/>
                            </div>

                            <!-- Canvas Element -->
                            <canvas id="insilosDigitalTwinCanvas" class="ins-3d-canvas"/>

                            <!-- Projected Hotspots Layer -->
                            <div class="ins-hotspot-container" id="insilosHotspotContainer">
                                <!-- Hotspot 1: Hydraulic Mast -->
                                <div class="ins-hotspot-pin ins-3d-hotspot-pin" id="pin_mast" data-hotspot-id="hotspot_mast">
                                    <div class="ins-hotspot-dot badge-cyan">
                                        <div class="ins-pulse-ring"/>
                                    </div>
                                    <span class="ins-hotspot-pill">Trụ Nâng Thủy Lực</span>
                                </div>
                                <!-- Hotspot 2: Battery Pack -->
                                <div class="ins-hotspot-pin ins-3d-hotspot-pin" id="pin_battery" data-hotspot-id="hotspot_battery">
                                    <div class="ins-hotspot-dot badge-emerald">
                                        <div class="ins-pulse-ring"/>
                                    </div>
                                    <span class="ins-hotspot-pill">Bộ Nguồn LiFePO4</span>
                                </div>
                                <!-- Hotspot 3: Chassis Frame -->
                                <div class="ins-hotspot-pin ins-3d-hotspot-pin" id="pin_chassis" data-hotspot-id="hotspot_chassis">
                                    <div class="ins-hotspot-dot badge-orange">
                                        <div class="ins-pulse-ring"/>
                                    </div>
                                    <span class="ins-hotspot-pill">Khung Gầm SS400</span>
                                </div>
                                <!-- Hotspot 4: ARM Controller -->
                                <div class="ins-hotspot-pin ins-3d-hotspot-pin" id="pin_controller" data-hotspot-id="hotspot_controller">
                                    <div class="ins-hotspot-dot badge-purple">
                                        <div class="ins-pulse-ring"/>
                                    </div>
                                    <span class="ins-hotspot-pill">Bo Mạch Cortex-M4</span>
                                </div>
                            </div>

                            <!-- Floating HUD Control Bar -->
                            <div class="ins-hud-controls">
                                <span class="ins-hud-badge-status">
                                    <span class="ins-live-ping--emerald"/>
                                    <span>LIVE ERP: CONNECTED</span>
                                </span>
                                <button type="button" class="ins-hud-btn active" data-action="toggle-model" id="btnModelVlift">
                                    <svg class="ph-duotone ph-truck"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-truck"/></svg>
                                    <span>V-LIFT 2500E</span>
                                </button>
                                <button type="button" class="ins-hud-btn" data-action="toggle-model" id="btnModelCnc">
                                    <svg class="ph-duotone ph-crosshair"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-crosshair"/></svg>
                                    <span>Trạm Cắt Laser CNC</span>
                                </button>
                                <button type="button" class="ins-hud-btn" data-action="toggle-exploded" id="btnExplodedBom">
                                    <svg class="ph-duotone ph-arrows-out"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-arrows-out"/></svg>
                                    <span>Phân Rã BOM</span>
                                </button>
                                <button type="button" class="ins-hud-btn" data-action="set-mode" data-mode="pbr" data-render-mode="pbr" id="btnModePbr">
                                    <span>PBR Kim Loại</span>
                                </button>
                                <button type="button" class="ins-hud-btn" data-action="set-mode" data-mode="wireframe" data-render-mode="wireframe" id="btnModeWire">
                                    <span>Wireframe HUD</span>
                                </button>
                                <button type="button" class="ins-hud-btn" data-action="set-mode" data-mode="xray" data-render-mode="xray" id="btnModeXray">
                                    <span>Tia X-Ray</span>
                                </button>
                                <button type="button" class="ins-hud-btn" data-action="reset-camera" id="btnResetCam" title="Đặt lại góc nhìn">
                                    <svg class="ph-duotone ph-arrows-clockwise"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-arrows-clockwise"/></svg>
                                </button>
                                <button type="button" class="ins-hud-btn" data-action="toggle-fullscreen" id="btnFullscreen" title="Toàn màn hình">
                                    <svg class="ph-duotone ph-corners-out"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-corners-out"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Verified ERP Grounded Spec Ledger (HBox Balanced) -->
                <div class="row g-4 ins-card-row-balanced">
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-4 p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="badge rounded-pill bg-primary bg-opacity-20 text-primary border border-primary border-opacity-30 px-3 py-1 font-monospace">BOM CẤP 1 // ID 10</span>
                                    <span class="text-secondary small font-monospace">BOM-VLIFT-2500E</span>
                                </div>
                                <h4 class="card-title text-white fw-bold mb-2">Định Mức Lắp Ráp Xe Kéo Điện</h4>
                                <p class="card-text text-secondary mb-3">Hợp nhất 6 cụm linh kiện chính gồm Khung gầm SF-CHASSIS-25E, Cầu truyền động AC 48V, Bộ pin LFP 400Ah và Trụ nâng thủy lực Mast 4.5m.</p>
                                <div class="bg-black bg-opacity-40 rounded-3 p-3 mb-3 border border-secondary border-opacity-10">
                                    <div class="d-flex justify-content-between text-secondary small py-1 border-bottom border-secondary border-opacity-10">
                                        <span>Giá niêm yết:</span>
                                        <strong class="text-white font-monospace">385.000.000 ₫</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-secondary small py-1">
                                        <span>Chi phí định mức:</span>
                                        <strong class="text-cyan font-monospace">265.000.000 ₫</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-auto pt-2">
                                <a href="/odoo/action-367/10" data-live-link="/odoo/action-367/10" target="_blank" class="btn btn-outline-secondary rounded-pill w-100 d-inline-flex align-items-center justify-content-center gap-2 text-white">
                                    <svg class="ph-duotone ph-list-numbers"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-list-numbers"/></svg>
                                    <span>Xem Cấu Trúc BOM Live</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-4 p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="badge rounded-pill bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-3 py-1 font-monospace">LỆNH SẢN XUẤT // MO</span>
                                    <span class="text-success small font-monospace">WH/MO/00010</span>
                                </div>
                                <h4 class="card-title text-white fw-bold mb-2">Trạm Cắt Laser &amp; Hàn Robot</h4>
                                <p class="card-text text-secondary mb-3">Thao tác gia công 4 cụm khung gầm trên trung tâm gia công Laser CNC Trumpf 12kW và robot hàn Yaskawa đạt chỉ số hiệu suất OEE 92.5%.</p>
                                <div class="bg-black bg-opacity-40 rounded-3 p-3 mb-3 border border-secondary border-opacity-10">
                                    <div class="d-flex justify-content-between text-secondary small py-1 border-bottom border-secondary border-opacity-10">
                                        <span>Trạng thái lệnh:</span>
                                        <strong class="text-success font-monospace">Đang Chạy (In Progress)</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-secondary small py-1">
                                        <span>Thép SS400 giữ chỗ:</span>
                                        <strong class="text-white font-monospace">1.800 kg (Lô Thép Công Nghiệp)</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-auto pt-2">
                                <a href="/odoo/action-367/10" data-live-link="/odoo/action-367/10" target="_blank" class="btn btn-outline-secondary rounded-pill w-100 d-inline-flex align-items-center justify-content-center gap-2 text-white">
                                    <svg class="ph-duotone ph-gear-six"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-gear-six"/></svg>
                                    <span>Kiểm Tra Lệnh Sản Xuất</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-4 p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="badge rounded-pill bg-info bg-opacity-20 text-info border border-info border-opacity-30 px-3 py-1 font-monospace">HỢP ĐỒNG PO // NHÀ CUNG CẤP THÉP</span>
                                    <span class="text-secondary small font-monospace">#VN-PO2026-001</span>
                                </div>
                                <h4 class="card-title text-white fw-bold mb-2">Vật Tư Thép Tấm Kết Cấu</h4>
                                <p class="card-text text-secondary mb-3">Hợp đồng cung ứng 20 tấn thép tấm cán nóng kết cấu SS400 dày 12mm và 600m thép hộp nhúng kẽm, khóa biên độ giá dung sai ±2%.</p>
                                <div class="bg-black bg-opacity-40 rounded-3 p-3 mb-3 border border-secondary border-opacity-10">
                                    <div class="d-flex justify-content-between text-secondary small py-1 border-bottom border-secondary border-opacity-10">
                                        <span>Tổng giá trị PO:</span>
                                        <strong class="text-white font-monospace">537.000.000 ₫</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-secondary small py-1">
                                        <span>Đơn vị cung ứng:</span>
                                        <strong class="text-cyan font-monospace">Nhà Cung Cấp Thép Tiêu Chuẩn</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-auto pt-2">
                                <a href="/odoo/action-758/1" data-live-link="/odoo/action-758/1" target="_blank" class="btn btn-outline-secondary rounded-pill w-100 d-inline-flex align-items-center justify-content-center gap-2 text-white">
                                    <svg class="ph-duotone ph-receipt"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-receipt"/></svg>
                                    <span>Đối Soát Đơn Hàng PO</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

