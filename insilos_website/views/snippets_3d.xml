                 data-name="Insilos 3D Logistics Radar Map"
                 data-bs-theme="dark">
            <div class="container position-relative z-1 py-4">
                <!-- Section Header -->
                <div class="row mb-5 text-center">
                    <div class="col-lg-9 mx-auto">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-15 border border-primary border-opacity-30 text-cyan small mb-3 font-monospace">
                            <span class="ins-live-ping--emerald"/>
                            <span>MULTIMODAL SUPPLY CHAIN RADAR // VSIP TO SEAPORT</span>
                        </div>
                        <h2 class="display-5 fw-bold text-white mb-3">
                            Bản Đồ 3D Chuỗi Tiếp Vận &amp; Cụm Cảng Biển Quốc Tế
                        </h2>
                        <p class="lead text-secondary fs-5 col-lg-10 mx-auto">
                            Mô phỏng hành lang vận tải container 32.4 km từ KCN VSIP đến Cụm Cảng Biển Quốc Tế trên đoàn xe Hyundai Xcient 440PS, tự động kiểm soát hạn giải phóng vỏ để triệt tiêu phí lưu bãi DET/DEM.
                        </p>
                    </div>
                </div>

                <!-- 3D Radar Viewport Container -->
                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <div class="ins-3d-viewport ins-radar-viewport position-relative ins-3d-logistics-radar-canvas" id="insilosLogisticsRadarViewport" data-insilos-3d="logistics-radar">
                            <div class="ins-3d-grid-bg"/>
                            <div class="ins-neon-corner ins-corner-tl ins-corner-orange"/>
                            <div class="ins-neon-corner ins-corner-tr ins-corner-orange"/>
                            <div class="ins-neon-corner ins-corner-bl ins-corner-orange"/>
                            <div class="ins-neon-corner ins-corner-br ins-corner-orange"/>

                            <!-- Canvas Element -->
                            <canvas id="insilosLogisticsRadarCanvas" class="ins-3d-canvas"/>

                            <!-- Checkpoint Pills Overlay -->
                            <div class="position-absolute top-0 start-0 p-3 z-2 d-flex flex-wrap gap-2">
                                <span class="ins-radar-checkpoint-pill is-active" data-checkpoint="vsip">
                                    <svg class="ph-duotone ph-factory"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-factory"/></svg>
                                    <span>KCN VSIP 1</span>
                                </span>
                                <span class="ins-radar-checkpoint-pill" data-checkpoint="ql13">
                                    <svg class="ph-duotone ph-navigation-arrow"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-navigation-arrow"/></svg>
                                    <span>Đại Lộ Bình Dương (QL13)</span>
                                </span>
                                <span class="ins-radar-checkpoint-pill" data-checkpoint="phumy">
                                    <svg class="ph-duotone ph-bridge"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-bridge"/></svg>
                                    <span>Vành Đai 2 / Tuyến Huyết Mạch</span>
                                </span>
                                <span class="ins-radar-checkpoint-pill" data-checkpoint="catlai">
                                    <svg class="ph-duotone ph-anchor"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-anchor"/></svg>
                                    <span>Cụm Cảng Biển Quốc Tế</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Interactive Timeline Scrubber & Live Yard Telemetry -->
                <div class="row g-4 mb-5 align-items-center">
                    <div class="col-lg-8">
                        <div class="bg-dark bg-opacity-60 border border-secondary border-opacity-25 rounded-4 p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-white fw-bold d-inline-flex align-items-center gap-2">
                                    <svg class="ph-duotone ph-clock text-primary fs-5"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-clock"/></svg>
                                    <span>Tiến Trình Hành Trình Vận Tải (Timeline Scrubber)</span>
                                </span>
                                <span class="text-cyan font-monospace small" id="radarTimelineValue">35% // Tuyến Vành Đai 2</span>
                            </div>
                            <input type="range" class="form-range ins-timeline-scrubber mb-2" id="insilosLogisticsTimeline" min="0" max="100" value="35"/>
                            <div class="d-flex justify-content-between text-secondary small font-monospace">
                                <span>0h (Xuất xưởng VSIP)</span>
                                <span>+1.5h (Hành lang drayage)</span>
                                <span>+3.0h (Bãi CY Cảng Biển)</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="bg-dark bg-opacity-60 border border-secondary border-opacity-25 rounded-4 p-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-secondary small">Cảnh Báo DET/DEM:</span>
                                <span class="badge rounded-pill bg-success bg-opacity-20 text-success border border-success border-opacity-30 font-monospace">AN TOÀN</span>
                            </div>
                            <h4 class="text-white fw-bold mb-1 font-monospace">38.5h Miễn Phí</h4>
                            <p class="text-secondary small mb-0">Tiết kiệm dự kiến: <strong class="text-primary font-monospace">5.950.000 ₫/ngày</strong> nhờ điều xe thông minh.</p>
                        </div>
                    </div>
                </div>

                <!-- Logistics Telemetry Row (HBox Balanced) -->
                <div class="row g-4 ins-card-row-balanced">
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-4 p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="badge rounded-pill bg-info bg-opacity-20 text-info border border-info border-opacity-30 px-3 py-1 font-monospace">XE ĐẦU KÉO // FLEET</span>
                                    <span class="text-white small font-monospace">51C-982.45</span>
                                </div>
                                <h4 class="card-title text-white fw-bold mb-2">Đội Xe Vận Tải Hyundai Xcient</h4>
                                <p class="card-text text-secondary mb-3">Đầu kéo 6x4 công suất 440PS gắn rơ-moóc xương CIMC 40ft (51R-089.34), tích hợp cảm biến telematics giám sát lộ trình và tiêu hao dầu.</p>
                                <div class="bg-black bg-opacity-40 rounded-3 p-3 mb-3 border border-secondary border-opacity-10">
                                    <div class="d-flex justify-content-between text-secondary small py-1 border-bottom border-secondary border-opacity-10">
                                        <span>Đồng hồ ODO:</span>
                                        <strong class="text-white font-monospace">142.500 km</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-secondary small py-1">
                                        <span>Bảo dưỡng PVOIL:</span>
                                        <strong class="text-success font-monospace">7.525.000 ₫ (Done)</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-auto pt-2">
                                <a href="/odoo/action-738/6" data-live-link="/odoo/action-738/6" target="_blank" class="btn btn-outline-secondary rounded-pill w-100 d-inline-flex align-items-center justify-content-center gap-2 text-white">
                                    <svg class="ph-duotone ph-truck"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-truck"/></svg>
                                    <span>Hồ Sơ Xe 51C-982.45</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-4 p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="badge rounded-pill bg-primary bg-opacity-20 text-primary border border-primary border-opacity-30 px-3 py-1 font-monospace">ĐỐI TÁC CẢNG // QUỐC TẾ</span>
                                    <span class="text-cyan small font-monospace">#VN-SO2026-001</span>
                                </div>
                                <h4 class="card-title text-white fw-bold mb-2">Hợp Đồng Tiếp Vận Cảng Biển Quốc Tế</h4>
                                <p class="card-text text-secondary mb-3">Gói thầu thiết bị kéo hàng và điều độ container cảng biển trị giá 2.295 Tỷ VNĐ gồm 5 xe V-LIFT 2500E và 2 trạm sạc nhanh DC 60kW.</p>
                                <div class="bg-black bg-opacity-40 rounded-3 p-3 mb-3 border border-secondary border-opacity-10">
                                    <div class="d-flex justify-content-between text-secondary small py-1 border-bottom border-secondary border-opacity-10">
                                        <span>Quy mô gói thầu:</span>
                                        <strong class="text-white font-monospace">2.295.000.000 ₫</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-secondary small py-1">
                                        <span>Cẩu bờ chỉ định:</span>
                                        <strong class="text-cyan font-monospace">STS-08 Paceco Twin</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-auto pt-2">
                                <a href="/odoo/action-561/1" data-live-link="/odoo/action-561/1" target="_blank" class="btn btn-outline-secondary rounded-pill w-100 d-inline-flex align-items-center justify-content-center gap-2 text-white">
                                    <svg class="ph-duotone ph-file-text"><use href="/insilos_website/static/src/icons/phosphor-duotone.svg#ph-file-text"/></svg>
                                    <span>Hợp Đồng Thầu Cảng Biển</span>
                                </a>
                            </div>
                        </div>
