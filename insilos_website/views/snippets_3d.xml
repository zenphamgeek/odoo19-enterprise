    <!-- 1. SIGNATURE 3D DIGITAL TWIN EQUIPMENT SNIPPET                    -->
    <!-- ================================================================= -->
    <template id="s_insilos_3d_digital_twin" name="Insilos 3D Digital Twin Equipment">
        <section class="s_features o_colored_level o_cc o_cc5 py-5 position-relative overflow-hidden ins-3d-digital-twin-section"
                 data-snippet="s_insilos_3d_digital_twin"
                 data-name="Insilos 3D Digital Twin Equipment"
                 data-bs-theme="dark">
            <div class="container position-relative z-1 py-4">
                <!-- Section Header -->
                <div class="row mb-5 text-center">
                    <div class="col-lg-9 mx-auto">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-15 border border-primary border-opacity-30 text-cyan small mb-3 font-monospace">
                            <span class="ins-live-ping--emerald"/>
                            <span>SOVEREIGN DIGITAL TWIN // THREE.JS 360° WEBGL</span>
                        </div>
                        <h2 class="display-5 fw-bold text-white mb-3">
                            Mô Hình 3D Kỹ Thuật Số Xe Kéo Điện V-LIFT 2500E
                        </h2>
                        <p class="lead text-secondary fs-5 col-lg-10 mx-auto">
                            Tương tác xoay 360°, thu phóng, phân rã cụm linh kiện BOM đa cấp và trích xuất trực tiếp dữ liệu vận hành thời gian thực từ cơ sở dữ liệu Insilos ERP backend.
                        </p>
                    </div>
                </div>

                <!-- 3D WebGL Viewport Container -->
                <div class="row g-4 mb-5">
                    <div class="col-12">
                        <div class="ins-3d-viewport position-relative ins-3d-digital-twin-canvas" id="insilosDigitalTwinViewport" data-insilos-3d="digital-twin">
