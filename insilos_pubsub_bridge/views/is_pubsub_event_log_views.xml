<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         EVENT LOG — LIST VIEW (enhanced with priority badges)
         ═══════════════════════════════════════════════════════════════ -->

    <record id="view_pubsub_event_log_list" model="ir.ui.view">
        <field name="name">is.pubsub.event.log.list</field>
        <field name="model">is.pubsub.event.log</field>
        <field name="arch" type="xml">
            <list string="Inbound Event Logs" decoration-success="state == 'processed'" decoration-warning="state == 'received'" decoration-danger="state == 'failed'" decoration-muted="state == 'ignored'">
                <field name="create_date" string="Received"/>
                <field name="event_id"/>
                <field name="event_type"/>
                <field name="sender_email"/>
                <field name="sender_name"/>
                <field name="subject"/>
                <field name="priority" widget="badge" decoration-success="priority == 'LOW'" decoration-info="priority == 'NORMAL'" decoration-warning="priority == 'HIGH'" decoration-danger="priority == 'URGENT'"/>
                <field name="target_model"/>
                <field name="target_res_id"/>
                <field name="trace_id" optional="show"/>
                <field name="retry_count" string="Attempts"/>
                <field name="requeue_generation" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'processed'" decoration-danger="state == 'failed'" decoration-warning="state == 'received'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         EVENT LOG — FORM VIEW (with replay &amp; mark-failed buttons)
         ═══════════════════════════════════════════════════════════════ -->

    <record id="view_pubsub_event_log_kanban" model="ir.ui.view">
        <field name="name">is.pubsub.event.log.kanban</field>
        <field name="model">is.pubsub.event.log</field>
        <field name="arch" type="xml">
            <kanban><field name="state"/><templates><t t-name="card"><field name="subject"/><field name="sender_email"/><field name="state" widget="badge"/></t></templates></kanban>
        </field>
    </record>

    <record id="view_pubsub_event_log_form" model="ir.ui.view">
        <field name="name">is.pubsub.event.log.form</field>
        <field name="model">is.pubsub.event.log</field>
        <field name="arch" type="xml">
            <form string="Event Log Details">
                <header>
                    <button name="action_requeue_event" type="object" string="Requeue Event" class="btn-primary" groups="insilos_pubsub_bridge.group_pubsub_manager" context="{'requeue_reason': 'Manager UI requeue'}" invisible="state not in ('failed', 'received')"/>
                    <button name="action_open_target_record" type="object" string="Open Target Record" class="btn-secondary" invisible="not target_model or not target_res_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="received,processed,failed,requeued,ignored"/>
                </header>
                <sheet>
                    <div class="w_title">
                        <label for="event_id" string="Event ID"/>
                        <h1><field name="event_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Event Identity">
                            <field name="event_type"/>
                            <field name="trace_id"/>
                            <field name="source"/>
                            <field name="producer"/>
                            <field name="priority"/>
                            <field name="gcp_message_id"/>
                            <field name="history_id"/>
                        </group>
                        <group string="Sender &amp; Content">
                            <field name="sender_email"/>
                            <field name="sender_name"/>
                            <field name="subject"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dispatch Target">
                            <field name="target_model"/>
                            <field name="target_res_id"/>
                            <field name="target_record_ref"/>
                        </group>
                        <group string="Retry &amp; Dead Letter Queue">
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="last_retry_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="AI Analysis" name="ai_analysis">
                            <group>
                                <field name="ai_summary" nolabel="1" placeholder="AI-extracted summary will appear here..."/>
                            </group>
                            <group string="Extracted Entities (JSON)">
                                <field name="ai_entities_json" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                            </group>
                        </page>
                        <page string="Raw Payload" name="raw_payload">
                            <field name="payload" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Error Diagnostics" name="errors" invisible="not error_message">
                            <field name="error_message" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         EVENT LOG — SEARCH VIEW (with facets &amp; groupby)
         ═══════════════════════════════════════════════════════════════ -->

    <record id="view_pubsub_event_log_search" model="ir.ui.view">
        <field name="name">is.pubsub.event.log.search</field>
        <field name="model">is.pubsub.event.log</field>
        <field name="arch" type="xml">
            <search string="Search Event Logs">
                <field name="event_id"/>
                <field name="sender_email"/>
                <field name="sender_name"/>
                <field name="subject"/>
                <field name="trace_id"/>
                <filter string="Processed" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Failed / Dead Letter" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Received (Pending)" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Ignored / Dedup" name="ignored" domain="[('state', '=', 'ignored')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', 'URGENT')]"/>
                <filter string="High Priority" name="high" domain="[('priority', '=', 'HIGH')]"/>
                <separator/>
                <filter string="Received Date" name="filter_create_date" date="create_date"/>
                <separator/>
                <group name="group_by">
                    <filter string="Event Type" name="group_event_type" context="{'group_by': 'event_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Sender" name="group_sender" context="{'group_by': 'sender_email'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pubsub_event_log" model="ir.actions.act_window">
        <field name="name">Inbound Event Logs</field>
        <field name="res_model">is.pubsub.event.log</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No inbound events have been received yet.
            </p>
            <p>
                Events are automatically logged when the Pub/Sub webhook receives payloads from Gmail push notifications or Hermes AI Agent.
            </p>
        </field>
    </record>

</odoo>
