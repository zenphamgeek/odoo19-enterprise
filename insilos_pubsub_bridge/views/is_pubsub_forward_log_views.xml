<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pubsub_forward_log_list" model="ir.ui.view">
        <field name="name">is.pubsub.forward.log.list</field>
        <field name="model">is.pubsub.forward.log</field>
        <field name="arch" type="xml">
            <list string="Call Forwarding &amp; Dispatch History" decoration-success="state == 'success'" decoration-danger="state == 'failed'">
                <field name="create_date" string="Forward Timestamp"/>
                <field name="rule_id"/>
                <field name="event_log_id"/>
                <field name="forward_url"/>
                <field name="http_status"/>
                <field name="latency_ms" string="Latency (ms)"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_pubsub_forward_log_search" model="ir.ui.view">
        <field name="name">is.pubsub.forward.log.search</field>
        <field name="model">is.pubsub.forward.log</field>
        <field name="arch" type="xml">
            <search><field name="forward_url"/><field name="rule_id"/></search></field>
    </record>

    <record id="view_pubsub_forward_log_kanban" model="ir.ui.view">
        <field name="name">is.pubsub.forward.log.kanban</field>
        <field name="model">is.pubsub.forward.log</field>
        <field name="arch" type="xml">
            <kanban><field name="state"/><templates><t t-name="card"><field name="rule_id"/><field name="forward_url"/><field name="state" widget="badge"/></t></templates></kanban>
        </field>
    </record>

    <record id="view_pubsub_forward_log_form" model="ir.ui.view">
        <field name="name">is.pubsub.forward.log.form</field>
        <field name="model">is.pubsub.forward.log</field>
        <field name="arch" type="xml">
            <form string="Call Forwarding Log Entry">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="success,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Routing Metadata">
                            <field name="rule_id" readonly="1"/>
                            <field name="event_log_id" readonly="1"/>
                            <field name="forward_url" readonly="1"/>
                        </group>
                        <group string="HTTP Execution Response">
                            <field name="http_status" readonly="1"/>
                            <field name="latency_ms" readonly="1"/>
                            <field name="create_date" readonly="1" string="Execution Time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Response Body">
                            <field name="response_body" readonly="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Error Diagnostics" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pubsub_forward_log" model="ir.actions.act_window">
        <field name="name">Call Forwarding History</field>
        <field name="res_model">is.pubsub.forward.log</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
