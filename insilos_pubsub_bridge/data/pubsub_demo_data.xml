    <record id="demo_event_logistics" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-logistics-004</field>
        <field name="event_type">email.inbound.logistics_idp</field>
        <field name="source">hermes-agent-event-bus</field>
        <field name="state">processed</field>
        <field name="priority">HIGH</field>
        <field name="sender_email">docs@maersk.com</field>
        <field name="sender_name">Maersk Shipping Documentation</field>
        <field name="subject">B/L MAEU-2026081234 — Container TRIU-4567890 — HCM → Rotterdam</field>
        <field name="ai_summary">Bill of Lading for container TRIU-4567890, 40HC carrying 22MT Ethanol (HS 2207.10), sailing date 2026-08-25, ETA Rotterdam 2026-09-22.</field>
    </record>

    <record id="demo_event_invoice" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-inv-006</field>
        <field name="event_type">finance.inbound.invoice</field>
        <field name="source">hermes-agent-event-bus</field>
        <field name="state">processed</field>
        <field name="priority">HIGH</field>
        <field name="sender_email">billing@vopak.com</field>
        <field name="sender_name">Vopak Terminal Vietnam</field>
        <field name="subject">E-Invoice #VPK-2026-0899 — Bulk Liquid Storage Fee August 2026</field>
        <field name="ai_summary">Vendor bill from Vopak for bulk chemical storage terminal capacity. Total Amount: $45,000 USD (VAT 10% included). Due Date: 2026-09-15. Bank: CitiBank HCMC.</field>
        <field name="target_model">account.move</field>
    </record>

    <record id="demo_event_payment" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-pay-007</field>
        <field name="event_type">finance.inbound.payment_advice</field>
        <field name="source">gmail.pubsub</field>
        <field name="state">processed</field>
        <field name="priority">NORMAL</field>
        <field name="sender_email">treasury@petrovietnam.vn</field>
        <field name="sender_name">PetroVietnam Gas Treasury</field>
        <field name="subject">Payment Remittance Advice: Ref TXN-9982314 — $120,500 USD</field>
        <field name="ai_summary">Wire transfer confirmation for ISO Tank delivery contract #PVG-2026-044. Amount: $120,500 USD transferred to Insilos Operating Account at Vietcombank.</field>
    </record>

    <record id="demo_event_customs" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-customs-008</field>
        <field name="event_type">logistics.customs.declaration</field>
        <field name="source">hermes-agent-event-bus</field>
        <field name="state">processed</field>
        <field name="priority">HIGH</field>
        <field name="sender_email">vnaccs-gateway@customs.gov.vn</field>
        <field name="sender_name">Vietnam Customs VNACCS Gateway</field>
        <field name="subject">Customs Clearance Clearance Notice: TKHQ 105882910030 / Cat Lai Port</field>
        <field name="ai_summary">VNACCS Green Channel clearance approved for Declaration #105882910030, 50MT Propylene Glycol USP, Duty Rate: 0% (VKFTA), Customs Sub-department Zone II Cat Lai.</field>
        <field name="target_model">logistics.idp.case</field>
    </record>

    <record id="demo_event_cems" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-cems-009</field>
        <field name="event_type">esg.emissions.cems_alert</field>
        <field name="source">custom-webhook</field>
        <field name="state">processed</field>
        <field name="priority">URGENT</field>
        <field name="sender_email">cems-telemetry@plant-dinhvu.vn</field>
        <field name="sender_name">Dinh Vu Facility CEMS Telemetry</field>
        <field name="subject">CRITICAL ALERT: Stack #2 SO2 Exceedance (485 mg/Nm3 vs Limit 400 mg/Nm3)</field>
        <field name="ai_summary">CEMS Continuous Emission Monitoring sensor #2 recorded SO2 concentration at 485 mg/Nm3 for 18 consecutive minutes, exceeding QCVN 19:2009/BTNMT column B limit (400 mg/Nm3). Auto-CAPA task dispatched.</field>
        <field name="target_model">project.task</field>
    </record>

    <record id="demo_event_failed" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-failed-005</field>
        <field name="event_type">general.event</field>
        <field name="source">custom-webhook</field>
        <field name="state">failed</field>
        <field name="priority">LOW</field>
        <field name="sender_email">noreply@partner-system.com</field>
        <field name="sender_name">Partner Webhook</field>
        <field name="subject">Unrecognized Event Type — partner.inventory.sync</field>
        <field name="ai_summary">Event could not be routed: unknown event_type partner.inventory.sync. Requires manual rule configuration.</field>
        <field name="error_message">No matching workflow route for event_type 'partner.inventory.sync'. Event logged for manual review.</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SAMPLE OUTBOUND RULE
         ═══════════════════════════════════════════════════════════════ -->

    <record id="outbound_rule_crm_created" model="is.pubsub.outbound.rule">
        <field name="name">Notify Hermes Agent on New CRM Leads</field>
        <field name="sequence">1</field>
        <field name="model_name">crm.lead</field>
        <field name="trigger_action">create</field>
        <field name="target_url">http://10.123.214.1:5678/webhook/erp-events</field>
        <field name="http_method">POST</field>
        <field name="max_retries">3</field>
        <field name="include_full_record" eval="True"/>
    </record>

</odoo>
