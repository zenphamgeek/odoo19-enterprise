<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ═══════════════════════════════════════════════════════════════
         PRE-CONFIGURED CHANNELS
         ═══════════════════════════════════════════════════════════════ -->

    <record id="channel_gmail_push" model="is.pubsub.channel">
        <field name="name">Gmail Real-Time Push Notifications</field>
        <field name="channel_type">gmail_push</field>
        <field name="sequence">1</field>
        <field name="gcp_project_id">project-3e385278-cd08-450</field>
        <field name="topic_name">gmail-notifications</field>
        <field name="subscription_name">gmail-notifications-sub</field>
        <field name="monitored_email">inteligentsilos@gmail.com</field>
        <field name="state">active</field>
        <field name="last_status_message">Connected to Google Cloud Pub/Sub — Gmail Watch active.</field>
        <field name="auto_renew_watch" eval="True"/>
    </record>

    <record id="channel_hermes_event_bus" model="is.pubsub.channel">
        <field name="name">Hermes AI Agent Event Bus</field>
        <field name="channel_type">hermes_event_bus</field>
        <field name="sequence">2</field>
        <field name="gcp_project_id">project-3e385278-cd08-450</field>
        <field name="topic_name">hermes-agent-events</field>
        <field name="subscription_name">hermes-events-sub</field>
        <field name="monitored_email">inteligentsilos@gmail.com</field>
        <field name="state">active</field>
        <field name="last_status_message">Hermes Agent connected — AI analysis pipeline operational.</field>
    </record>

    <record id="channel_outbound_erp" model="is.pubsub.channel">
        <field name="name">Outbound ERP Event Stream</field>
        <field name="channel_type">outbound_topic</field>
        <field name="sequence">3</field>
        <field name="gcp_project_id">project-3e385278-cd08-450</field>
        <field name="topic_name">erp-outbound-events</field>
        <field name="subscription_name">erp-outbound-sub</field>
        <field name="state">active</field>
        <field name="last_status_message">Outbound event publisher ready.</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         PRE-CONFIGURED AUTOMATION RULES
         ═══════════════════════════════════════════════════════════════ -->

    <record id="rule_auto_route_crm" model="is.pubsub.automation.rule">
        <field name="name">Auto-Route Quotation Inquiries → CRM Leads</field>
        <field name="sequence">1</field>
        <field name="event_type_filter">email.inbound.crm_lead</field>
        <field name="action_type">route_model</field>
        <field name="target_model">crm.lead</field>
        <field name="call_forward_enabled" eval="False"/>
        <field name="telegram_alert_enabled" eval="True"/>
        <field name="telegram_chat_id">1431349185</field>
        <field name="state">active</field>
    </record>

    <record id="rule_forward_to_hermes" model="is.pubsub.automation.rule">
        <field name="name">Forward All Events → Hermes AI Agent</field>
        <field name="sequence">5</field>
        <field name="event_type_filter">all</field>
        <field name="action_type">call_forward</field>
        <field name="call_forward_enabled" eval="True"/>
        <field name="forward_url">http://10.123.214.1:5678/webhook/ingest</field>
        <field name="forward_http_method">POST</field>
        <field name="forward_timeout_sec">10</field>
        <field name="telegram_alert_enabled" eval="False"/>
        <field name="state">active</field>
    </record>

    <record id="rule_telegram_urgent" model="is.pubsub.automation.rule">
        <field name="name">Telegram Alert — High Priority &amp; Urgent Events</field>
        <field name="sequence">10</field>
        <field name="event_type_filter">all</field>
        <field name="keyword_filter">URGENT,HIGH,critical,compliance</field>
        <field name="action_type">telegram_alert</field>
        <field name="call_forward_enabled" eval="False"/>
        <field name="telegram_alert_enabled" eval="True"/>
        <field name="telegram_chat_id">1431349185</field>
        <field name="state">active</field>
    </record>

    <record id="rule_sds_compliance" model="is.pubsub.automation.rule">
        <field name="name">Chemical SDS → HSE Compliance Auto-Register</field>
        <field name="sequence">15</field>
        <field name="event_type_filter">email.inbound.chemical_sds</field>
        <field name="action_type">multi_action</field>
        <field name="target_model">is.hse.sds</field>
        <field name="call_forward_enabled" eval="True"/>
        <field name="forward_url">http://10.123.214.1:5678/webhook/sds-compliance</field>
        <field name="forward_http_method">POST</field>
        <field name="telegram_alert_enabled" eval="True"/>
        <field name="telegram_chat_id">1431349185</field>
        <field name="state">active</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SAMPLE EVENT LOGS (showing event lifecycle)
         ═══════════════════════════════════════════════════════════════ -->

    <record id="demo_event_crm_lead" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-crm-001</field>
        <field name="event_type">email.inbound.crm_lead</field>
        <field name="source">gmail.pubsub</field>
        <field name="state">processed</field>
        <field name="priority">HIGH</field>
        <field name="sender_email">procurement@hapag-lloyd.com</field>
        <field name="sender_name">Hapag-Lloyd Procurement</field>
        <field name="subject">RFQ: Chemical Logistics Container Rate 40HC HCM → Hamburg</field>
        <field name="ai_summary">Quotation request for 40HC container shipping rate from Ho Chi Minh City to Hamburg. Estimated 25 TEU monthly volume. Requested transit time &lt;28 days.</field>
        <field name="target_model">crm.lead</field>
    </record>

    <record id="demo_event_vendor_quote" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-vendor-002</field>
        <field name="event_type">email.inbound.vendor_quote</field>
        <field name="source">gmail.pubsub</field>
        <field name="state">processed</field>
        <field name="priority">NORMAL</field>
        <field name="sender_email">sales@basf.com</field>
        <field name="sender_name">BASF Chemical Distribution</field>
