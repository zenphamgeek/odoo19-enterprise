    <record id="demo_event_sds" model="is.pubsub.event.log">
        <field name="event_id">demo-evt-sds-003</field>
        <field name="event_type">email.inbound.chemical_sds</field>
        <field name="source">hermes-agent-event-bus</field>
        <field name="state">processed</field>
