                <!-- ============================================================= -->
                <!-- 3. VÙNG TRỒNG CẦU ĐẤT: THIÊN ĐƯỜNG ARABICA NÚI CAO             -->
                <!-- ============================================================= -->
                <section class="s_image_text o_colored_level o_cc o_cc5 pt80 pb80 border-top border-secondary border-opacity-25" data-snippet="s_image_text" data-name="Cầu Đất Arabica Terroir">
                    <div class="container">
                        <div class="row align-items-center g-5 flex-lg-row-reverse">
                            <div class="col-lg-6">
                                <div class="inno-pill-badge mb-3">
                                    <span>BORDEAUX CỦA CÀ PHÊ VIỆT // CẦU ĐẤT LÂM ĐỒNG</span>
                                </div>
                                <h2 class="display-5 fw-bold text-white mb-3">
                                    Độ Cao 1.650m &amp; Bản Tình Ca <span class="inno-amber-text">Specialty Arabica</span>
                                </h2>
                                <p class="text-secondary mb-3 lh-base">
                                    Cách trung tâm Đà Lạt 25km về phía Đông Nam, vùng Cầu Đất (xã Trạm Hành và Xuân Trường) được người Pháp phát hiện và kiến tạo đồn điền cà phê từ năm 1927. Tọa lạc tại độ cao lý tưởng <strong class="text-white">1.500 – 1.650m</strong>, vùng đất này quanh năm bao phủ trong sương mù và gió lạnh ôn đới (14 – 22°C).
                                </p>
                                <p class="text-secondary mb-4 lh-base">
                                    Không khí loãng và bức xạ dịu nhẹ kéo dài chu kỳ chín của trái cà phê lên tới 8 – 9 tháng. Quá trình phát triển chậm rãi này giúp hạt tích lũy cấu trúc tế bào dày đặc, hình thành các hợp chất hữu cơ phong phú tạo nên vị chua thanh sáng rực rỡ và hương hoa quả tinh tế hiếm có. InnoKafe tuyển chọn giống <strong class="text-white">Bourbon vàng cổ, Bourbon đỏ và Catimor thuần</strong> trên các triền đồi dốc.
                                </p>
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <div class="p-3 rounded-3 inno-inner-panel">
                                            <div class="fw-bold inno-amber-text mb-1">Hồ Sơ Vị Giác (Specialty Arabica)</div>
                                            <div class="text-secondary small">Hương hoa nhài trắng, cam Bergamot, táo xanh mọng nước, trà Earl Grey, vị chua thanh tao nhã và Clean Cup tuyệt đối.</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-3 rounded-3 inno-inner-panel">
                                            <div class="fw-bold inno-amber-text mb-1">Kiểm Soát Độ Đường Brix</div>
                                            <div class="text-secondary small">Đo đạc khúc xạ kế cầm tay đạt tối thiểu 20 – 24% Brix trên cây trước khi thu hái, bảo chứng vị ngọt thanh khiết.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="inno-craft-card rounded-4 p-4 text-white">
                                    <div class="border-bottom border-secondary border-opacity-15 pb-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="fw-bold mb-0 text-white">Đặc Tả Thổ Nhưỡng Cầu Đất</h5>
                                            <span class="badge bg-warning text-dark font-monospace fw-bold">SPECIALTY SPEC</span>
                                        </div>
                                    </div>
                                    <div class="pt-3">
                                        <table class="table table-dark table-borderless text-secondary small mb-0">
                                            <tbody>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Địa danh:</td>
                                                    <td>Trạm Hành &amp; Xuân Trường, Cầu Đất, Đà Lạt, Lâm Đồng</td>
                                                </tr>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Độ cao:</td>
                                                    <td>1.500 – 1.650m so với mực nước biển (masl)</td>
                                                </tr>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Khí hậu:</td>
                                                    <td>Cận ôn đới núi cao, sương mù bao phủ, nhiệt độ 14 – 22°C</td>
                                                </tr>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Giống hạt:</td>
                                                    <td>Arabica Bourbon (Yellow &amp; Red) và Catimor thuần</td>
                                                </tr>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Chu kỳ sinh trưởng:</td>
                                                    <td>8 – 9 tháng tích lũy dưỡng chất chậm trong sương mù</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-white fw-semibold">Điểm SCA Cupping:</td>
                                                    <td><strong class="text-warning">86.75 SCA Points</strong> (Specialty Grade)</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============================================================= -->
                <!-- 4. KHẢO SÁT THỔ NHƯỠNG VI KHÍ HẬU (TERROIR DEEP DIVE)          -->
                <!-- ============================================================= -->
                <t t-call="innokafe_website.s_innokafe_terroir_deepdive"/>

                <!-- ============================================================= -->
                <!-- 5. BA PHƯƠNG PHÁP SƠ CHẾ NÔNG HỌC CHUYÊN SÂU                  -->
                <!-- ============================================================= -->
                <section class="s_three_columns o_colored_level o_cc o_cc5 pt80 pb80 border-top border-secondary border-opacity-25" data-snippet="s_three_columns" data-name="Processing Methods 3 Pillars">
                    <div class="container">
                        <div class="text-center mb-5">
                            <div class="inno-pill-badge mb-3">
                                <span>KHOA HỌC SƠ CHẾ // PROCESSING RIGOR</span>
                            </div>
                            <h2 class="display-5 fw-bold text-white mb-3">
                                3 Phương Pháp Sơ Chế Chuyên Sâu Định Hình Hương Vị
                            </h2>
                            <p class="lead text-secondary mx-auto col-lg-8">
                                Phương pháp sơ chế quyết định 60% hồ sơ vị giác của hạt cà phê. InnoKafe thực hiện quy trình sơ chế khép kín, minh bạch tuyệt đối trên từng mẻ hạt.
                            </p>
                        </div>

                        <div class="row g-4 ins-card-row-balanced">
                            <!-- Process 1: Natural -->
                            <div class="col-lg-4">
                                <div class="inno-spatial-layer inno-floating-pod h-100 rounded-4 p-4 text-white d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="inno-badge-pill-dark font-monospace text-warning">NATURAL PROCESS</span>
                                            <span class="text-secondary small font-monospace">PHƠI GIÀN 28 NGÀY</span>
                                        </div>
                                        <h3 class="h4 fw-bold text-white mb-2 inno-card-title-balance">
                                             Chế Biến Khô Tự Nhiên (Dry Natural)
                                        </h3>
                                        <p class="text-secondary small mb-3 inno-card-desc-balance">
                                            Quả cà phê chín mọng được tuyển nổi, rải đều trên giàn lưới đa tầng trong nhà màng năng lượng mặt trời. Quá trình phơi chậm kéo dài 25 – 30 ngày với tần suất đảo hạt mỗi 2 giờ giúp đường fructose tự nhiên từ cùi thẩm thấu ngược vào nhân.
                                        </p>
                                        <div class="p-3 rounded-3 inno-inner-panel mb-3">
                                            <div class="fw-semibold text-warning small mb-1">Nốt Hương Vị Đặc Trưng:</div>
                                            <div class="text-secondary small">Thể chất dày dặn, rượu vang lên men ngọt ngào, xoài sấy dẻo, mít mật, sô-cô-la đen nguyên bản 85%.</div>
                                        </div>
                                    </div>
                                    <div class="pt-3 border-top mt-auto" style="border-color: rgba(255, 255, 255, 0.06) !important;">
                                        <span class="small text-secondary">Phù hợp: <strong class="text-white">Fine Robusta Đắk Lắk · Phin &amp; Espresso</strong></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Process 2: Honey -->
                            <div class="col-lg-4">
                                <div class="inno-spatial-layer inno-floating-pod h-100 rounded-4 p-4 text-white d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="inno-badge-liquid font-monospace">HONEY PROCESS</span>
                                            <span class="text-secondary small font-monospace">GIỮ LỚP NHẦY ĐƯỜNG</span>
                                        </div>
                                        <h3 class="h4 fw-bold text-white mb-2 inno-card-title-balance">
                                            Bán Ướt Mật Ong (Red &amp; Yellow Honey)
                                        </h3>
                                        <p class="text-secondary small mb-3 inno-card-desc-balance">
                                            Tách vỏ thịt quả nhưng giữ nguyên 50% – 100% lớp chất nhầy đường (mucilage) bao quanh hạt thóc. Lớp nhầy caramel hóa tự nhiên dưới ánh nắng trong 15 – 20 ngày, tạo nên sự cân bằng tuyệt hảo giữa vị ngọt mượt và độ chua thanh.
                                        </p>
                                        <div class="p-3 rounded-3 inno-inner-panel mb-3">
                                            <div class="fw-semibold text-warning small mb-1">Nốt Hương Vị Đặc Trưng:</div>
                                            <div class="text-secondary small">Vị ngọt kem bơ sánh quyện (creamy), mật ong hoa rừng, caramel bơ hạt, táo đỏ, êm dịu trên vòm miệng.</div>
                                        </div>
                                    </div>
                                    <div class="pt-3 border-top mt-auto" style="border-color: rgba(255, 255, 255, 0.06) !important;">
                                        <span class="small text-secondary">Phù hợp: <strong class="text-white">Signature Blend · Pour-over &amp; Phin Hiện Đại</strong></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Process 3: Washed -->
                            <div class="col-lg-4">
                                <div class="inno-spatial-layer inno-floating-pod h-100 rounded-4 p-4 text-white d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="inno-badge-pill-dark font-monospace text-info">WASHED PROCESS</span>
                                            <span class="text-secondary small font-monospace">LÊN MEN KIỂM SOÁT</span>
                                        </div>
                                        <h3 class="h4 fw-bold text-white mb-2 inno-card-title-balance">
                                            Ướt Lên Men Kiểm Soát (Fully Washed)
