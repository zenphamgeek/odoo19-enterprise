                <!-- 2. VÙNG TRỒNG ĐẮK LẮK: THỦ PHỦ ROBUSTA THẾ GIỚI               -->
                <!-- ============================================================= -->
                <section id="terroir" class="s_text_image o_colored_level o_cc o_cc5 pt80 pb80 border-top border-secondary border-opacity-25" data-snippet="s_text_image" data-name="Đắk Lắk Robusta Terroir">
                    <div class="container">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-6">
                                <div class="inno-pill-badge mb-3">
                                    <span>THỦ PHỦ ROBUSTA THẾ GIỚI // ĐẮK LẮK</span>
                                </div>
                                <h2 class="display-5 fw-bold text-white mb-3">
                                    Đất Đỏ Bazan Cư M'gar &amp; Bản Sắc <span class="inno-amber-text">Robusta Sẻ</span>
                                </h2>
                                <p class="text-secondary mb-3 lh-base">
                                    Nằm tại độ cao <strong class="text-white">500 – 800m</strong> so với mực nước biển, huyện Cư M'gar và Buôn Ma Thuột sở hữu dải đất đỏ bazan cổ hình thành từ dung nham núi lửa phun trào kỷ Neogen. Tầng đất tơi xốp sâu trên 70cm giàu khoáng oxit sắt và nhôm, kết hợp cùng 2.400 – 2.600 giờ nắng mỗi năm và biên độ nhiệt ngày đêm 10 – 14°C, tạo nên môi trường hoàn hảo để trái cà phê cô đọng lượng đường fructose tự nhiên đậm đặc.
                                </p>
                                <p class="text-secondary mb-4 lh-base">
                                    InnoKafe bảo tồn giống <strong class="text-white">Robusta Sẻ thuần chủng</strong> — hạt nhỏ thon gọn nhưng kết cấu tế bào đanh chắc, mật độ chất rắn hòa tan vượt trội so với giống cao sản lai ghép. Từng chùm quả được nông dân thu hái tỉa bằng tay với tỷ lệ quả chín đạt trên 95%, triệt tiêu hoàn toàn vị chát của hạt non.
                                </p>
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <div class="p-3 rounded-3 inno-inner-panel">
                                            <div class="fw-bold inno-amber-text mb-1">Hồ Sơ Vị Giác (Fine Robusta)</div>
                                            <div class="text-secondary small">Thể chất đầm dày (Heavy body), sô-cô-la đen 85%, hạt dẻ nướng, caramel khói và hậu vị ngọt sâu lắng kéo dài.</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-3 rounded-3 inno-inner-panel">
                                            <div class="fw-bold inno-amber-text mb-1">Quy Chuẩn Canh Tác</div>
                                            <div class="text-secondary small">Hái chọn lọc 100% bằng tay, phơi giàn lưới cách mặt đất 80cm trong nhà kính, kiểm soát độ ẩm đạt chuẩn 11.5% - 12.0%.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="inno-craft-card rounded-4 p-4 text-white">
                                    <div class="border-bottom border-secondary border-opacity-15 pb-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="fw-bold mb-0 text-white">Đặc Tả Thổ Nhưỡng Đắk Lắk</h5>
                                            <span class="badge bg-warning text-dark font-monospace fw-bold">TERROIR SPEC</span>
                                        </div>
                                    </div>
                                    <div class="pt-3">
                                        <table class="table table-dark table-borderless text-secondary small mb-0">
                                            <tbody>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Địa danh:</td>
                                                    <td>Xã Cư Suê, Huyện Cư M'gar &amp; TP. Buôn Ma Thuột</td>
                                                </tr>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Độ cao:</td>
                                                    <td>500 – 800m so với mực nước biển (masl)</td>
                                                </tr>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Thổ nhưỡng:</td>
                                                    <td>Đất đỏ bazan núi lửa cổ (Fersiallitic Rhodic Ferralsols)</td>
                                                </tr>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Giống hạt:</td>
                                                    <td>Coffea canephora var. Robusta Sẻ thuần chủng</td>
                                                </tr>
                                                <tr class="border-bottom border-secondary border-opacity-10">
                                                    <td class="text-white fw-semibold">Phương pháp hái:</td>
                                                    <td>Thu hái thủ công chọn lọc quả chín đỏ (&gt;= 95%)</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-white fw-semibold">Điểm SCA Cupping:</td>
                                                    <td><strong class="text-warning">84.50 SCA Points</strong> (Fine Robusta)</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
