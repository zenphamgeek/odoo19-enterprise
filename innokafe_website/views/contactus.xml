<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="contactus_page" name="Contact Us — Kết Nối Cùng Innokafe">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty"/>

            <!-- =============================================================== -->
            <!-- HERO BANNER                                                     -->
            <!-- =============================================================== -->
            <section class="s_innokafe_contact_hero o_colored_level o_cc o_cc5 py-5 text-center text-light position-relative"
                     data-snippet="s_innokafe_contact_hero"
                     data-name="Contact Hero"
                     style="background: linear-gradient(180deg, #120A06 0%, #1E120B 100%); border-bottom: 1px solid rgba(212, 136, 66, 0.2);">
                <div class="container py-4">
                    <span class="badge rounded-pill px-3 py-2 mb-3 text-uppercase fw-bold"
                          style="background-color: rgba(212, 136, 66, 0.15); color: #D48842; border: 1px solid rgba(212, 136, 66, 0.35); font-size: 0.8rem; letter-spacing: 0.08em;">
                        Không Gian Trải Nghiệm &amp; Thử Nếm
                    </span>
                    <h1 class="display-4 fw-bold mb-3 text-light" style="font-family: 'Playfair Display', serif; text-wrap: balance;">
                        Kết Nối Cùng Innokafe Roastery
                    </h1>
                    <p class="lead mx-auto mb-0" style="max-width: 780px; color: #D1C5B4; line-height: 1.7; text-wrap: balance;">
                        Ghé thăm Showroom &amp; Tasting Bar tại TP.HCM, tham quan Roastery Lab tại Đắk Lắk hoặc đặt lịch cupping tại trạm nông trại Cầu Đất.
                        Đội ngũ chuyên gia của chúng tôi luôn sẵn sàng lắng nghe và đồng hành cùng bạn.
                    </p>
                </div>
            </section>

            <!-- =============================================================== -->
            <!-- ROASTERY & SHOWROOM LOCATIONS                                  -->
            <!-- =============================================================== -->
            <section class="s_innokafe_contact_locations o_colored_level o_cc o_cc5 py-5 text-light"
                     data-snippet="s_innokafe_contact_locations"
                     data-name="Contact Locations"
                     style="background-color: #1E120B;">
                <div class="container py-2">
                    <div class="row g-4 ins-card-row-balanced text-start">
                        <!-- LOCATION 1: HCM SHOWROOM -->
                        <div class="col-lg-4 col-md-6">
                            <div class="card h-100 p-4 rounded-4 border d-flex flex-column justify-content-between"
                                 style="background-color: #2C1810; border-color: rgba(212, 136, 66, 0.35) !important;">
                                <div>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle p-2 me-2" style="background: rgba(212,136,66,0.2); color: #D48842; font-size: 1.3rem;">
                                            ☕
                                        </div>
                                        <span class="badge rounded-pill px-3 py-1 text-uppercase fw-bold" style="background: #D48842; color: #1E120B !important;">
                                            Showroom &amp; Tasting Bar
                                        </span>
                                    </div>
                                    <h3 class="h4 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                        Innokafe Flagship TP.HCM
                                    </h3>
                                    <p class="small mb-3" style="color: #FAF6F0;">
                                        Không gian trưng bày máy pha cao cấp, quầy bar trải nghiệm Specialty Coffee và trung tâm dịch vụ khách hàng miền Nam.
                                    </p>
                                    <ul class="list-unstyled small mb-3" style="color: #D1C5B4; line-height: 1.8;">
                                        <li>📍 <strong>Địa chỉ:</strong> Tòa nhà Insilos Center, TP. Thủ Đức, TP. Hồ Chí Minh</li>
                                        <li>⏰ <strong>Giờ mở cửa:</strong> 07:30 – 21:00 (Thứ 2 – Chủ Nhật)</li>
                                        <li>📞 <strong>Hotline:</strong> 028 7300 6688 / 0909 123 456</li>
                                        <li>✉️ <strong>Email:</strong> hello@innokafe.insilos.com</li>
                                    </ul>
                                </div>
                                <a href="tel:02873006688" class="btn btn-outline-warning rounded-pill w-100 small" style="color: #D48842; border-color: #D48842;">
                                    Gọi đặt lịch Tasting →
                                </a>
                            </div>
                        </div>

                        <!-- LOCATION 2: DAK LAK ROASTERY -->
                        <div class="col-lg-4 col-md-6">
                            <div class="card h-100 p-4 rounded-4 border d-flex flex-column justify-content-between"
                                 style="background-color: #2C1810; border-color: rgba(212, 136, 66, 0.35) !important;">
                                <div>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle p-2 me-2" style="background: rgba(212,136,66,0.2); color: #D48842; font-size: 1.3rem;">
                                            🏭
                                        </div>
                                        <span class="badge rounded-pill px-3 py-1 text-uppercase fw-bold" style="background: rgba(212,136,66,0.2); color: #E5A93C;">
                                            Xưởng Rang &amp; Cupping Lab
                                        </span>
                                    </div>
                                    <h3 class="h4 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                        Innokafe Roastery Đắk Lắk
                                    </h3>
                                    <p class="small mb-3" style="color: #FAF6F0;">
                                        Trái tim sản xuất của Innokafe: Nhà xưởng rang Hot-Air Châu Âu, phòng kiểm thử chất lượng Q-Grader và kho bảo quản nguyên liệu.
                                    </p>
                                    <ul class="list-unstyled small mb-3" style="color: #D1C5B4; line-height: 1.8;">
                                        <li>📍 <strong>Địa chỉ:</strong> Km 12, Quốc lộ 14, Huyện Cư M'gar, Tỉnh Đắk Lắk</li>
                                        <li>⏰ <strong>Giờ làm việc:</strong> 08:00 – 17:30 (Thứ 2 – Thứ 7)</li>
                                        <li>📞 <strong>Hotline xưởng:</strong> 0262 388 9988</li>
                                        <li>✉️ <strong>Email:</strong> roastery@innokafe.insilos.com</li>
                                    </ul>
                                </div>
                                <a href="#contact_form" class="btn btn-outline-light rounded-pill w-100 small">
                                    Đăng ký tham quan xưởng →
                                </a>
                            </div>
                        </div>

                        <!-- LOCATION 3: CAU DAT FARM STATION -->
                        <div class="col-lg-4 col-md-12">
                            <div class="card h-100 p-4 rounded-4 border d-flex flex-column justify-content-between"
                                 style="background-color: #2C1810; border-color: rgba(212, 136, 66, 0.35) !important;">
                                <div>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle p-2 me-2" style="background: rgba(212,136,66,0.2); color: #D48842; font-size: 1.3rem;">
                                            🌄
                                        </div>
                                        <span class="badge rounded-pill px-3 py-1 text-uppercase fw-bold" style="background: rgba(212,136,66,0.2); color: #E5A93C;">
                                            Trạm Nông Trại Núi Cao
                                        </span>
                                    </div>
                                    <h3 class="h4 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                        Cầu Đất Farm Station
                                    </h3>
                                    <p class="small mb-3" style="color: #FAF6F0;">
                                        Độ cao 1.620m giữa ngàn thông Cầu Đất: Giàn phơi sơ chế Natural &amp; Honey, vườn cây Arabica Bourbon cổ và không gian trải nghiệm Farm-to-Cup.
                                    </p>
                                    <ul class="list-unstyled small mb-3" style="color: #D1C5B4; line-height: 1.8;">
                                        <li>📍 <strong>Địa chỉ:</strong> Thôn Trạm Hành, Xã Xuân Trường, TP. Đà Lạt, Tỉnh Lâm Đồng</li>
                                        <li>⏰ <strong>Giờ mở cửa:</strong> 07:00 – 17:00 (Mở cửa hàng ngày)</li>
                                        <li>📞 <strong>Hotline nông trại:</strong> 0263 355 6677</li>
                                        <li>✉️ <strong>Email:</strong> farm@innokafe.insilos.com</li>
                                    </ul>
                                </div>
                                <a href="#contact_form" class="btn btn-outline-light rounded-pill w-100 small">
                                    Đặt tour trải nghiệm farm →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =============================================================== -->
            <!-- CONTACT FORM SECTION                                            -->
            <!-- =============================================================== -->
            <section id="contact_form" class="s_innokafe_contact_form o_colored_level o_cc o_cc5 py-5 text-light"
                     data-snippet="s_innokafe_contact_form"
                     data-name="Contact Form"
                     style="background-color: #120A06; border-top: 1px solid rgba(212, 136, 66, 0.15);">
                <div class="container py-3">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card rounded-4 p-4 p-lg-5 border"
                                 style="background-color: #23130C; border-color: rgba(212, 136, 66, 0.35) !important;">
                                
                                <div class="text-center mb-4">
                                    <span class="badge rounded-pill px-3 py-1 mb-2 text-uppercase fw-bold"
                                          style="background: rgba(212,136,66,0.2); color: #E5A93C;">
                                        Gửi Lời Nhắn Trực Tiếp
                                    </span>
                                    <h2 class="h3 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                        Chúng Tôi Rất Hân Hạnh Được Lắng Nghe Bạn
                                    </h2>
                                    <p style="color: #D1C5B4;" class="small">
                                        Điền thông tin vào biểu mẫu dưới đây, đội ngũ chăm sóc khách hàng hoặc chuyên gia cà phê sẽ phản hồi trong vòng 2 giờ làm việc.
                                    </p>
                                </div>

                                <!-- SUCCESS FLASH MESSAGE -->
                                <t t-if="submitted">
                                    <div class="alert alert-success rounded-3 mb-4 p-4 text-center border-0"
                                         style="background-color: rgba(45, 71, 57, 0.85); color: #FAF6F0; border: 1px solid #2D4739 !important;">
                                        <h4 class="h5 fw-bold mb-2">🎉 Gửi Tin Nhắn Thành Công!</h4>
                                        <p class="mb-0 small">
                                            Cảm ơn bạn đã liên hệ cùng Innokafe. Chúng tôi đã nhận được thông tin và sẽ phản hồi sớm nhất qua số điện thoại hoặc email bạn cung cấp.
                                        </p>
                                    </div>
                                </t>

                                <form action="/contactus/submit" method="post" class="row g-3">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-light">Họ và tên của bạn *</label>
                                        <input type="text" name="contact_name" class="form-control rounded-3" required="required"
                                               placeholder="Trần Thu Hương"
                                               style="background-color: #1E120B; border-color: rgba(212, 136, 66, 0.3); color: #FAF6F0;"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-light">Số điện thoại liên hệ *</label>
                                        <input type="tel" name="phone" class="form-control rounded-3" required="required"
                                               placeholder="0987 654 321"
                                               style="background-color: #1E120B; border-color: rgba(212, 136, 66, 0.3); color: #FAF6F0;"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-light">Địa chỉ email *</label>
                                        <input type="email" name="email_from" class="form-control rounded-3" required="required"
                                               placeholder="thuhuong@example.com"
                                               style="background-color: #1E120B; border-color: rgba(212, 136, 66, 0.3); color: #FAF6F0;"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-light">Chủ đề liên hệ</label>
                                        <select name="subject" class="form-select rounded-3"
                                                style="background-color: #1E120B; border-color: rgba(212, 136, 66, 0.3); color: #FAF6F0;">
                                            <option value="Đặt lịch thử nếm tại Tasting Bar TP.HCM">Đặt lịch thử nếm tại Tasting Bar TP.HCM</option>
                                            <option value="Tham quan xưởng rang Roastery Đắk Lắk">Tham quan xưởng rang Roastery Đắk Lắk</option>
                                            <option value="Đặt tour trải nghiệm nông trại Cầu Đất">Đặt tour trải nghiệm nông trại Cầu Đất</option>
                                            <option value="Đặt hàng quà tặng doanh nghiệp Specialty">Đặt hàng quà tặng doanh nghiệp Specialty</option>
                                            <option value="Hợp tác nhượng quyền / Phân phối">Hợp tác nhượng quyền / Phân phối</option>
                                            <option value="Khác">Câu hỏi hoặc góp ý khác</option>
                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-light">Nội dung tin nhắn *</label>
                                        <textarea name="message" rows="4" class="form-control rounded-3" required="required"
                                                  placeholder="Hãy chia sẻ điều bạn muốn trò chuyện hoặc kế hoạch ghé thăm của bạn..."
                                                  style="background-color: #1E120B; border-color: rgba(212, 136, 66, 0.3); color: #FAF6F0;"/>
                                    </div>

                                    <div class="col-12 text-center mt-4">
                                        <button type="submit"
                                                class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg"
                                                style="background: linear-gradient(135deg, #E5A93C, #D48842); color: #1E120B !important; border: none; font-size: 1rem;">
                                            Gửi Lời Nhắn Đến Innokafe ✉️
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div id="oe_structure_bottom" class="oe_structure oe_empty"/>
        </t>
    </template>
</odoo>
