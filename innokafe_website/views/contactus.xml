<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="contactus_page" name="Contact Us — Kết Nối Cùng Innokafe">
        <t t-call="website.layout" logged_partner="env['ir.http']._get_visitor_from_request().partner_id">
            <t t-set="contactus_form_values" t-value="{'email_to': res_company.email}"/>
            <div id="wrap" class="oe_structure oe_empty inno-espresso-bg">

            <!-- =============================================================== -->
            <!-- HERO BANNER                                                     -->
            <!-- =============================================================== -->
            <section class="s_innokafe_contact_hero o_colored_level o_cc o_cc5 py-5 text-center text-light position-relative inno-espresso-bg"
                     data-snippet="s_innokafe_contact_hero"
                     data-name="Contact Hero">
                <div class="container py-4">
                    <div class="inno-pill-badge mb-3">
                        <span>KHÔNG GIAN TRẢI NGHIỆM &amp; THỬ NẾM</span>
                    </div>
                    <h1 class="display-4 fw-bold mb-3 text-light" style="font-family: 'Playfair Display', serif; text-wrap: balance;">
                        Kết Nối Cùng Innokafe Roastery
                    </h1>
                    <p class="lead mx-auto mb-0" style="max-width: 780px; color: rgba(247, 242, 234, 0.8); line-height: 1.7; text-wrap: balance;">
                        Ghé thăm Showroom &amp; Tasting Bar tại TP.HCM, tham quan Roastery Lab tại Đắk Lắk hoặc đặt lịch cupping tại trạm nông trại Cầu Đất.
                        Đội ngũ nghệ nhân và Q-Grader của chúng tôi luôn sẵn sàng đón tiếp và chia sẻ câu chuyện hạt mộc.
                    </p>
                </div>
            </section>

            <!-- =============================================================== -->
            <!-- ROASTERY & SHOWROOM LOCATIONS                                  -->
            <!-- =============================================================== -->
            <section class="s_innokafe_contact_locations o_colored_level o_cc o_cc5 py-5 text-light inno-espresso-bg"
                     data-snippet="s_innokafe_contact_locations"
                     data-name="Contact Locations">
                <div class="container py-2">
                    <div class="row g-4 ins-card-row-balanced text-start">
                        <!-- LOCATION 1: HCM SHOWROOM -->
                        <div class="col-lg-4 col-md-6">
                            <div class="inno-spatial-layer inno-floating-pod h-100 p-4 p-md-5 rounded-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="background: rgba(212, 136, 66, 0.2); color: #D48842; width: 40px; height: 40px; font-size: 1.2rem;">
                                            ☕
                                        </div>
                                        <span class="inno-badge-pill-dark font-monospace">
                                            SHOWROOM &amp; TASTING BAR
                                        </span>
                                    </div>
                                    <h3 class="h4 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                        Innokafe Flagship TP.HCM
                                    </h3>
                                    <p class="small mb-3" style="color: rgba(247, 242, 234, 0.85);">
                                        Không gian trưng bày máy pha cao cấp, quầy bar trải nghiệm Specialty Coffee và trung tâm dịch vụ khách hàng miền Nam.
                                    </p>
                                    <ul class="list-unstyled small mb-4" style="color: rgba(247, 242, 234, 0.75); line-height: 1.8;">
                                        <li>📍 <strong class="text-white">Địa chỉ:</strong> Tòa nhà Insilos Center, TP. Thủ Đức, TP. Hồ Chí Minh</li>
                                        <li>⏰ <strong class="text-white">Giờ mở cửa:</strong> 07:30 – 21:00 (Thứ 2 – Chủ Nhật)</li>
                                        <li>📞 <strong class="text-white">Hotline:</strong> 028 7300 6688 / 0909 123 456</li>
                                        <li>✉️ <strong class="text-white">Email:</strong> hello@innokafe.insilos.com</li>
                                    </ul>
                                </div>
                                <a href="tel:02873006688" class="btn btn-outline-light rounded-pill w-100 small">
                                    Gọi đặt lịch Tasting →
                                </a>
                            </div>
                        </div>

                        <!-- LOCATION 2: DAK LAK ROASTERY -->
                        <div class="col-lg-4 col-md-6">
                            <div class="inno-spatial-layer inno-floating-pod h-100 p-4 p-md-5 rounded-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="background: rgba(212, 136, 66, 0.2); color: #D48842; width: 40px; height: 40px; font-size: 1.2rem;">
                                            🏭
                                        </div>
                                        <span class="inno-badge-pill-dark font-monospace">
                                            XƯỞNG RANG &amp; CUPPING LAB
                                        </span>
                                    </div>
                                    <h3 class="h4 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                        Innokafe Roastery Đắk Lắk
                                    </h3>
                                    <p class="small mb-3" style="color: rgba(247, 242, 234, 0.85);">
                                        Trái tim sản xuất của Innokafe: Nhà xưởng rang Hot-Air Châu Âu, phòng kiểm định chất lượng chuẩn SCA và kho bảo quản mộc.
                                    </p>
                                    <ul class="list-unstyled small mb-4" style="color: rgba(247, 242, 234, 0.75); line-height: 1.8;">
                                        <li>📍 <strong class="text-white">Địa chỉ:</strong> Km 12, Quốc lộ 14, Huyện Cư M'gar, Tỉnh Đắk Lắk</li>
                                        <li>⏰ <strong class="text-white">Giờ làm việc:</strong> 08:00 – 17:30 (Thứ 2 – Thứ 7)</li>
                                        <li>📞 <strong class="text-white">Hotline xưởng:</strong> 0262 388 9988</li>
                                        <li>✉️ <strong class="text-white">Email:</strong> roastery@innokafe.insilos.com</li>
                                    </ul>
                                </div>
                                <a href="#contact_form" class="btn btn-outline-light rounded-pill w-100 small">
                                    Đăng ký tham quan xưởng →
                                </a>
                            </div>
                        </div>

                        <!-- LOCATION 3: CAU DAT FARM STATION -->
                        <div class="col-lg-4 col-md-12">
                            <div class="inno-spatial-layer inno-floating-pod h-100 p-4 p-md-5 rounded-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="background: rgba(212, 136, 66, 0.2); color: #D48842; width: 40px; height: 40px; font-size: 1.2rem;">
                                            🌄
                                        </div>
                                        <span class="inno-badge-pill-dark font-monospace">
                                            TRẠM NÔNG TRẠI NÚI CAO
                                        </span>
                                    </div>
                                    <h3 class="h4 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                        Cầu Đất Farm Station
                                    </h3>
                                    <p class="small mb-3" style="color: rgba(247, 242, 234, 0.85);">
                                        Độ cao 1.620m giữa ngàn thông Cầu Đất: Giàn phơi sơ chế Natural &amp; Honey, vườn cây Arabica Bourbon cổ và không gian trải nghiệm Farm-to-Cup.
                                    </p>
                                    <ul class="list-unstyled small mb-4" style="color: rgba(247, 242, 234, 0.75); line-height: 1.8;">
                                        <li>📍 <strong class="text-white">Địa chỉ:</strong> Thôn Trạm Hành, Xã Xuân Trường, TP. Đà Lạt, Tỉnh Lâm Đồng</li>
                                        <li>⏰ <strong class="text-white">Giờ mở cửa:</strong> 07:00 – 17:00 (Mở cửa hàng ngày)</li>
                                        <li>📞 <strong class="text-white">Hotline nông trại:</strong> 0263 355 6677</li>
                                        <li>✉️ <strong class="text-white">Email:</strong> farm@innokafe.insilos.com</li>
                                    </ul>
                                </div>
                                <a href="#contact_form" class="btn btn-outline-light rounded-pill w-100 small">
                                    Đặt tour trải nghiệm farm →
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =============================================================== -->
            <!-- CONTACT FORM SECTION                                            -->
            <!-- =============================================================== -->
            <section id="contact_form" class="s_innokafe_contact_form o_colored_level o_cc o_cc5 py-5 text-light inno-espresso-bg border-top border-secondary border-opacity-15"
                     data-snippet="s_innokafe_contact_form"
                     data-name="Contact Form">
                <div class="container py-3">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="inno-spatial-layer rounded-4 p-4 p-lg-5">
                                
                                <div class="text-center mb-4">
                                    <div class="inno-pill-badge mb-2">
                                        <span>GỬI LỜI NHẮN TRỰC TIẾP</span>
                                    </div>
                                    <h2 class="h3 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                        Chúng Tôi Rất Hân Hạnh Được Lắng Nghe Bạn
                                    </h2>
                                    <p style="color: rgba(247, 242, 234, 0.8);" class="small">
                                        Điền thông tin vào biểu mẫu dưới đây, đội ngũ chăm sóc khách hàng hoặc chuyên gia cà phê sẽ phản hồi trong vòng 2 giờ làm việc.
                                    </p>
                                </div>

                                <!-- SUCCESS FLASH MESSAGE -->
                                <t t-if="submitted">
                                    <div class="alert alert-success inno-inner-panel rounded-3 mb-4 p-4 text-center border-0"
                                         style="color: #FAF6F0; border: 1px solid rgba(45, 71, 57, 0.8) !important;">
                                        <h4 class="h5 fw-bold mb-2">🎉 Gửi Tin Nhắn Thành Công!</h4>
                                        <p class="mb-0 small">
                                            Cảm ơn bạn đã liên hệ cùng Innokafe. Chúng tôi đã nhận được thông tin và sẽ phản hồi sớm nhất qua số điện thoại hoặc email bạn cung cấp.
                                        </p>
                                    </div>
                                </t>

                                <form action="/contactus/submit" method="post" class="row g-3">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-light">Họ và tên của bạn *</label>
                                        <input type="text" name="contact_name" class="form-control inno-inner-panel text-white rounded-3" required="required"
                                               placeholder="Trần Thu Hương"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-light">Số điện thoại liên hệ *</label>
                                        <input type="tel" name="phone" class="form-control inno-inner-panel text-white rounded-3" required="required"
                                               placeholder="0987 654 321"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-light">Địa chỉ email *</label>
                                        <input type="email" name="email_from" class="form-control inno-inner-panel text-white rounded-3" required="required"
                                               placeholder="thuhuong@example.com"/>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-light">Chủ đề liên hệ</label>
                                        <select name="subject" class="form-select inno-inner-panel text-white rounded-3">
                                            <option value="Đặt lịch thử nếm tại Tasting Bar TP.HCM">Đặt lịch thử nếm tại Tasting Bar TP.HCM</option>
                                            <option value="Tham quan xưởng rang Roastery Đắk Lắk">Tham quan xưởng rang Roastery Đắk Lắk</option>
                                            <option value="Đặt tour trải nghiệm nông trại Cầu Đất">Đặt tour trải nghiệm nông trại Cầu Đất</option>
                                            <option value="Đặt hàng quà tặng doanh nghiệp Specialty">Đặt hàng quà tặng doanh nghiệp Specialty</option>
                                            <option value="Hợp tác nhượng quyền / Phân phối">Hợp tác nhượng quyền / Phân phối</option>
                                            <option value="Khác">Câu hỏi hoặc góp ý khác</option>
                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label small fw-bold text-light">Nội dung tin nhắn *</label>
                                        <textarea name="message" rows="4" class="form-control inno-inner-panel text-white rounded-3" required="required"
                                                  placeholder="Hãy chia sẻ điều bạn muốn trò chuyện hoặc kế hoạch ghé thăm của bạn..."/>
                                    </div>

                                    <div class="col-12 text-center mt-4">
                                        <button type="submit"
                                                class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg">
                                            Gửi Lời Nhắn Đến Innokafe ✉️
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            </div>
        </t>
    </template>
</odoo>
