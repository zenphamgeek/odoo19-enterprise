<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="taste_profiler_page" name="Taste Profiler, Tìm Gu Cà Phê Của Bạn">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty"/>

            <!-- =============================================================== -->
            <!-- HERO BANNER                                                     -->
            <!-- =============================================================== -->
            <section class="s_innokafe_profiler_hero o_colored_level o_cc o_cc5 py-5 text-center text-light position-relative inno-espresso-bg inno-cardless--bordered-bottom"
                     data-snippet="s_innokafe_profiler_hero"
                     data-name="Profiler Hero">
                <div class="container py-4">
                    <p class="text-uppercase tracking-widest text-warning small font-monospace mb-2">CÁ NHÂN HÓA TRẢI NGHIỆM THƯỞNG THỨC</p>
                    <h1 class="display-4 fw-bold mb-3 text-light" style="font-family: 'Playfair Display', serif; text-wrap: balance;">
                        Tìm Gu Cà Phê Của Bạn
                    </h1>
                    <p class="lead mx-auto mb-0" style="max-width: 760px; color: rgba(247, 242, 234, 0.8); line-height: 1.7; text-wrap: balance;">
                        Mỗi người sở hữu một bản đồ vị giác độc nhất. Chỉ 60 giây với 4 câu hỏi trắc nghiệm cảm quan,
                        Innokafe sẽ gợi ý chính xác dòng hạt rang mộc sinh ra để dành riêng cho khẩu vị của bạn.
                    </p>
                </div>
            </section>

            <!-- =============================================================== -->
            <!-- QUIZ CONTAINER & INTERACTIVE STATE MACHINE                      -->
            <!-- =============================================================== -->
            <section class="s_innokafe_profiler_interactive o_colored_level o_cc o_cc5 py-5 inno-espresso-bg"
                     data-snippet="s_innokafe_profiler_interactive"
                     data-name="Taste Profiler Interactive"
                     style="min-height: 700px;">
                <div class="container profiler-quiz-container">
                    <!-- Embedded JSON Data for Client Engine -->
                    <script id="innokafe-skus-data" type="application/json" t-out="skus_json"/>

                    <div class="innokafe-profiler-root mx-auto" style="max-width: 920px;">
                        <!-- Progress Header -->
                        <div class="d-flex align-items-center justify-content-between mb-3 text-light">
                            <span class="profiler-progress-text fw-bold text-uppercase" style="color: #D48842; font-size: 0.85rem; letter-spacing: 0.05em;">
                                Bước 1 / 4
                            </span>
                            <span class="small" style="color: rgba(247, 242, 234, 0.7);">
                                Trắc nghiệm cảm quan khẩu vị chuẩn SCA
                            </span>
                        </div>
                        <div class="progress mb-5" style="height: 6px; background-color: rgba(247, 242, 234, 0.12); border-radius: 999px;">
                            <div class="progress-bar profiler-progress-bar"
                                 role="progressbar"
                                 style="width: 25%; background: linear-gradient(90deg, #E5A93C, #D48842); transition: width 0.4s ease; border-radius: 999px;"/>
                        </div>

                        <!-- =================================================== -->
                        <!-- STEP 1: ROUTINE & VIBE                              -->
                        <!-- =================================================== -->
                        <div class="profiler-step-content" data-step-panel="1">
                            <div class="text-center mb-4">
                                <h2 class="h3 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                    Khoảnh khắc cà phê lý tưởng trong ngày của bạn?
                                </h2>
                                <p style="color: rgba(247, 242, 234, 0.75);">Chọn phong cách thưởng thức phản ánh đúng thói quen của bạn nhất.</p>
                            </div>

                            <div class="row g-3 ins-card-row-balanced">
                                <div class="col-md-6">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="1" data-key="habit" data-value="phin_dam">
                                        <div class="d-flex align-items-start">
                                            <div class="rounded-circle p-3 me-3 flex-shrink-0 d-inline-flex align-items-center justify-content-center" style="background-color: rgba(212, 136, 66, 0.15); color: #D48842; font-size: 1.5rem; width: 54px; height: 54px;">
                                                <i class="fa fa-coffee text-warning"/>
                                            </div>
                                            <div>
                                                <h4 class="h5 fw-bold text-light mb-1">Cú Hích Buổi Sáng, Đậm Đà Bừng Tỉnh</h4>
                                                <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                                    Một ly cà phê đen sánh đậm hoặc nâu đá truyền thống, đượm vị đắng ngọt socola, nạp đầy năng lượng tỉnh táo tức thì.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="1" data-key="habit" data-value="sua_da">
                                        <div class="d-flex align-items-start">
                                            <div class="rounded-circle p-3 me-3 flex-shrink-0 d-inline-flex align-items-center justify-content-center" style="background-color: rgba(212, 136, 66, 0.15); color: #D48842; font-size: 1.5rem; width: 54px; height: 54px;">
                                                <i class="fa fa-glass text-warning"/>
                                            </div>
                                            <div>
                                                <h4 class="h5 fw-bold text-light mb-1">Ngọt Ngào Êm Ái, Cà Phê Sữa Đá Sành Điệu</h4>
                                                <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                                    Thích sự béo ngậy hài hòa, vị đắng sô-cô-la quyện cùng sữa đặc ngọt bùi, hậu vị êm dịu vòm họng.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="1" data-key="habit" data-value="den_thanh">
                                        <div class="d-flex align-items-start">
                                            <div class="rounded-circle p-3 me-3 flex-shrink-0 d-inline-flex align-items-center justify-content-center" style="background-color: rgba(212, 136, 66, 0.15); color: #D48842; font-size: 1.5rem; width: 54px; height: 54px;">
                                                <i class="fa fa-seedling text-warning"/>
                                            </div>
                                            <div>
                                                <h4 class="h5 fw-bold text-light mb-1">Tinh Tế &amp; Thư Thái, Cà Phê Đen Thanh Nhẹ</h4>
                                                <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                                    Nhâm nhi từng ngụm chậm rãi, thưởng lãm hương hoa quả tươi sáng, vị chua thanh tao như nước quả nhiệt đới.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="1" data-key="habit" data-value="coldbrew_sangtao">
                                        <div class="d-flex align-items-start">
                                            <div class="rounded-circle p-3 me-3 flex-shrink-0 d-inline-flex align-items-center justify-content-center" style="background-color: rgba(212, 136, 66, 0.15); color: #D48842; font-size: 1.5rem; width: 54px; height: 54px;">
                                                <i class="fa fa-snowflake text-warning"/>
                                            </div>
                                            <div>
                                                <h4 class="h5 fw-bold text-light mb-1">Hiện Đại &amp; Sảng Khoái, Giải Nhiệt Mát Lạnh</h4>
                                                <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                                    Cold Brew ủ lạnh 24 giờ mát rượi, Espresso Tonic sảng khoái ngày nắng, hương cam chanh bừng sức sống.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- =================================================== -->
                        <!-- STEP 2: BREWING GEAR                                -->
                        <!-- =================================================== -->
                        <div class="profiler-step-content d-none" data-step-panel="2">
                            <div class="text-center mb-4">
                                <h2 class="h3 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                    Bạn thường pha chế cà phê bằng thiết bị nào?
                                </h2>
                                <p style="color: rgba(247, 242, 234, 0.75);">Dụng cụ chiết xuất quyết định kích thước bột xay và độ trích ly tối ưu.</p>
                            </div>

                            <div class="row g-3 ins-card-row-balanced">
                                <div class="col-md-6">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="2" data-key="gear" data-value="phin">
                                        <h4 class="h5 fw-bold text-light mb-2">Phin Nhôm Truyền Thống</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Phương pháp chiết xuất nhỏ giọt tí tách kinh điển của người Việt, đậm đà thể chất và lớp dầu tự nhiên.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="2" data-key="gear" data-value="espresso">
                                        <h4 class="h5 fw-bold text-light mb-2">Máy Pha Espresso Gia Đình / Cầm Tay</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Chiết xuất áp suất cao 9 bar trong 25-30 giây, tạo lớp Crema dày vàng óng ả và hương thơm bung tỏa.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="2" data-key="gear" data-value="dripbag">
                                        <h4 class="h5 fw-bold text-light mb-2">Phin Giấy Túi Lọc Drip Bag</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Tiện lợi tại bàn làm việc hoặc du lịch, màng lọc Nhật Bản chiết xuất trong trẻo chỉ với một ấm nước sôi.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="2" data-key="gear" data-value="pourover">
                                        <h4 class="h5 fw-bold text-light mb-2">Bình Pour-Over V60 / French Press / Cold Brew</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Nghệ thuật pha chế thủ công tôn vinh các tầng hương hoa quả tinh vi và độ trong trẻo tuyệt hảo.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-outline-light rounded-pill px-4 btn-profiler-prev">
                                    ← Quay lại
                                </button>
                            </div>
                        </div>

                        <!-- =================================================== -->
                        <!-- STEP 3: FLAVOR NOTES                                -->
                        <!-- =================================================== -->
                        <div class="profiler-step-content d-none" data-step-panel="3">
                            <div class="text-center mb-4">
                                <h2 class="h3 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                    Nốt hương nào cuốn hút khứu giác của bạn nhất?
                                </h2>
                                <p style="color: rgba(247, 242, 234, 0.75);">Hương thơm bộc lộ qua phản ứng rang mộc tự nhiên của hạt.</p>
                            </div>

                            <div class="row g-3 ins-card-row-balanced">
                                <div class="col-md-4">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="3" data-key="flavor" data-value="nutty_choco">
                                        <div class="mb-3 fs-3"><i class="fa fa-cookie text-warning"/></div>
                                        <h4 class="h5 fw-bold text-light mb-2">Trầm Ấm &amp; Cổ Điển</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Sô-cô-la đen 85%, hạt dẻ nướng, caramel bơ đậu phộng, mật mía và gỗ sồi trầm.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="3" data-key="flavor" data-value="fruity_floral">
                                        <div class="mb-3 fs-3"><i class="fa fa-lemon text-warning"/></div>
                                        <h4 class="h5 fw-bold text-light mb-2">Tươi Sáng &amp; Sinh Động</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Hoa nhài trắng thanh khiết, cam Bergamot, táo xanh, quả mọng đào chín và trà Earl Grey.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="3" data-key="flavor" data-value="honey_balanced">
                                        <div class="mb-3 fs-3"><i class="fa fa-tint text-warning"/></div>
                                        <h4 class="h5 fw-bold text-light mb-2">Cân Bằng &amp; Ngọt Ngào</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Mật ong hoa rừng, táo đỏ, caramel kem bơ, hạnh nhân thơm bùi, hậu vị ngọt kéo dài.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-outline-light rounded-pill px-4 btn-profiler-prev">
                                    ← Quay lại
                                </button>
                            </div>
                        </div>

                        <!-- =================================================== -->
                        <!-- STEP 4: CAFFEINE INTENSITY                          -->
                        <!-- =================================================== -->
                        <div class="profiler-step-content d-none" data-step-panel="4">
                            <div class="text-center mb-4">
                                <h2 class="h3 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                    Mức độ tiếp nhận caffeine &amp; độ đậm đặc của bạn?
                                </h2>
                                <p style="color: rgba(247, 242, 234, 0.75);">Chọn mức năng lượng để cơ thể cảm thấy thoải mái và sảng khoái nhất.</p>
                            </div>

                            <div class="row g-3 ins-card-row-balanced">
                                <div class="col-md-4">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="4" data-key="caffeine" data-value="high">
                                        <h4 class="h5 fw-bold text-light mb-2">Đô Mạnh, Cần Tỉnh Táo Tuyệt Đối</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Hàm lượng caffeine tự nhiên cao của Fine Robusta Cư M'gar, thể chất dày đặc, duy trì năng lượng tập trung trọn vẹn cả ngày.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="4" data-key="caffeine" data-value="medium">
                                        <h4 class="h5 fw-bold text-light mb-2">Cân Bằng, Tỉnh Táo Êm Dịu</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            Hòa quyện tỷ lệ vàng giữa Robusta và Arabica, giải phóng năng lượng êm ái, tỉnh táo minh mẫn không hồi hộp.
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="inno-spatial-layer inno-floating-pod profiler-option-card cursor-pointer h-100 p-4 rounded-4 text-start d-flex flex-column justify-content-between"
                                         data-step="4" data-key="caffeine" data-value="low">
                                        <h4 class="h5 fw-bold text-light mb-2">Nhẹ Nhàng, Nhạy Cảm Caffeine</h4>
                                        <p class="small mb-0" style="color: rgba(247, 242, 234, 0.8);">
                                            100% Arabica núi sương Cầu Đất, hàm lượng caffeine dịu nhẹ, thưởng thức trọn vẹn hương hoa quả mà không sợ say.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-outline-light rounded-pill px-4 btn-profiler-prev">
                                    ← Quay lại
                                </button>
                            </div>
                        </div>

                        <!-- =================================================== -->
                        <!-- STEP 5: RESULT COCKPIT                              -->
                        <!-- =================================================== -->
                        <div class="profiler-result-cockpit d-none py-2">
                            <div class="text-center mb-5">
                                <p class="text-uppercase tracking-widest text-warning small font-monospace mb-2">KẾT QUẢ CẢM QUAN KHẨU VỊ</p>
                                <h2 class="display-6 fw-bold text-light mb-2" style="font-family: 'Playfair Display', serif;">
                                    Dòng Cà Phê Dành Riêng Cho Khẩu Vị Của Bạn
                                </h2>
                                <p style="color: rgba(247, 242, 234, 0.8);">
                                    Dựa trên phân tích cảm quan và thói quen pha chế, đây là dòng hạt sinh ra để dành cho bạn.
                                </p>
                            </div>

                            <!-- TOP 1 PERFECT MATCH CARD -->
                            <div class="inno-spatial-layer inno-spatial-layer--elevated rounded-4 mb-4 overflow-hidden">
                                <div class="py-3 px-4 d-flex align-items-center justify-content-between inno-cardless--bordered-bottom"
                                     style="background: rgba(212, 136, 66, 0.08);">
                                    <div class="d-flex align-items-center">
                                        <span class="fs-4 me-2"><i class="fa fa-award text-warning"/></span>
                                        <span class="fw-bold text-uppercase" style="color: #E5A93C; letter-spacing: 0.05em; font-size: 0.85rem;">
                                            Hồ Sơ Cảm Quan Tương Thích Nhất (Best Match)
                                        </span>
                                    </div>
                                    <span class="badge rounded-pill px-3 py-2 fw-bold top1-match-badge bg-warning text-dark font-monospace"
                                           style="font-size: 0.85rem;">
                                        91.7% Tương thích
                                    </span>
                                </div>
                                <div class="p-4 p-md-5">
                                    <div class="row align-items-center">
                                        <div class="col-lg-7">
                                            <h3 class="h3 fw-bold text-light mb-2 top1-product-name" style="font-family: 'Playfair Display', serif;">
                                                Đắk Lắk Highland Fine Robusta Natural
                                            </h3>
                                            <p class="fst-italic mb-3 top1-product-tagline" style="color: #E5A93C;">
                                                Bản sắc đại ngàn, Vị đậm đà ngút ngàn, ngọt sâu hậu vị
                                            </p>

                                            <!-- Specs Grid -->
                                            <div class="row g-2 mb-3 small" style="color: rgba(247, 242, 234, 0.8);">
                                                <div class="col-sm-6">
                                                    <strong class="text-white">Vùng trồng:</strong> <span class="top1-product-origin">Cư M'gar, Đắk Lắk</span>
                                                </div>
                                                <div class="col-sm-6">
                                                    <strong class="text-white">Sơ chế:</strong> <span class="top1-product-process">Natural (Phơi giàn)</span>
                                                </div>
                                                <div class="col-sm-6">
                                                    <strong class="text-white">Điểm SCA:</strong> <span class="top1-product-cupping text-warning fw-bold">84.5 điểm</span>
                                                </div>
                                                <div class="col-sm-6">
                                                    <strong class="text-white">Quy cách:</strong> <span>Túi 250g (Van 1 chiều)</span>
                                                </div>
                                            </div>

                                            <!-- Tasting Notes -->
                                            <div class="mb-4">
                                                <span class="small d-block mb-2 fw-bold text-light">Nốt hương chủ đạo:</span>
                                                <div class="top1-product-notes d-flex flex-wrap gap-2">
                                                    <span class="badge rounded-pill px-3 py-1 inno-inner-panel text-warning border-0">Sô-cô-la đen 85%</span>
                                                    <span class="badge rounded-pill px-3 py-1 inno-inner-panel text-warning border-0">Hạt dẻ nướng</span>
                                                    <span class="badge rounded-pill px-3 py-1 inno-inner-panel text-warning border-0">Mật mía</span>
                                                    <span class="badge rounded-pill px-3 py-1 inno-inner-panel text-warning border-0">Gỗ sồi</span>
                                                </div>
