            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

    <!-- ================================================================= -->
    <!-- INNOKAFE SLIDE-OVER CART DRAWER & SEAMLESS CHECKOUT               -->
    <!-- ================================================================= -->
    <template id="innokafe_cart_drawer" inherit_id="website.layout" priority="25">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-if="(website or getattr(request, 'website', None)) and ('innokafe' in ((website or getattr(request, 'website', None)).domain or '') or 'innokafe' in ((website or getattr(request, 'website', None)).name or '').lower())">
                <!-- Cart Drawer Backdrop Overlay -->
                <div id="inno_cart_backdrop" class="inno-cart-backdrop" aria-hidden="true"/>

                <!-- Slide-over Offcanvas Cart Drawer Container -->
                <aside id="innokafe_cart_drawer" class="inno-cart-drawer" role="dialog" aria-modal="true" aria-label="Giỏ Hàng Cà Phê Mộc InnoKafe">
                    <!-- Drawer Header -->
                    <div class="inno-cart-header p-4 inno-cardless inno-cardless--bordered-bottom d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa fa-shopping-bag text-warning fs-5"/>
                            <h5 class="mb-0 text-white fw-bold">Giỏ Hàng Của Bạn</h5>
                            <span class="badge rounded-pill bg-warning text-dark inno-cart-badge-count fw-bold px-2 py-1" style="font-size: 0.75rem;">0</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle inno-cart-close-btn d-inline-flex align-items-center justify-content-center" aria-label="Đóng giỏ hàng" style="width: 32px; height: 32px; font-size: 1.1rem; line-height: 1;">
                            <span aria-hidden="true">&amp;times;</span>
                        </button>
