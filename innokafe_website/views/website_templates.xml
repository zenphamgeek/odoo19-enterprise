<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- INNOKAFE SPECIALTY COFFEE: BRAND HEAD & METADATA                  -->
    <!-- ================================================================= -->
    <template id="innokafe_head_metadata" inherit_id="website.layout" priority="20">
        <xpath expr="//head/*[1]" position="before">
            <t t-set="curr_path" t-value="request.httprequest.path if request and request.httprequest else '/'"/>
            <t t-set="inno_meta_title" t-value="
                'InnoKafe — Cà Phê Việt Nam Nguyên Bản | Từ Nông Trại Bazan Đến Tách Cà Phê Có Gu' if curr_path == '/' else
                'Hành Trình Di Sản Nông Trại &amp; Cam Kết Cà Phê Mộc 4 Không — InnoKafe' if curr_path == '/story' else
                'Danh Mục Hạt Cà Phê Đặc Sản SCA &amp; Drip Bag Nghệ Nhân — InnoKafe' if curr_path == '/products' else
                'Tìm Gu Cà Phê Của Bạn Trong 60 Giây — Interactive Coffee Profiler' if curr_path == '/taste-profiler' else
                'Giải Pháp Cà Phê B2B Horeca &amp; Tài Trợ Máy Pha 0đ — InnoKafe' if curr_path == '/solutions-b2b' else
                'Liên Hệ &amp; Trải Nghiệm Tasting Bar InnoKafe' if curr_path == '/contactus' else
                'InnoKafe Specialty Coffee &amp; Roastery'"/>
            <t t-set="inno_meta_desc" t-value="
                'InnoKafe tôn vinh hạt cà phê Việt Nam nguyên bản từ thủ phủ Robusta Đắk Lắk (Cư M\'gar) và thiên đường Arabica Cầu Đất (1.650m). Cam kết cà phê mộc 4 Không: Không hương liệu, Không chất bảo quản, Không phẩm màu, Không độn bắp/đậu nành/bơ.'"/>

            <!-- High-Performance Typography Preconnect -->
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,900;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>

            <!-- Inline Brand Typography & Layout Optimizations -->
            <style>
                :root {
                    --inno-espresso-dark: #1E120B;
                    --inno-espresso-roast: #2C1810;
                    --inno-amber: #D48842;
                    --inno-amber-light: #E5A93C;
                    --inno-cream: #F7F2EA;
                    --inno-forest: #2D4739;
                    --inno-cherry: #A32A29;
                }
                body, p, .lead, .card-text, .text-muted {
                    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                }
                h1, h2, h3, h4, .h1, .h2, .h3, .h4, .display-1, .display-2, .display-3, .display-4, .display-5, .display-6, .inno-serif {
                    font-family: 'Playfair Display', Georgia, serif;
                    text-wrap: balance;
                }
                /* Force full visibility for all sections, disabling aggressive content-visibility containment */
                #wrap > section, #wrap > div.oe_structure > section {
                    content-visibility: visible !important;
                    contain-intrinsic-size: none !important;
                }
                .navbar-brand {
                    max-width: none !important;
                    width: auto !important;
                    white-space: nowrap !important;
                    display: inline-flex !important;
                    align-items: center !important;
                }
                .navbar-brand span {
                    white-space: nowrap !important;
                }
                .inno-amber-text {
                    color: #D48842 !important;
                }
                .inno-cream-bg {
                    background-color: #F7F2EA !important;
                    color: #1E120B !important;
                }
                .inno-espresso-bg {
                    background-color: #1E120B !important;
                    color: #F7F2EA !important;
                }
                .inno-pill-badge {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                    padding: 0.35rem 0.85rem;
                    border-radius: 50rem;
                    font-size: 0.825rem;
                    font-weight: 600;
                    letter-spacing: 0.03em;
                    background: rgba(212, 136, 66, 0.15);
                    color: #D48842;
                    border: 1px solid rgba(212, 136, 66, 0.3);
                }
                .btn-inno-primary, .btn-primary {
                    background: linear-gradient(135deg, #E5A93C 0%, #D48842 50%, #B86B28 100%) !important;
                    color: #1E120B !important;
                    font-weight: 700 !important;
                    border: 1px solid rgba(255, 255, 255, 0.2) !important;
                    box-shadow: 0 4px 18px rgba(212, 136, 66, 0.32);
                    transition: all 0.25s ease-in-out;
                }
                .btn-inno-primary:hover, .btn-primary:hover {
                    background: linear-gradient(135deg, #F0BA55 0%, #E0964D 50%, #C97831 100%) !important;
                    color: #1E120B !important;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 26px rgba(212, 136, 66, 0.45);
                }
                .btn-inno-outline, .btn-outline-secondary {
                    border: 1px solid rgba(247, 242, 234, 0.25) !important;
                    color: #F7F2EA !important;
                    background: transparent;
                    transition: all 0.25s ease-in-out;
                }
                .btn-inno-outline:hover, .btn-outline-secondary:hover {
                    border-color: #D48842 !important;
                    background: rgba(212, 136, 66, 0.12) !important;
                    color: #D48842 !important;
                }
                .inno-card-balanced {
                    min-height: 100%;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                }
                .inno-card-title-balance {
                    min-height: 3.2rem;
                    text-wrap: balance;
                }
                .inno-card-desc-balance {
                    min-height: 4.5rem;
                    text-wrap: pretty;
                }
                .inno-live-pulse {
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background-color: #D48842;
                    box-shadow: 0 0 0 0 rgba(212, 136, 66, 0.7);
                    animation: innoPulse 1.8s infinite;
                    display: inline-block;
                }
                @keyframes innoPulse {
                    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(212, 136, 66, 0.7); }
                    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(212, 136, 66, 0); }
                    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(212, 136, 66, 0); }
                }
            </style>
        </xpath>
    </template>

    <!-- ================================================================= -->
    <!-- REUSABLE INNOKAFE GLOBAL CALL TO ACTION                           -->
    <!-- ================================================================= -->
    <template id="innokafe_global_cta" name="InnoKafe Global Call to Action">
        <section class="s_call_to_action o_colored_level o_cc o_cc5 pt80 pb80 border-top border-secondary border-opacity-25 inno-espresso-bg position-relative overflow-hidden" data-snippet="s_call_to_action" data-name="InnoKafe Global CTA">
            <div class="container position-relative">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <div class="inno-pill-badge mb-3">
                            <span class="inno-live-pulse"/>
                            <span>CÀ PHÊ VIỆT NAM NGUYÊN BẢN // TỪ NÔNG TRẠI ĐẾN TÁCH</span>
                        </div>
                        <h2 class="display-4 fw-bold text-white mb-3">
                            Sẵn Sàng Đánh Thức Vị Giác Với <span class="inno-amber-text">Cà Phê Có Gu?</span>
                        </h2>
                        <p class="lead text-secondary mb-0 col-lg-11 p-0">
                            Khám phá hồ sơ hương vị độc bản của bạn qua bài trắc nghiệm thông minh 60 giây hoặc đặt ngay hộp thử mẫu Discovery Sample Box để trải nghiệm trọn vẹn 5 vùng hương vị đặc sản Việt Nam.
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <div class="d-flex flex-column flex-sm-row justify-content-lg-end gap-3">
                            <a href="/taste-profiler" class="btn btn-primary rounded-pill px-4 py-3 d-inline-flex align-items-center justify-content-center gap-2">
                                <span>Tìm Gu Cà Phê Của Bạn</span>
                                <i class="fa fa-arrow-right"/>
                            </a>
                            <a href="/products" class="btn btn-outline-secondary rounded-pill px-4 py-3 d-inline-flex align-items-center justify-content-center gap-2">
                                <span>Xem Danh Mục Hạt</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

