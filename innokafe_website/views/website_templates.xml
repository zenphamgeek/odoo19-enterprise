    <template id="innokafe_pledge_ribbon" name="InnoKafe 4-No Pledge Ribbon">
        <section class="s_banner o_colored_level o_cc o_cc5 py-4 position-relative overflow-hidden inno-spatial-layer rounded-0 border-start-0 border-end-0" data-snippet="s_banner" data-name="Pledge 4-No Ribbon" style="background: rgba(22, 12, 7, 0.55); backdrop-filter: blur(24px);">
            <div class="container">
                <div class="row text-center align-items-center g-3">
                    <div class="col-6 col-md-3">
                        <div class="d-flex align-items-center justify-content-center gap-2 text-white">
                            <span class="text-warning font-monospace fw-bold fs-6">01</span>
                            <span class="small fw-semibold">KHÔNG Hương Liệu Hóa Chất</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="d-flex align-items-center justify-content-center gap-2 text-white">
                            <span class="text-warning font-monospace fw-bold fs-6">02</span>
                            <span class="small fw-semibold">KHÔNG Chất Bảo Quản</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="d-flex align-items-center justify-content-center gap-2 text-white">
                            <span class="text-warning font-monospace fw-bold fs-6">03</span>
                            <span class="small fw-semibold">KHÔNG Phẩm Màu Nhuộm Đen</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="d-flex align-items-center justify-content-center gap-2 text-white">
                            <span class="text-warning font-monospace fw-bold fs-6">04</span>
                            <span class="small fw-semibold">KHÔNG Độn Bắp &amp; Đậu Nành</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- ================================================================= -->
    <!-- INNOKAFE SIGNATURE FOOTER ENHANCEMENT                             -->
    <!-- ================================================================= -->
    <template id="innokafe_footer_custom" inherit_id="website.footer_custom" priority="30">
        <xpath expr="//div[@id='footer']" position="replace">
            <t t-if="(website or getattr(request, 'website', None)) and ('innokafe' in ((website or getattr(request, 'website', None)).domain or '') or 'innokafe' in ((website or getattr(request, 'website', None)).name or '').lower())">
                <div id="footer" class="oe_structure oe_structure_solo inno-espresso-bg text-white" t-ignore="true" t-if="not no_footer">
                    <section class="s_text_block o_colored_level o_cc o_cc5 pt80 pb40 inno-cardless" data-snippet="s_text_block" data-name="InnoKafe Institutional Footer">
                        <div class="container">
                            <div class="row g-5 mb-5">
                                <!-- Col 1: Brand Philosophy & 4 Không -->
                                <div class="col-lg-4 col-md-6">
