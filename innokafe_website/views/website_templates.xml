<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- INNOKAFE SPECIALTY COFFEE: BRAND HEAD & METADATA                  -->
    <!-- ================================================================= -->
    <template id="innokafe_head_metadata" inherit_id="website.layout" priority="5">
        <xpath expr="//head/*[1]" position="before">
            <t t-if="(website or getattr(request, 'website', None)) and ('innokafe' in ((website or getattr(request, 'website', None)).domain or '') or 'innokafe' in ((website or getattr(request, 'website', None)).name or '').lower())">
                <t t-set="curr_path" t-value="request.httprequest.path if request and request.httprequest else '/'"/>
                <t t-set="disable_opengraph" t-value="True"/>
                <t t-set="inno_meta_title" t-value="
                    'InnoKafe, Cà Phê Việt Nam Nguyên Bản | Từ Nông Trại Bazan Đến Tách Cà Phê Có Gu' if curr_path == '/' else
                    'Di Sản Nông Trại &amp; Cà Phê Mộc 4 Không, InnoKafe' if curr_path == '/story' else
                    'Danh Mục Hạt Cà Phê Đặc Sản SCA &amp; Drip Bag Nghệ Nhân, InnoKafe' if curr_path == '/products' else
                    'Tìm Gu Cà Phê Của Bạn Trong 60 Giây, Interactive Coffee Profiler' if curr_path == '/taste-profiler' else
                    'Giải Pháp Cà Phê B2B Horeca &amp; Tài Trợ Máy Pha 0đ, InnoKafe' if curr_path == '/solutions-b2b' else
                    'Liên Hệ &amp; Trải Nghiệm Tasting Bar InnoKafe' if curr_path == '/contactus' else
                    'InnoKafe Specialty Coffee &amp; Roastery'"/>
                <t t-set="inno_meta_desc" t-value="
                    'InnoKafe tôn vinh hạt cà phê Việt Nam nguyên bản từ thủ phủ Robusta Đắk Lắk (Cư M\'gar) và thiên đường Arabica Cầu Đất (1.650m). Cam kết cà phê mộc 4 Không: Không hương liệu, Không chất bảo quản, Không phẩm màu, Không độn bắp/đậu nành/bơ.'"/>
                <t t-set="meta_description" t-value="inno_meta_desc"/>

                <!-- Canonical Social Share & OpenGraph Suite (1200x630 Verified Image) -->
                <t t-set="inno_base_url" t-value="((website or getattr(request, 'website', None)).domain or 'https://innokafe.com').rstrip('/')"/>
                <meta property="og:site_name" content="InnoKafe Specialty Coffee"/>
                <meta property="og:type" content="website"/>
                <meta property="og:url" t-attf-content="{{ inno_base_url }}{{ curr_path }}"/>
                <meta property="og:title" t-att-content="inno_meta_title"/>
                <meta property="og:description" t-att-content="inno_meta_desc"/>
                <meta property="og:image" t-attf-content="{{ inno_base_url }}/innokafe_website/static/src/img/branding/innokafe_social_share_1200x630.jpg"/>
                <meta property="og:image:secure_url" t-attf-content="{{ inno_base_url }}/innokafe_website/static/src/img/branding/innokafe_social_share_1200x630.jpg"/>
                <meta property="og:image:type" content="image/jpeg"/>
                <meta property="og:image:width" content="1200"/>
                <meta property="og:image:height" content="630"/>
                <meta property="og:image:alt" content="InnoKafe Specialty Coffee, Từ Nông Trại Bazan Đến Tách Cà Phê Có Gu"/>
                <meta property="og:locale" content="vi_VN"/>

                <!-- Twitter Card Meta Suite -->
                <meta name="twitter:card" content="summary_large_image"/>
                <meta name="twitter:site" content="@innokafe"/>
                <meta name="twitter:creator" content="@innokafe"/>
                <meta name="twitter:title" t-att-content="inno_meta_title"/>
                <meta name="twitter:description" t-att-content="inno_meta_desc"/>
                <meta name="twitter:image" t-attf-content="{{ inno_base_url }}/innokafe_website/static/src/img/branding/innokafe_social_share_1200x630.jpg"/>
                <meta name="twitter:image:alt" content="InnoKafe Specialty Coffee, Cà Phê Mộc 4 Không"/>

                <!-- Social Share Image Preload (WebP 61KB High Priority) -->
                <link rel="preload" as="image" href="/innokafe_website/static/src/img/branding/innokafe_social_share_1200x630.webp" type="image/webp" fetchpriority="high"/>

                <!-- InnoKafe Schema.org Structured Data -->
                <script type="application/ld+json">
                {
                    "@context": "https://schema.org",
                    "@type": "CafeOrCoffeeShop",
                    "@id": "https://innokafe.com/#organization",
                    "name": "InnoKafe Specialty Coffee &amp; Roastery",
                    "alternateName": "InnoKafe",
                    "url": "https://innokafe.com",
                    "logo": "https://innokafe.com/innokafe_website/static/src/img/branding/innokafe_logo_white.svg",
                    "image": "https://innokafe.com/innokafe_website/static/src/img/branding/innokafe_social_share_1200x630.jpg",
                    "description": "InnoKafe tôn vinh hạt cà phê Việt Nam nguyên bản từ thủ phủ Robusta Đắk Lắk (Cư M'gar) và thiên đường Arabica Cầu Đất (1.650m). Cam kết cà phê mộc 4 Không.",
                    "servesCuisine": "Specialty Coffee, Robusta Cư M'gar, Arabica Cầu Đất, Cold Brew",
                    "priceRange": "$$",
                    "address": {
                        "@type": "PostalAddress",
                        "addressLocality": "Ho Chi Minh City",
                        "addressCountry": "VN"
                    }
                }
                </script>

                <!-- High-Performance Typography Preconnect -->
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
                <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,900;1,400;1,600&amp;family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>

                <!-- InnoKafe Canonical Favicon & Manifest Suite -->
                <link rel="icon" type="image/svg+xml" href="/innokafe_website/static/src/img/branding/favicon.svg"/>
                <link rel="icon" type="image/png" sizes="32x32" href="/innokafe_website/static/src/img/branding/favicon-32x32.png"/>
                <link rel="icon" type="image/png" sizes="16x16" href="/innokafe_website/static/src/img/branding/favicon-16x16.png"/>
                <link rel="apple-touch-icon" sizes="180x180" href="/innokafe_website/static/src/img/branding/apple-touch-icon-180x180.png"/>
                <link rel="manifest" href="/innokafe_website/static/src/img/branding/site.webmanifest"/>
                <meta name="theme-color" content="#1E120B"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>

                <!-- Critical Viewport Layout & Header Stabilization (Zero CLS) -->
                <style id="innokafe_critical_layout_stability">
                    header#top,
                    header#top.o_header_standard,
                    header#top.o_header_affixed,
                    header.o_header_standard,
                    header.o_header_standard.o_header_affixed {
                        position: sticky !important;
                        top: 0 !important;
                        transform: none !important;
                    }
                    #wrapwrap &gt; main,
                    #wrapwrap &gt; main#wrap,
                    #wrapwrap main,
                    #wrapwrap main#wrap,
                    main#wrap,
                    #wrap {
                        padding-top: 0px !important;
                    }
                </style>
            </t>
        </xpath>
        <xpath expr="//t[@t-set='body_classname']" position="after">
            <t t-if="(website or getattr(request, 'website', None)) and ('innokafe' in ((website or getattr(request, 'website', None)).domain or '') or 'innokafe' in ((website or getattr(request, 'website', None)).name or '').lower())" t-set="body_classname" t-valuef="{{body_classname}} o_innokafe_theme"/>
        </xpath>
    </template>

    <!-- ================================================================= -->
    <!-- INNOKAFE SPECIALTY COFFEE: NAVBAR VECTOR BRAND LOGO               -->
    <!-- ================================================================= -->
    <template id="innokafe_header_brand_logo" inherit_id="website.option_header_brand_logo" priority="25">
        <xpath expr="//a[@data-name='Navbar Logo']" position="replace">
            <t t-if="(website or getattr(request, 'website', None)) and ('innokafe' in ((website or getattr(request, 'website', None)).domain or '') or 'innokafe' in ((website or getattr(request, 'website', None)).name or '').lower())">
                <a class="navbar-brand logo inno-logo-interactive d-inline-flex align-items-center py-1 me-xl-4 me-3" href="/" data-name="InnoKafe Navbar Logo">
                    <img class="inno-brand-logo img-fluid" src="/innokafe_website/static/src/img/branding/innokafe_logo_master.svg" alt="InnoKafe - Inspire the Techno"/>
                </a>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>

    <!-- ================================================================= -->
    <!-- REUSABLE INNOKAFE GLOBAL CALL TO ACTION                           -->
    <!-- ================================================================= -->
    <template id="innokafe_global_cta" name="InnoKafe Global Call to Action">
        <section class="s_call_to_action o_colored_level o_cc o_cc5 pt80 pb80 border-top inno-hairline-top inno-espresso-bg inno-cardless position-relative overflow-hidden" data-snippet="s_call_to_action" data-name="InnoKafe Global CTA">
            <div class="container position-relative">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <div class="inno-badge-liquid mb-3">
                            <span class="inno-live-pulse"/>
                            <span>· CÀ PHÊ VIỆT NAM NGUYÊN BẢN · TỪ NÔNG TRẠI ĐẾN TÁCH</span>
                        </div>
                        <h2 class="display-4 fw-bold text-white mb-3">
                            Thưởng Thức Cà Phê Đặc Sản <span class="inno-amber-text">Nguyên Bản Việt Nam</span>
                        </h2>
                        <p class="lead text-secondary mb-0 col-lg-11 p-0">
                            Khám phá hồ sơ hương vị độc bản của bạn qua bài trắc nghiệm 60 giây hoặc chọn ngay gói thử mẫu Discovery Sample Box để trải nghiệm trọn vẹn các giống hạt từ thủ phủ Cư M'gar và Cầu Đất.
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <div class="d-flex flex-column flex-sm-row justify-content-lg-end gap-3">
                            <a href="/taste-profiler" class="btn btn-primary rounded-pill px-4 py-3 d-inline-flex align-items-center justify-content-center gap-2">
                                <span>Tìm Gu Cà Phê Của Bạn</span>
                                <i class="fa fa-arrow-right"/>
                            </a>
                            <a href="/products" class="btn btn-outline-secondary rounded-pill px-4 py-3 d-inline-flex align-items-center justify-content-center gap-2">
                                <span>Xem Danh Mục Hạt</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- ================================================================= -->
    <!-- REUSABLE "4 KHÔNG" PLEDGE BANNER RIBBON (LIQUID SPATIAL)          -->
