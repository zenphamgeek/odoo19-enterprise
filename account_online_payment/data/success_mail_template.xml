<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_template_account_payment_activation_success" model="mail.template">
            <field name="name">Payments successfully activated</field>
            <field name="model_id" ref="account_online_payment.model_account_online_link"/>
            <field name="subject">Payments successfully activated</field>
            <field name="email_to">{{object.renewal_contact_email}}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table border="0" width="100%" cellpadding="0" bgcolor="#ededed" style="padding: 20px; background-color: #ededed" summary="o_mail_notification">
                    <tbody>
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table width="590" border="0" cellpadding="0" bgcolor="#004455" style="min-width: 590px; background-color: rgb(135,90,123); padding: 20px;">
                                <tr>
                                    <td valign="middle">
                                        <span style="font-size:20px; color:white; font-weight: bold;">
                                            You have just unlocked seamless payments in Insilos
                                        </span>
                                    </td>
                                    <td valign="middle" align="right">
                                        <img src="https://insilos.com/logo.png" style="padding: 0px; margin: 0px; height: auto; width: 80px;" alt="Insilos"/>
                                    </td>
                                </tr>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table width="590" border="0" cellpadding="0" bgcolor="#ffffff" style="min-width: 590px; background-color: rgb(255, 255, 255); padding: 20px;">
                                <tbody>
                                    <td valign="top" style="font-family:Arial,Helvetica,sans-serif; color: #555; font-size: 14px;">
                                        <p>Hi there,</p>
                                        <p>We're pleased to inform you that the payments feature in Insilos has been successfully activated. You can now process payments directly through your Insilos database, ensuring faster, more secure, and more efficient transactions.</p>
                                    </td>
                                </tbody>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td align="center">
                                Powered by <a href="https://insilos.com">Insilos</a>.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </field>
        </record>
    </data>
</odoo>
