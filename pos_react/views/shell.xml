<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="shell" name="POS React Shell">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>POS React — <t t-out="config.name"/></title>
                <link rel="stylesheet" href="/pos_react/static/src/app.css"/>
            </head>
            <body>
                <main id="pos-react-root" t-att-data-config-id="config.id" t-att-data-config-name="config.name"/>
                <script id="pos-react-data" type="application/json"><t t-out="initial_data"/></script>
                <script src="/pos_react/static/lib/react/react.production.min.js"/>
                <script src="/pos_react/static/lib/react/react-dom.production.min.js"/>
                <script src="/pos_react/static/src/translation_runtime.js"/>
                <script src="/pos_react/static/src/plugin_registry.js"/>
                <script src="/pos_react/static/src/restaurant_adapter.js"/>
                <t t-foreach="plugin_scripts" t-as="plugin_script">
                    <script t-att-src="plugin_script"/>
                </t>
                <script src="/pos_react/static/src/stripe_adapter.js"/>
                <script src="/pos_react/static/src/offline_store.js"/>
                <script src="/pos_react/static/src/metadata_graph.js"/>
                <script src="/pos_react/static/src/tax_engine.js"/>
                <script src="/pos_react/static/src/pricelist_engine.js"/>
                <script src="/pos_react/static/src/realtime.js"/>
                <script src="/pos_react/static/src/app.js"/>
            </body>
        </html>
    </template>
</odoo>
