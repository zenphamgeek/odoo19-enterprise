<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ESG Sustainability Radar Guided Onboarding Hub View -->
    <record id="view_is_esg_onboarding_form" model="ir.ui.view">
        <field name="name">is.esg.onboarding.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="ESG &amp; Carbon Accounting Onboarding Hub" class="o_form_view insilos_hub_form" create="false" edit="false">
                <sheet class="insilos_hub_sheet">
                    <!-- Standardized Hero Banner -->
                    <div class="insilos_hub_hero">
                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-lg-9">
                                <div class="insilos_hub_eyebrow">
                                    <i class="ph-bold ph-leaf me-1"/> ESG &amp; CARBON ACCOUNTING RADAR
                                </div>
                                <h2 class="insilos_hub_title">Trung tâm Quản trị Phát triển Bền vững &amp; Kế toán Carbon (ESG Sustainability Radar)</h2>
                                <p class="insilos_hub_desc">
                                    Hợp nhất dữ liệu quan trắc khí thải CEMS, kiểm kê phát thải Phạm vi 1-2-3 (Scope 1, 2, 3), tính toán thuế carbon biên giới EU CBAM và cấp chứng chỉ số theo chuẩn SAP Fiori Horizon &amp; IBM Carbon.
                                </p>
                            </div>
                            <div class="col-12 col-lg-3 text-lg-end">
                                <div class="insilos_hub_telemetry_badge d-inline-block text-start text-lg-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                                        <span class="insilos_pulse_dot"/>
                                        <span class="insilos_hub_status_text">ESG RADAR ACTIVE</span>
                                    </div>
                                    <span class="insilos_hub_metric_num">4 BƯỚC</span>
                                    <small class="insilos_hub_metric_label">Carbon Accounting</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4-Step Interactive Onboarding Header -->
                    <div class="insilos_hub_section_header">
                        <div class="insilos_section_left">
                            <div class="insilos_section_icon"><i class="ph-bold ph-git-merge"/></div>
                            <h4 class="insilos_section_title">Quy trình 4 Bước Kiểm kê Phát thải &amp; Tuân thủ Môi trường ESG:</h4>
                        </div>
                        <span class="insilos_section_badge">4-STAGE PIPELINE</span>
                    </div>

                    <!-- 4-Step Interactive Onboarding Cards -->
                    <div class="row g-3 mb-4 w-100">
                        <!-- Step 1: Facility & Baselines -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="insilos_hub_card">
                                <div class="insilos_card_header">
                                    <span class="insilos_step_pill">01</span>
                                    <span class="insilos_card_tag">Facility Scorecard</span>
                                </div>
                                <h5 class="insilos_card_title"><i class="ph-duotone ph-chart-polar me-2"/>Thẻ Điểm Nhà Máy</h5>
                                <p class="insilos_card_desc">
                                    Thiết lập hồ sơ cơ sở công nghiệp, định mức tiêu thụ điện năng Scope 2 và đo đếm phát thải đốt trực tiếp Scope 1.
                                </p>
                                <div class="insilos_card_actions">
                                    <button name="%(action_is_esg_facility_scorecard)d" string="Scorecards" type="action" class="btn btn-sm btn-hub-primary w-100" icon="chart-polar"/>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: CBAM Tariff Advisor -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="insilos_hub_card">
                                <div class="insilos_card_header">
                                    <span class="insilos_step_pill">02</span>
                                    <span class="insilos_card_tag">EU CBAM</span>
                                </div>
                                <h5 class="insilos_card_title"><i class="ph-duotone ph-currency-eur me-2"/>Cố Vấn Thuế CBAM</h5>
                                <p class="insilos_card_desc">
                                    Tra cứu nghĩa vụ chứng chỉ carbon EU ETS trên 8 số mã HS (Sắt thép, Nhôm, Xi măng, Phân bón, Hóa chất Hydro).
                                </p>
                                <div class="insilos_card_actions">
                                    <button name="%(action_is_esg_cbam_advisor)d" string="CBAM Advisor" type="action" class="btn btn-sm btn-hub-primary w-100" icon="currency-eur"/>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Scope 3 Freight Carbon -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="insilos_hub_card">
                                <div class="insilos_card_header">
                                    <span class="insilos_step_pill">03</span>
                                    <span class="insilos_card_tag">Scope 3 Freight</span>
                                </div>
                                <h5 class="insilos_card_title"><i class="ph-duotone ph-truck me-2"/>Carbon Logistics</h5>
                                <p class="insilos_card_desc">
                                    Tính toán phát thải vận chuyển đường biển, hàng không, đường bộ GLEC từ chứng từ B/L và định lượng bù trừ số hóa IDP.
                                </p>
                                <div class="insilos_card_actions">
                                    <button name="%(action_is_esg_freight_carbon)d" string="Freight Carbon" type="action" class="btn btn-sm btn-hub-primary w-100" icon="truck"/>
                                </div>
                            </div>
                        </div>

                        <!-- Step 4: CEMS Sensors & Chemical Footprint -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <div class="insilos_hub_card">
                                <div class="insilos_card_header">
                                    <span class="insilos_step_pill">04</span>
                                    <span class="insilos_card_tag">CEMS &amp; VOC</span>
                                </div>
                                <h5 class="insilos_card_title"><i class="ph-duotone ph-cloud-fog me-2"/>Khí Thải CEMS &amp; VOC</h5>
                                <p class="insilos_card_desc">
                                    Giám sát online ống khói CEMS (SO2, NOx, Bụi TSP) và theo dõi bay hơi hóa chất hữu cơ dễ bay hơi VOC GHS09.
                                </p>
                                <div class="insilos_card_actions">
                                    <button name="%(action_is_esg_chemical_impact)d" string="Chemical Impact" type="action" class="btn btn-sm btn-hub-primary w-100" icon="cloud-fog"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Standards & Regulation Reference Grid -->
                    <div class="row g-3 w-100">
                        <div class="col-12 col-md-4">
                            <div class="insilos_hub_footer_card">
                                <div class="insilos_footer_heading">
                                    <i class="ph-duotone ph-globe-hemisphere-east"/>
                                    <h6>1. GHG Protocol &amp; ISO 14064:</h6>
                                </div>
                                <p class="insilos_footer_desc">Kiểm kê phát thải nhà kính 3 phạm vi Scope 1 (Trực tiếp), Scope 2 (Điện năng tiêu thụ), Scope 3 (Chuỗi cung ứng &amp; Vận tải Logistics).</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="insilos_hub_footer_card">
                                <div class="insilos_footer_heading">
                                    <i class="ph-duotone ph-factory"/>
                                    <h6>2. QCVN 19/2024 &amp; QCVN 40:</h6>
                                </div>
                                <p class="insilos_footer_desc">Quy chuẩn kỹ thuật quốc gia về nồng độ khí thải công nghiệp CEMS và nước thải công nghiệp trước khi xả thải ra môi trường tự nhiên.</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="insilos_hub_footer_card">
                                <div class="insilos_footer_heading">
                                    <i class="ph-duotone ph-shield-check"/>
                                    <h6>3. EU Regulation 2023/956 (CBAM):</h6>
                                </div>
                                <p class="insilos_footer_desc">Cơ chế điều chỉnh biên giới carbon Liên minh Châu Âu và nghĩa vụ báo cáo chuyển tiếp hàng quý cho các doanh nghiệp sản xuất xuất khẩu.</p>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for ESG Onboarding Hub -->
    <record id="action_is_esg_onboarding_hub" model="ir.actions.act_window">
        <field name="name">ESG Onboarding Hub</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="path">esg-onboarding</field>
        <field name="view_id" ref="view_is_esg_onboarding_form"/>
    </record>

    <!-- Top Menu for ESG Onboarding Hub -->
    <menuitem id="menu_esg_onboarding_hub"
              name="Onboarding Hub"
              parent="menu_is_esg_bridge_root"
              action="action_is_esg_onboarding_hub"
              sequence="5"/>
</odoo>
