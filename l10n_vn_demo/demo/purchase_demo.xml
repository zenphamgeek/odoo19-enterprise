<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- ĐƠN MUA HÀNG NGUYÊN VẬT LIỆU CÔNG NGHIỆP (PURCHASE ORDERS)   -->
        <!-- ============================================================ -->

        <!-- Đơn 1: Mua Thép tấm & Thép hộp từ Tập đoàn Hòa Phát -->
        <record id="purchase_order_vn_1" model="purchase.order">
            <field name="name">Đơn mua hàng #VN-PO2026-001</field>
            <field name="partner_id" ref="res_partner_supplier_vn_1"/>
            <field name="currency_id" ref="base.VND"/>
            <field name="date_order" eval="(DateTime.today() - relativedelta(weeks=2)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="purchase_order_line_vn_1a" model="purchase.order.line">
            <field name="order_id" ref="purchase_order_vn_1"/>
            <field name="name">Thép tấm cán nóng kết cấu SS400 (Dày 12mm x Khổ 1.5m x 6m)</field>
            <field name="product_id" ref="product_vn_9"/>
            <field name="product_qty">20000</field>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="price_unit">19500</field>
            <field name="date_planned" eval="(DateTime.today() + relativedelta(days=7)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="purchase_order_line_vn_1b" model="purchase.order.line">
            <field name="order_id" ref="purchase_order_vn_1"/>
            <field name="name">Thép hộp mạ kẽm nhúng nóng 100x100x4.0mm (Cây 6m)</field>
            <field name="product_id" ref="product_vn_10"/>
            <field name="product_qty">600</field>
            <field name="uom_id" ref="uom.product_uom_meter"/>
            <field name="price_unit">245000</field>
            <field name="date_planned" eval="(DateTime.today() + relativedelta(days=7)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Đơn 2: Mua Cáp điện 3 pha từ Công ty CADIVI -->
        <record id="purchase_order_vn_2" model="purchase.order">
            <field name="name">Đơn mua hàng #VN-PO2026-002</field>
            <field name="partner_id" ref="res_partner_supplier_vn_2"/>
            <field name="currency_id" ref="base.VND"/>
            <field name="date_order" eval="(DateTime.today() - relativedelta(days=5)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="purchase_order_line_vn_2a" model="purchase.order.line">
            <field name="order_id" ref="purchase_order_vn_2"/>
            <field name="name">Dây cáp điện đồng mềm CADIVI 3 pha 3x16+1x10mm²</field>
            <field name="product_id" ref="product_vn_12"/>
            <field name="product_qty">500</field>
            <field name="uom_id" ref="uom.product_uom_meter"/>
            <field name="price_unit">145000</field>
            <field name="date_planned" eval="(DateTime.today() + relativedelta(days=5)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Đơn 3: Mua Lốp xe tải nặng từ Bridgestone Việt Nam -->
        <record id="purchase_order_vn_3" model="purchase.order">
            <field name="name">Đơn mua hàng #VN-PO2026-003</field>
            <field name="partner_id" ref="res_partner_supplier_vn_6"/>
            <field name="currency_id" ref="base.VND"/>
            <field name="date_order" eval="(DateTime.today() - relativedelta(days=3)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="purchase_order_line_vn_3a" model="purchase.order.line">
            <field name="order_id" ref="purchase_order_vn_3"/>
            <field name="name">Lốp xe tải nặng Bridgestone R150 11R22.5 (16PR không săm)</field>
            <field name="product_id" ref="product_vn_16"/>
            <field name="product_qty">24</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="price_unit">6800000</field>
            <field name="date_planned" eval="(DateTime.today() + relativedelta(days=3)).strftime('%Y-%m-%d')"/>
        </record>

        <!-- Đồng bộ tiền tệ đa tệ cho đơn hàng mua và bán -->
        <function model="account.move" name="_l10n_vn_demo_sync_demo_accounting"/>

    </data>
</odoo>
