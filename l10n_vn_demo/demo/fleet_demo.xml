<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- HÃNG XE & DÒNG XE VẬN TẢI CÔNG NGHIỆP                        -->
        <!-- ============================================================ -->

        <record id="brand_hino" model="fleet.vehicle.model.brand">
            <field name="name">Hino Motors</field>
        </record>

        <record id="brand_cimc" model="fleet.vehicle.model.brand">
            <field name="name">CIMC Trailers</field>
        </record>

        <!-- Dòng xe: Xe đầu kéo Hyundai Xcient GT 440PS -->
        <record id="model_hyundai_xcient" model="fleet.vehicle.model">
            <field name="name">Xcient GT 440PS Prime Mover (Đầu kéo 6x4)</field>
            <field name="brand_id" ref="fleet.brand_hyundai"/>
            <field name="vehicle_type">other</field>
        </record>

        <!-- Dòng xe: Sơ mi rơ moóc xương 40ft CIMC -->
        <record id="model_cimc_trailer" model="fleet.vehicle.model">
            <field name="name">Sơ mi rơ moóc xương 3 trục 40ft (Container Chassis)</field>
            <field name="brand_id" ref="brand_cimc"/>
            <field name="vehicle_type">other</field>
        </record>

        <!-- Dòng xe: Xe tải nặng 15T Hino 500 Series -->
        <record id="model_hino_500" model="fleet.vehicle.model">
            <field name="name">Hino 500 Series FL8JT7A (15 Tấn Mui Bạt)</field>
            <field name="brand_id" ref="brand_hino"/>
            <field name="vehicle_type">other</field>
        </record>

        <!-- Dòng xe: Xe tải đông lạnh Isuzu Forward FVR 8T -->
        <record id="model_isuzu_fvr" model="fleet.vehicle.model">
            <field name="name">Isuzu Forward FVR34SE4 (8 Tấn Thùng Lạnh -20°C)</field>
            <field name="brand_id" ref="fleet.brand_isuzu"/>
            <field name="vehicle_type">other</field>
        </record>

        <!-- ============================================================ -->
        <!-- LOẠI DỊCH VỤ & BẢO TRÌ ĐỘI XE                                -->
        <!-- ============================================================ -->

        <record id="service_type_maintenance_vn" model="fleet.service.type">
            <field name="name">Bảo dưỡng định kỳ động cơ &amp; gầm bệ</field>
            <field name="category">service</field>
        </record>

        <record id="service_type_inspection_vn" model="fleet.service.type">
            <field name="name">Đăng kiểm &amp; Kiểm định kỹ thuật xe cơ giới</field>
            <field name="category">service</field>
        </record>

        <record id="service_type_fuel_vn" model="fleet.service.type">
            <field name="name">Tiếp nhiên liệu Dầu DO 0.05S (Petrolimex / PVOIL)</field>
            <field name="category">service</field>
        </record>

