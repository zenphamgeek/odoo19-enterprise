<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- BẢNG GIÁ NIÊM YẾT TIỀN ĐỒNG VIỆT NAM (VND PRICELIST)          -->
        <!-- ============================================================ -->

        <record id="pricelist_vn_industrial_vnd" model="product.pricelist">
            <field name="name">Bảng giá Công nghiệp &amp; Vận tải (VND)</field>
            <field name="currency_id" ref="base.VND"/>
        </record>

        <!-- ============================================================ -->
        <!-- ĐƠN BÁN HÀNG THIẾT BỊ CƠ KHÍ & DỊCH VỤ VẬN TẢI (SALES ORDERS) -->
        <!-- ============================================================ -->

        <!-- Đơn 1: Cung cấp Thiết bị Xe Kéo Điện & Trạm Sạc cho Tân Cảng Sài Gòn -->
        <record id="sale_order_vn_1" model="sale.order">
            <field name="name">Đơn bán hàng #VN-SO2026-001</field>
            <field name="partner_id" ref="res_partner_customer_vn_4"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="pricelist_id" ref="pricelist_vn_industrial_vnd"/>
            <field name="date_order" eval="(DateTime.today() - relativedelta(weeks=1)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="sale_order_line_vn_1a" model="sale.order.line">
            <field name="order_id" ref="sale_order_vn_1"/>
            <field name="name">Xe kéo hàng điện nhà xưởng V-LIFT 2500E (Pin LFP 48V-400Ah)</field>
            <field name="product_id" ref="product_vn_1"/>
            <field name="product_uom_qty">5</field>
            <field name="price_unit">385000000</field>
        </record>

        <record id="sale_order_line_vn_1b" model="sale.order.line">
            <field name="order_id" ref="sale_order_vn_1"/>
            <field name="name">Trạm sạc nhanh DC 60kW công nghiệp V-CHARGE 60</field>
            <field name="product_id" ref="product_vn_3"/>
            <field name="product_uom_qty">2</field>
            <field name="price_unit">185000000</field>
        </record>

        <!-- Đơn 2: Cung cấp Rơ-moóc & Dịch vụ Kéo Container cho Gemadept Logistics -->
        <record id="sale_order_vn_2" model="sale.order">
            <field name="name">Đơn bán hàng #VN-SO2026-002</field>
            <field name="partner_id" ref="res_partner_customer_vn_5"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="pricelist_id" ref="pricelist_vn_industrial_vnd"/>
            <field name="date_order" eval="(DateTime.today() - relativedelta(days=3)).strftime('%Y-%m-%d')"/>
        </record>

        <record id="sale_order_line_vn_2a" model="sale.order.line">
            <field name="order_id" ref="sale_order_vn_2"/>
            <field name="name">Sơ mi rơ moóc tải nặng chuyên dụng chở container 40ft VT-SEMITRAIL 40</field>
            <field name="product_id" ref="product_vn_2"/>
            <field name="product_uom_qty">3</field>
            <field name="price_unit">420000000</field>
        </record>

        <record id="sale_order_line_vn_2b" model="sale.order.line">
            <field name="order_id" ref="sale_order_vn_2"/>
            <field name="name">Dịch vụ Kéo Container 40ft Tuyến Cát Lái - VSIP Bình Dương (50 Chuyến)</field>
            <field name="product_id" ref="product_vn_17"/>
            <field name="product_uom_qty">50</field>
            <field name="price_unit">3850000</field>
        </record>

    </data>
</odoo>
